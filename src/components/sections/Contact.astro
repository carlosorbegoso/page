---
import Button from '../ui/Button.astro';
import CvLink from '../ui/CvLink.astro';
import SectionHeader from '../ui/SectionHeader.astro';
import CopyEmail from '../contact/CopyEmail.astro';
import { SECTION_IDS, SITE } from '../../config/site';
import { useTranslations, type Locale } from '../../i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const socials = [
  { label: 'LinkedIn', href: SITE.social.linkedin },
  { label: 'GitHub', href: SITE.social.github },
  { label: `X ${SITE.handle}`, href: SITE.social.x }
];
---

<section
  id={SECTION_IDS.contact}
  aria-labelledby="contact-title"
  data-stage-scene="none"
  class="relative z-(--z-content) bg-surface px-gutter py-section"
>
  <div
    class="mx-auto grid max-w-content gap-stack lg:grid-cols-[minmax(0,1fr)_minmax(0,28rem)] lg:items-center lg:gap-16"
  >
    <SectionHeader id="contact-title" title={t('contact.title')} subtitle={t('contact.subtitle')}>
      <p class="text-text-muted">{t('contact.body')}</p>
    </SectionHeader>

    <div
      class="flex w-full max-w-reading flex-col gap-6 rounded-xl border border-border bg-surface-raised p-5 md:p-6 lg:max-w-none"
    >
      <div class="flex flex-col gap-3">
        <p id="contact-email-label" class="text-xs font-semibold tracking-caps text-text-muted uppercase">
          {t('contact.email')}
        </p>
        <Button
          href={`mailto:${SITE.email}`}
          variant="primary"
          size="lg"
          class="w-full break-all"
          aria-describedby="contact-email-label"
        >
          <svg
            viewBox="0 0 24 24"
            width="18"
            height="18"
            aria-hidden="true"
            class="shrink-0 fill-none stroke-current"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <rect x="3" y="5" width="18" height="14" rx="2"></rect>
            <path d="m3 7 9 6 9-6"></path>
          </svg>
          {SITE.email}
        </Button>
        <CopyEmail locale={locale} email={SITE.email} />
      </div>

      <div class="flex flex-col gap-3 border-t border-border pt-6">
        <p id="contact-social-label" class="text-xs font-semibold tracking-caps text-text-muted uppercase">
          {t('contact.social')}
        </p>
        <ul aria-labelledby="contact-social-label" class="grid gap-2 sm:grid-cols-3 lg:grid-cols-2" role="list">
          {socials.map(social => (
            <li class="lg:last:col-span-2">
              <Button href={social.href} variant="secondary" external class="w-full">
                {social.label}
              </Button>
            </li>
          ))}
        </ul>
        <CvLink locale={locale} variant="ghost" class="w-full" />
      </div>
    </div>
  </div>
</section>
