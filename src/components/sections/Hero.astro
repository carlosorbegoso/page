---
import Button from '../ui/Button.astro';
import CvLink from '../ui/CvLink.astro';
import { SECTION_IDS } from '../../config/site';
import { useTranslations, type Locale } from '../../i18n/utils';
import { getProfile } from '../../lib/content';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const profile = await getProfile(locale);
---

<section
  id={SECTION_IDS.hero}
  aria-labelledby="hero-title"
  data-station="hero"
  class="flex min-h-svh flex-col items-center justify-center px-gutter py-section"
>
  <div class="plate p-(--plate-padding)" data-plate data-plate-id="hero" data-plate-anchor="left">
    <div class="@container flex flex-col">
      <h1
        id="hero-title"
        class="hero-enter flex flex-wrap items-baseline gap-x-2 text-sm font-medium text-text-muted"
      >
        <span class="font-display font-semibold text-text">{profile.name}</span>
        <span aria-hidden="true" class="text-accent">/</span>
        <span>{profile.role}</span>
      </h1>

      <p
        class="hero-enter mt-4 font-display text-3xl font-semibold tracking-display text-balance text-text @md:text-4xl"
        style="--enter-delay: 60ms"
      >
        {t('hero.headline')}
      </p>

      <p
        class="hero-enter mt-4 text-base text-pretty text-text-muted @md:text-lg"
        style="--enter-delay: 120ms"
      >
        {profile.tagline}
      </p>

      <div class="hero-enter mt-6 grid grid-cols-2 gap-3" style="--enter-delay: 180ms">
        <Button href={`#${SECTION_IDS.products}`} variant="primary" size="lg" class="px-3!">
          {t('hero.ctaProducts')}
        </Button>
        <Button href={`#${SECTION_IDS.contact}`} variant="secondary" size="lg" class="px-3!">
          {t('hero.ctaContact')}
        </Button>
        <CvLink locale={locale} variant="ghost" size="lg" class="col-span-2 min-h-tap" />
      </div>
    </div>
  </div>
</section>

<style>
  @keyframes hero-enter {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
  }

  @keyframes hero-slide {
    from {
      transform: translateY(12px);
    }
  }

  /* Only the delayed children animate opacity; the h1 just slides so it paints in the first frame (LCP). */
  .hero-enter {
    animation: hero-enter var(--duration-slow) var(--ease-out) both;
    animation-delay: var(--enter-delay, 0ms);
  }

  h1.hero-enter {
    animation-name: hero-slide;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-enter {
      animation: none;
    }
  }

  :global(:root[data-motion='paused']) .hero-enter {
    animation: none;
  }
</style>
