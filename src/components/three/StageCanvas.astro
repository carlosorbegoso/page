---
import BootScreen from './boot/BootScreen.astro';
import type { Locale } from '../../i18n/utils';

interface Props {
  locale: Locale;
}
---

<script is:inline>
  (() => {
    const params = new URLSearchParams(location.search);
    if (params.has('capture')) return;
    const root = document.documentElement;
    if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
    if (!location.hash) scrollTo(0, 0);
    if (params.get('tier') === 'none' || navigator.connection?.saveData || matchMedia('(forced-colors: active)').matches) return;
    root.classList.add('booting');
    let gl = null;
    try {
      gl = document.createElement('canvas').getContext('webgl2');
    } catch {
      gl = null;
    }
    if (!gl) {
      root.dataset.webgl = 'none';
      return;
    }
    root.classList.add('stage-pending');
    setTimeout(() => root.classList.remove('stage-pending'), 12000);
  })();
</script>

<div data-stage aria-hidden="true"></div>
<BootScreen locale={Astro.props.locale} />

<script>
  import { onIdle } from '../../three/idle';
  import { detectTier } from '../../three/tier';
  import { warmVisit } from './boot';

  const BOOT_TIMEOUT_MS = 3000;
  const INTERACTIONS = ['pointerdown', 'keydown', 'wheel', 'touchstart', 'scroll'] as const;

  function whenLoaded(): Promise<void> {
    if (document.readyState === 'complete') return Promise.resolve();
    return new Promise(resolve => window.addEventListener('load', () => resolve(), { once: true }));
  }

  function firstInteractionOrTimeout(): Promise<void> {
    return new Promise(resolve => {
      const done = () => {
        clearTimeout(timer);
        for (const type of INTERACTIONS) window.removeEventListener(type, done);
        resolve();
      };
      const timer = setTimeout(done, BOOT_TIMEOUT_MS);
      for (const type of INTERACTIONS) window.addEventListener(type, done, { once: true, passive: true });
    });
  }

  async function init(container: HTMLElement): Promise<void> {
    const params = new URLSearchParams(location.search);
    const capture = params.has('capture');

    if (!capture) {
      await whenLoaded();
      if (!warmVisit()) await firstInteractionOrTimeout();
    }
    onIdle(async () => {
      const tier = detectTier(params.get('tier') ?? (capture ? 'high' : null));
      container.dataset.tierReason = tier.reason;
      container.dataset.tier = tier.tier;
      if (capture || params.has('debug')) console.info('[stage] tier', tier);
      if (tier.tier === 'none') return;
      window.dispatchEvent(new CustomEvent('stage:progress', { detail: { value: 0.3 } }));
      try {
        const { boot } = await import('../../three/index');
        await boot({ container, tier, params });
      } catch (error) {
        container.dataset.degraded = 'error';
        console.error('[stage] 3D unavailable', error);
      }
    });
  }

  const container = document.querySelector<HTMLElement>('[data-stage]');
  if (container) {
    window.addEventListener('chapter:enter', () => (container.dataset.moving = ''));
    window.addEventListener('chapter:settled', () => delete container.dataset.moving);
  }
  if (container && !container.dataset.booted) {
    container.dataset.booted = 'true';
    void init(container);
  }
</script>

<style>
  [data-stage] {
    position: fixed;
    inset: 0 0 auto;
    height: 100vh;
    height: 100lvh;
    z-index: var(--z-canvas);
    pointer-events: none;
    overflow: hidden;
    background: linear-gradient(180deg, var(--color-sky-zenith), var(--color-sky-horizon));
  }

  [data-stage][data-ready='true']::before,
  [data-stage][data-ready='true']::after {
    content: '';
    position: absolute;
    inset-inline: 0;
    z-index: 1;
    height: var(--letterbox, 3.2vh);
    background: #000;
    transition: height 900ms var(--ease-in-out);
  }

  [data-stage][data-ready='true']::before {
    top: 0;
  }

  [data-stage][data-ready='true']::after {
    bottom: 0;
  }

  [data-stage][data-moving] {
    --letterbox: 7vh;
  }

  @media (orientation: portrait) {
    [data-stage] {
      --letterbox: 1.6vh;
    }

    [data-stage][data-moving] {
      --letterbox: 4vh;
    }
  }

  :global(:root[data-motion='paused']) [data-stage][data-moving] {
    --letterbox: 3.2vh;
  }

  [data-stage] :global([data-stage-canvas]) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity var(--duration-slow) var(--ease-standard);
  }

  [data-stage][data-ready='true'] :global([data-stage-canvas]) {
    opacity: 1;
  }

  [data-stage][data-degraded] :global([data-stage-canvas]) {
    display: none;
  }

  :global(.stage-plates) {
    position: fixed;
    inset: 0;
    z-index: var(--z-content);
    pointer-events: none;
  }

  @media (forced-colors: active) {
    [data-stage] :global([data-stage-canvas]) {
      display: none;
    }
  }
</style>
