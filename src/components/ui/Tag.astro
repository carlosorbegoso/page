---
import type { HTMLAttributes } from 'astro/types';

type Tone = 'neutral' | 'live' | 'building' | 'skymek' | 'parati' | 'ventixs';

interface Props extends HTMLAttributes<'span'> {
  tone?: Tone;
}

const { tone = 'neutral', class: className, ...attrs } = Astro.props;

const tones: Record<Tone, { chip: string; dot?: string }> = {
  neutral: { chip: 'text-text-muted', dot: 'bg-border-strong' },
  live: { chip: 'text-text', dot: 'bg-status-live shadow-[0_0_8px_var(--color-status-live)]' },
  building: { chip: 'text-text', dot: 'bg-status-building' },
  skymek: { chip: 'text-skymek', dot: 'bg-skymek' },
  parati: { chip: 'text-parati', dot: 'bg-parati' },
  ventixs: { chip: 'text-ventixs', dot: 'bg-ventixs' }
};

const { chip, dot } = tones[tone];
---

<span
  class:list={[
    'inline-flex min-h-6 items-center gap-2 text-xs font-medium leading-tight whitespace-nowrap',
    chip,
    className
  ]}
  data-tone={tone}
  {...attrs}
>
  {dot && <span class:list={['size-1.5 shrink-0 rounded-full', dot]} aria-hidden="true" />}
  <slot />
</span>
