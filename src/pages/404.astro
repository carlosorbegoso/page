---
import Base from '../layouts/Base.astro';
import { localeUrl, useTranslations } from '../i18n/utils';

const es = useTranslations('es');
const en = useTranslations('en');
---

<Base
  locale="es"
  title={`404 · ${es('notFound.title')} / ${en('notFound.title')}`}
  indexable={false}
>
  <main id="main" tabindex="-1">
    <h1>404</h1>
    <section aria-labelledby="not-found-es">
      <h2 id="not-found-es">{es('notFound.title')}</h2>
      <p>{es('notFound.body')}</p>
      <a href={localeUrl('es')}>{es('notFound.home')}</a>
    </section>
    <section lang="en" aria-labelledby="not-found-en">
      <h2 id="not-found-en">{en('notFound.title')}</h2>
      <p>{en('notFound.body')}</p>
      <a href={localeUrl('en')}>{en('notFound.home')}</a>
    </section>
  </main>
</Base>
