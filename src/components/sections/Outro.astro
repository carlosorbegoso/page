---
import ExternalLink from '../ui/ExternalLink.astro';
import { SITE } from '../../config/site';
import { useTranslations, type Locale } from '../../i18n/utils';
import '../../styles/sections/outro/monitor-portrait.css';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const year = new Date().getFullYear();
---

<section
  id="outro"
  aria-labelledby="outro-title"
  data-station="outro"
  class="outro relative flex min-h-svh flex-col items-center justify-center px-gutter py-section"
>
  <div
    class="plate p-(--plate-padding)"
    data-plate
    data-plate-id="outro"
    data-plate-anchor="outro"
    data-plate-mode="surface-monitor"
  >
    <div class="outro-screen flex max-w-measure flex-col gap-4">
      <p class="outro-label text-sm font-medium text-text-muted">{t('outro.label')}</p>
      <h2 id="outro-title" class="font-display text-3xl font-semibold tracking-display text-balance text-text">
        <span class="when-night">{t('outro.title')}</span><span class="when-day">{t('outro.titleDay')}</span>
      </h2>
      <p class="outro-body text-base text-pretty text-text-muted">{t('outro.body')}</p>
      <p class="outro-credits mt-1 flex flex-wrap items-baseline gap-x-3 gap-y-1.5 border-t border-text/10 pt-4 text-sm text-text-subtle">
        <span>{t('outro.tech')}</span>
        <ExternalLink
          href={SITE.social.github}
          locale={locale}
          class="underline decoration-accent/50 underline-offset-4 hover:text-text"
        >
          {t('outro.source')}
        </ExternalLink>
        <span class="outro-credits__break">© {year} {SITE.name} · TUSOCIO IA S.A.C.</span>
      </p>
    </div>
  </div>
</section>

<style>
  .outro-credits > :not(:first-child)::before {
    content: '·';
    margin-right: 0.75rem;
    color: var(--color-border-strong);
  }

  .outro-credits__break {
    flex-basis: 100%;
  }

  .outro-credits > .outro-credits__break::before {
    content: none;
  }

  :global(.is-3d [data-plate-mode='surface-monitor']) .outro-screen {
    height: 100%;
    max-width: none;
    justify-content: center;
    gap: 0;
  }

  :global(.is-3d [data-plate-mode='surface-monitor']) .outro-label {
    font-size: 3cqh;
    color: var(--color-text-muted);
  }

  :global(.is-3d [data-plate-mode='surface-monitor']) .outro h2 {
    max-width: 80%;
    margin-top: 3cqh;
    font-size: 11cqh;
    line-height: 1.02;
    text-wrap: balance;
  }

  :global(.is-3d [data-plate-mode='surface-monitor']) .outro-body {
    max-width: 70%;
    margin-top: 4cqh;
    font-size: 3.9cqh;
    line-height: 1.45;
  }

  :global(.is-3d [data-plate-mode='surface-monitor']) .outro-credits {
    margin-top: 6cqh;
    padding-top: 4cqh;
    font-size: 3.4cqh;
    gap: 1.6cqh 2.4cqw;
  }

  :global(.is-3d [data-plate-mode='anchored']) .outro-screen {
    gap: 0.75rem;
  }

  :global(.is-3d [data-plate-mode='anchored']) .outro-screen h2 {
    font-size: clamp(1.75rem, 7.6vw, 2.125rem);
    line-height: 1.08;
    letter-spacing: -0.02em;
  }

  :global(.is-3d [data-plate-mode='anchored']) .outro-body {
    font-size: 1rem;
    line-height: 1.5;
  }

  :global(.is-3d [data-plate-mode='anchored']) .outro-credits {
    margin-top: 0.25rem;
    padding-top: 0.75rem;
    font-size: 0.875rem;
    line-height: 1.5;
  }

  :global(.is-3d [data-plate-mode='anchored']) .outro-credits :global(a) {
    padding-block: 0.75rem;
  }

  :global(html:not(.is-3d)) .outro {
    display: none;
  }
</style>
