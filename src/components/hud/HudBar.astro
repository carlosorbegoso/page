---
import { useTranslations, type Locale } from '../../i18n/utils';
import { getExperience } from '../../lib/content';
import { storyClock, storyClocks } from '../../lib/story-time';
import type { ChapterId } from '../../three/contracts';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const years = (await getExperience(locale)).map(entry => entry.start.slice(0, 4)).toSorted();
const label = (id: ChapterId, count: number, day: boolean, word: string) =>
  Array.from({ length: count }, (_, sub) => `${storyClock(id, sub, day)} · ${word}`);
const yearLabels = (day: boolean) =>
  [`${years[0]} →`, ...years].map((year, sub) => `${storyClock('experience', sub, day)} · ${year}`);
const storyBeats: Record<string, string[]> = {
  hero: label('hero', 1, false, t('story.tonight')),
  about: label('about', 2, false, t('story.tonight')),
  experience: yearLabels(false),
  company: label('company', 1, false, t('story.night')),
  products: label('products', 3, false, t('story.night')),
  contact: label('contact', 1, false, t('story.night')),
  outro: label('outro', 1, false, t('story.dawn'))
};
const storyBeatsDay: Record<string, string[]> = {
  hero: label('hero', 1, true, t('story.today')),
  about: label('about', 2, true, t('story.today')),
  experience: yearLabels(true),
  company: label('company', 1, true, t('story.afterWork')),
  products: label('products', 3, true, t('story.afterWork')),
  contact: label('contact', 1, true, t('story.dusk')),
  outro: label('outro', 1, true, t('story.nightfall'))
};
const clocks = { night: storyClocks(false), day: storyClocks(true) };
---

<div class="flex items-center gap-1">
  <button
    type="button"
    data-hud-toggle
    aria-expanded="false"
    aria-controls="hud-menu"
    aria-label={t('hud.label')}
    aria-describedby="hud-audio-hint"
    class="group hud-control hud-icon"
  >
    <span
      aria-hidden="true"
      class="absolute top-2 right-2 hidden size-1.5 rounded-full bg-accent shadow-[0_0_6px_var(--color-accent)] group-data-[audio-hint]:block"
    ></span>
    <svg viewBox="0 0 64 64" width="22" height="22" aria-hidden="true">
      <path
        d="M43.5 22.4A15 15 0 1 0 43.5 41.6"
        fill="none"
        class="stroke-text"
        stroke-width="7"
      ></path>
      <circle cx="47" cy="32" r="4.5" class="fill-accent"></circle>
    </svg>
  </button>
  <span
    id="hud-audio-hint"
    data-hud-audio-hint
    data-label={t('audio.available')}
    class="sr-only"
    aria-live="polite"
  ></span>
  <div class="relative">
    <button
      type="button"
      data-hud-clock
      hidden
      aria-haspopup="dialog"
      aria-controls="section-index"
      aria-expanded="false"
      class="hud-clock group/clock inline-flex min-h-tap items-center rounded-full px-3 focus-visible:shadow-focus focus-visible:outline-none"
    >
      <span
        data-hud-chapter
        data-story-beats={JSON.stringify(storyBeats)}
        data-story-beats-day={JSON.stringify(storyBeatsDay)}
        data-story-clocks={JSON.stringify(clocks)}
        class="hud-beat font-mono text-xs tracking-caps text-text-muted tabular-nums opacity-0 transition-[opacity,color] duration-(--duration-base) ease-standard group-hover/clock:text-text data-[ready=true]:opacity-100"
      ></span>
      <span class="sr-only">· {t('story.openIndex')}</span>
    </button>
    <span
      data-hud-progress
      hidden
      role="progressbar"
      aria-label={t('story.progress')}
      aria-valuemin="0"
      aria-valuemax="100"
      aria-valuenow="0"
      data-value-template={t('story.progressValue')}
      class="hud-progress pointer-events-none absolute inset-x-2 bottom-2 h-0.5 overflow-hidden rounded-full"
    >
      <span data-hud-progress-fill class="hud-progress__fill block h-full bg-accent"></span>
    </span>
  </div>
  <button
    type="button"
    data-story-tour-quick
    hidden
    aria-pressed="false"
    aria-label={t('tour.start')}
    title={t('tour.start')}
    class="group/quick hud-control hud-icon"
  >
    <svg
      viewBox="0 0 24 24"
      width="14"
      height="14"
      aria-hidden="true"
      class="shrink-0 fill-current"
    >
      <path d="M8 5.5v13l10.5-6.5z" class="group-aria-pressed/quick:hidden"></path>
      <path
        d="M7 6h3.5v12H7zM13.5 6H17v12h-3.5z"
        class="hidden group-aria-pressed/quick:block"
      ></path>
    </svg>
  </button>
  <button
    type="button"
    data-explore-toggle
    hidden
    aria-pressed="false"
    aria-label={t('explore.enter')}
    title={t('explore.enter')}
    data-label-enter={t('explore.enter')}
    data-label-exit={t('explore.exit')}
    class="group/explore hud-control hud-icon"
  >
    <svg
      viewBox="0 0 24 24"
      width="18"
      height="18"
      aria-hidden="true"
      fill="none"
      stroke="currentColor"
      stroke-width="1.6"
      stroke-linecap="round"
    >
      <ellipse cx="12" cy="12" rx="9" ry="3.6"></ellipse>
      <path d="M12 3v18" class="group-aria-pressed/explore:hidden"></path>
      <path d="M16.5 15.3l2.4.5-.9 2.2" class="group-aria-pressed/explore:hidden"></path>
      <path d="M8 8l8 8M16 8l-8 8" class="hidden group-aria-pressed/explore:block"></path>
    </svg>
  </button>
  <span
    data-explore-hint
    hidden
    aria-live="polite"
    class="hud-beat font-mono text-xs tracking-caps text-text-muted"
  >
    {t('explore.hint')}
  </span>
  <span
    data-hud-tour-badge
    data-label-playing={t('tour.badgePlaying')}
    data-label-paused={t('tour.badgePaused')}
    aria-hidden="true"
    hidden
    class="hud-beat inline-flex items-center gap-1.5 font-mono text-xs tracking-caps text-text-muted"
  >
    <span
      data-hud-tour-dot
      class="size-1.5 rounded-full bg-text-muted data-[state=playing]:bg-accent"
    ></span>
    <span data-hud-tour-text></span>
  </span>
  <span
    data-story-tour-status
    data-label-playing={t('tour.playing')}
    data-label-paused={t('tour.paused')}
    data-label-finished={t('tour.finished')}
    class="sr-only"
    aria-live="polite"
  ></span>
</div>

<style>
  .hud-beat {
    text-shadow: var(--plate-text-halo);
  }

  .hud-clock {
    background: rgb(8 11 18 / 0.55);
    backdrop-filter: blur(10px) saturate(1.2);
    -webkit-backdrop-filter: blur(10px) saturate(1.2);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.08);
  }

  .hud-clock .hud-beat {
    color: rgb(233 238 245 / 0.86);
  }

  .hud-progress {
    background-color: color-mix(in srgb, var(--color-text-muted) 25%, transparent);
  }

  .hud-progress__fill {
    transform: scaleX(var(--story-progress, 0));
    transform-origin: left center;
  }

  @media (forced-colors: active) {
    .hud-progress {
      background-color: GrayText;
    }

    .hud-progress__fill {
      background-color: Highlight;
    }
  }
</style>
