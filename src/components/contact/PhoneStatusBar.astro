<div class="phone-status" aria-hidden="true">
  <span class="phone-time" data-phone-clock></span>
  <span class="phone-island"></span>
  <span class="phone-glyphs">
    <svg viewBox="0 0 18 12" class="phone-signal">
      <rect x="0" y="8" width="3" height="4" rx="0.8"></rect>
      <rect x="5" y="5.5" width="3" height="6.5" rx="0.8"></rect>
      <rect x="10" y="3" width="3" height="9" rx="0.8"></rect>
      <rect x="15" y="0" width="3" height="12" rx="0.8"></rect>
    </svg>
    <svg viewBox="0 0 16 12" class="phone-wifi">
      <path d="M8 11.2 5.6 8.6a3.4 3.4 0 0 1 4.8 0Z"></path>
      <path d="M3.6 6.5a6.3 6.3 0 0 1 8.8 0l-1.3 1.4a4.4 4.4 0 0 0-6.2 0Z"></path>
      <path d="M1.4 4.2a9.4 9.4 0 0 1 13.2 0l-1.3 1.4a7.5 7.5 0 0 0-10.6 0Z"></path>
    </svg>
    <svg viewBox="0 0 27 13" class="phone-battery">
      <rect
        x="0.6"
        y="0.6"
        width="22.8"
        height="11.8"
        rx="3.4"
        fill="none"
        stroke="currentColor"
        stroke-opacity="0.45"
        stroke-width="1.2"
      ></rect>
      <rect x="2.4" y="2.4" width="16.2" height="8.2" rx="2"></rect>
      <path d="M25 4.4v4.2a2.1 2.1 0 0 0 0-4.2Z" fill-opacity="0.45"></path>
    </svg>
  </span>
</div>

<span class="phone-home-bar" aria-hidden="true"></span>

<style>
  .phone-status,
  .phone-home-bar {
    display: none;
  }

  :global(.is-3d [data-plate-mode='surface-phone']) .phone-status {
    position: absolute;
    inset: 0 0 auto;
    z-index: 4;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 16cqw;
    padding-inline: 9cqw 8cqw;
    color: var(--color-text);
    font-size: 2.5cqh;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.01em;
    pointer-events: none;
  }

  .phone-time {
    min-width: 14cqw;
  }

  .phone-island {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 27cqw;
    height: 3.5cqh;
    border-radius: 999px;
    background: #000;
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.04);
    transform: translate(-50%, -50%);
  }

  .phone-glyphs {
    display: flex;
    align-items: center;
    gap: 1.4cqw;
  }

  .phone-glyphs svg {
    height: 1.9cqh;
    width: auto;
    fill: currentColor;
  }

  .phone-glyphs .phone-battery {
    height: 2.1cqh;
  }

  :global(.is-3d [data-plate-mode='surface-phone']) .phone-home-bar {
    position: absolute;
    left: 50%;
    bottom: 1.3cqh;
    z-index: 6;
    display: block;
    width: 36cqw;
    height: 0.9cqh;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.55);
    transform: translateX(-50%);
    pointer-events: none;
  }
</style>
