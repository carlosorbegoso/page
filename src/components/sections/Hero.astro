---
import Button from '../ui/Button.astro';
import CvLink from '../ui/CvLink.astro';
import KineticText from '../ui/KineticText.astro';
import { SECTION_IDS } from '../../config/site';
import { useTranslations, type Locale } from '../../i18n/utils';
import { getProfile } from '../../lib/content';
import '../../styles/sections/hero/monitor-compact.css';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const profile = await getProfile(locale);
const metrics = [
  { value: t('hero.metrics.performance.value'), label: t('hero.metrics.performance.label') },
  { value: t('hero.metrics.cqrs.value'), label: t('hero.metrics.cqrs.label') },
  { value: t('hero.metrics.team.value'), label: t('hero.metrics.team.label') }
];
---

<section
  id={SECTION_IDS.hero}
  aria-labelledby="hero-title"
  data-station="hero"
  class="flex min-h-svh flex-col items-center justify-center px-gutter py-section"
>
  <div
    class="plate p-(--plate-padding)"
    data-plate
    data-plate-id="hero"
    data-plate-anchor="hero"
    data-plate-mode="surface-monitor"
  >
    <div class="hero-screen @container flex flex-col">
      <h1 id="hero-title" class="hero-enter flex flex-col gap-3">
        <span class="hero-name text-sm font-medium text-text-muted">
          <KineticText text={profile.name} split="chars" />
        </span>
        <span class="hero-role font-display text-3xl font-semibold tracking-display text-balance text-text @md:text-4xl">
          <KineticText text={profile.role} delay={120} />
        </span>
      </h1>

      <p
        class="hero-headline hero-enter mt-5 max-w-measure font-display text-xl text-balance text-text @md:text-2xl"
        style="--enter-delay: 60ms"
      >
        <KineticText text={t('hero.headline')} type delay={360} />
      </p>

      <p class="hero-tagline hero-enter mt-3 text-sm text-pretty text-text-muted @md:text-base" style="--enter-delay: 120ms">
        {profile.tagline}
      </p>

      <section aria-labelledby="hero-metrics" class="hero-metrics hero-enter mt-6" style="--enter-delay: 160ms">
        <h2 id="hero-metrics" class="sr-only">{t('hero.metrics.label')}</h2>
        <dl class="grid gap-4 @md:grid-cols-3" data-kinetic-cascade style="--k-cascade-delay: 520ms">
          {
            metrics.map(metric => (
              <div class="flex flex-col-reverse gap-1">
                <dt class="hero-metric-label text-xs text-pretty text-text-muted">{metric.label}</dt>
                <dd class="hero-metric-value font-display text-xl font-semibold tracking-tight text-text tabular-nums" data-signal>
                  <KineticText text={metric.value} counts />
                </dd>
              </div>
            ))
          }
        </dl>
      </section>

      <div
        class="hero-ctas hero-enter mt-6 grid grid-cols-2 gap-3"
        data-kinetic-cascade
        style="--enter-delay: 200ms; --k-cascade-delay: 640ms"
      >
        <Button href={`#${SECTION_IDS.products}`} variant="primary" size="lg">
          {t('hero.ctaProducts')}
        </Button>
        <Button href={`#${SECTION_IDS.contact}`} variant="secondary" size="lg">
          {t('hero.ctaContact')}
        </Button>
        <CvLink locale={locale} variant="ghost" size="lg" class="col-span-2 min-h-tap" />
      </div>
    </div>
  </div>
</section>

<style>
  @keyframes hero-enter {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
  }

  @keyframes hero-slide {
    from {
      transform: translateY(12px);
    }
  }

  .hero-enter {
    animation: hero-enter var(--duration-slow) var(--ease-out) both;
    animation-delay: var(--enter-delay, 0ms);
  }

  h1.hero-enter {
    animation-name: hero-slide;
  }

  :global(.is-3d) .hero-enter {
    animation: none;
  }

  .hero-ctas > :global(*) {
    padding-inline: 0.75rem;
  }

  :global(.is-3d [data-plate-mode='surface-monitor']) .hero-screen {
    height: 100%;
    justify-content: center;
    gap: 0;
  }

  :global(.is-3d [data-plate-mode='surface-monitor']) .hero-screen h1 {
    gap: 1cqh;
  }

  :global(.is-3d [data-plate-mode='surface-monitor']) .hero-name {
    font-size: 3.6cqh;
    line-height: 1.3;
  }

  :global(.is-3d [data-plate-mode='surface-monitor']) .hero-role {
    font-size: 4.8cqh;
    font-weight: 500;
    line-height: 1.2;
    color: var(--color-text-muted);
  }

  :global(.is-3d [data-plate-mode='surface-monitor']) .hero-headline {
    max-width: 92%;
    margin-top: 4.5cqh;
    font-size: 11.5cqh;
    font-weight: 600;
    line-height: 1.04;
    letter-spacing: -0.02em;
  }

  :global(.is-3d [data-plate-mode='surface-monitor']) .hero-tagline {
    display: none;
  }

  :global(.is-3d [data-plate-mode='surface-monitor']) .hero-metrics {
    margin-top: 6cqh;
    padding-top: 4cqh;
    border-top: 1px solid rgb(255 255 255 / 0.1);
  }

  :global(.is-3d [data-plate-mode='surface-monitor']) .hero-metrics dl {
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0 5cqw;
  }

  :global(.is-3d [data-plate-mode='surface-monitor']) .hero-metrics div {
    justify-content: flex-end;
    gap: 0.8cqh;
  }

  :global(.is-3d [data-plate-mode='surface-monitor']) .hero-metric-value {
    font-size: 6.2cqh;
    white-space: nowrap;
    line-height: 1.1;
  }

  :global(.is-3d [data-plate-mode='surface-monitor']) .hero-metric-value::before {
    display: none;
  }

  :global(.is-3d [data-plate-mode='surface-monitor']) .hero-metric-label {
    font-size: 3.5cqh;
    font-weight: 500;
    line-height: 1.3;
  }

  :global(.is-3d [data-plate-mode='surface-monitor']) .hero-ctas {
    grid-template-columns: repeat(3, auto);
    justify-content: start;
    align-items: center;
    gap: 5cqw;
    margin-top: 6cqh;
  }

  :global(.is-3d [data-plate-mode='surface-monitor']) .hero-ctas > :global(*) {
    grid-column: auto;
    min-height: 0;
    height: auto;
    padding: 0 0 0.6cqh;
    border: 0;
    border-bottom: 1px solid rgb(255 255 255 / 0.25);
    border-radius: 0;
    background: none;
    box-shadow: none;
    text-decoration: none;
    font-size: 3.8cqh;
    font-weight: 500;
    color: var(--color-text);
  }

  :global(.is-3d [data-plate-mode='surface-monitor']) .hero-ctas > :global(:first-child) {
    border-bottom-color: var(--color-accent);
  }

  :global(.is-3d [data-plate-mode='surface-monitor']) .hero-ctas :global(svg) {
    width: 3.8cqh;
    height: 3.8cqh;
  }

  :global(.is-3d [data-plate-mode='anchored']) .hero-screen h1 {
    gap: 0.25rem;
  }

  :global(.is-3d [data-plate-mode='anchored']) .hero-name {
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-text);
  }

  :global(.is-3d [data-plate-mode='anchored']) .hero-role {
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    font-weight: 500;
    line-height: 1.4;
    letter-spacing: 0;
    color: var(--color-text-muted);
  }

  :global(.is-3d [data-plate-mode='anchored']) .hero-headline {
    max-width: none;
    margin-top: 0.875rem;
    font-size: clamp(1.75rem, 7.6vw, 2.125rem);
    font-weight: 600;
    line-height: 1.08;
    letter-spacing: -0.02em;
  }

  :global(.is-3d [data-plate-mode='anchored']) :is(.hero-tagline, .hero-metrics) {
    display: none;
  }

  :global(.is-3d [data-plate-mode='anchored']) .hero-ctas {
    gap: 0.25rem 0.75rem;
    margin-top: 1.5rem;
  }

  :global(.is-3d [data-plate-mode='anchored']) .hero-ctas > :global(*) {
    min-height: 3rem;
    font-size: 1rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-enter {
      animation: none;
    }
  }

  :global(:root[data-motion='paused']) .hero-enter {
    animation: none;
  }
</style>
