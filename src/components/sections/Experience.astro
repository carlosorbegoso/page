---
import SectionHeader from '../ui/SectionHeader.astro';
import TimelineItem from '../experience/TimelineItem.astro';
import { SECTION_IDS } from '../../config/site';
import { useTranslations, type Locale } from '../../i18n/utils';
import { getExperience } from '../../lib/content';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const entries = await getExperience(locale);
const firstYear = entries
  .map(entry => entry.start.slice(0, 4))
  .sort()
  .at(0);
---

<section
  id={SECTION_IDS.experience}
  aria-labelledby="experience-title"
  data-stage-scene="none"
  class="relative z-(--z-content) bg-bg px-gutter py-section"
>
  <div class="mx-auto flex max-w-content flex-col gap-stack">
    <SectionHeader
      id="experience-title"
      eyebrow={firstYear ? `${firstYear} – ${t('experience.present')}` : undefined}
      title={t('experience.title')}
      subtitle={t('experience.subtitle')}
    />
    <ol class="mx-auto w-full max-w-[52rem] md:mx-0" role="list">
      {entries.map(entry => (
        <TimelineItem locale={locale} {...entry} />
      ))}
    </ol>
  </div>
</section>
