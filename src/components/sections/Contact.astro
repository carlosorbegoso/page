---
import CvLink from '../ui/CvLink.astro';
import ExternalLink from '../ui/ExternalLink.astro';
import CopyEmail from '../contact/CopyEmail.astro';
import { SECTION_IDS, SITE } from '../../config/site';
import { useTranslations, type Locale } from '../../i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const socials = [
  { label: 'LinkedIn', detail: 'carlos-orbergoso-loayza', href: SITE.social.linkedin, icon: 'in' },
  { label: 'GitHub', detail: 'carlosorbegoso', href: SITE.social.github, icon: 'gh' },
  { label: 'X', detail: SITE.handle, href: SITE.social.x, icon: 'x' }
];
const tile =
  'flex min-h-14 w-full items-center gap-4 rounded-2xl border border-text/10 bg-text/[0.04] px-4 text-start text-text transition-colors duration-(--duration-fast) ease-standard hover:border-accent/50 hover:bg-accent/10 focus-visible:shadow-focus focus-visible:outline-none';
const glyph =
  'grid size-9 shrink-0 place-items-center rounded-xl bg-accent/15 font-display text-xs font-semibold text-accent';
---

<section
  id={SECTION_IDS.contact}
  aria-labelledby="contact-title"
  data-station="contact"
  class="relative flex min-h-svh flex-col items-center justify-center px-gutter py-section"
>
  <div
    class="plate w-full max-w-[24rem] p-(--plate-padding)"
    data-plate
    data-plate-id="contact"
    data-plate-mode="surface-phone"
  >
    <div class="contact-screen flex flex-col gap-6">
    <header class="flex flex-col gap-2">
      <h2 id="contact-title" class="font-display text-3xl font-semibold tracking-display text-text">
        {t('contact.title')}
      </h2>
      <p class="text-base text-pretty text-text-muted">{t('contact.subtitle')}</p>
    </header>

    <div class="contact-group flex flex-col gap-2">
      <p id="contact-email-label" class="sr-only">{t('contact.email')}</p>
      <a href={`mailto:${SITE.email}`} class:list={[tile, 'contact-email min-h-16 border-accent/45 bg-accent/10']} aria-describedby="contact-email-label">
        <span class:list={[glyph, 'contact-glyph']} aria-hidden="true">
          <svg viewBox="0 0 24 24" width="18" height="18" class="fill-none stroke-current" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="5" width="18" height="14" rx="2"></rect>
            <path d="m3 7 9 6 9-6"></path>
          </svg>
        </span>
        <span class="flex min-w-0 flex-col">
          <span class="contact-email-label text-xs text-text-muted">{t('contact.email')}</span>
          <span class="contact-email-value truncate font-medium">{SITE.email}</span>
        </span>
      </a>
      <CopyEmail locale={locale} email={SITE.email} />
    </div>

    <div class="contact-group flex flex-col gap-2">
      <p id="contact-social-label" class="contact-social-label text-xs font-semibold tracking-caps text-text-muted uppercase">
        {t('contact.social')}
      </p>
      <ul aria-labelledby="contact-social-label" class="contact-socials flex flex-col gap-2" role="list" data-kinetic-cascade>
        {
          socials.map(social => (
            <li>
              <ExternalLink href={social.href} locale={locale} class={tile}>
                <span class:list={[glyph, 'contact-glyph']} aria-hidden="true">{social.icon}</span>
                <span class="flex min-w-0 flex-col">
                  <span class="contact-social-name font-medium">{social.label}</span>
                  <span class="contact-social-detail truncate text-xs text-text-muted">{social.detail}</span>
                </span>
              </ExternalLink>
            </li>
          ))
        }
      </ul>
    </div>

    <CvLink locale={locale} variant="primary" size="lg" class="contact-cv min-h-14 w-full rounded-2xl" />
    </div>
  </div>
</section>

<style>
  /* The phone is a fixed-size screen: sizes are shares of its height so the CV button never falls off. */
  :global(.is-3d) .contact-screen {
    height: 100%;
    justify-content: center;
    gap: 3.2cqh;
  }

  :global(.is-3d) .contact-screen header {
    gap: 1.2cqh;
  }

  :global(.is-3d) .contact-screen h2 {
    font-size: 6cqh;
    line-height: 1.05;
  }

  :global(.is-3d) .contact-screen header p {
    font-size: 2.9cqh;
    line-height: 1.35;
  }

  :global(.is-3d) .contact-screen .contact-group {
    gap: 1.2cqh;
  }

  :global(.is-3d) .contact-email {
    min-height: 0;
    height: 9.5cqh;
    gap: 3cqw;
    padding-inline: 4cqw;
    border-radius: 2.2cqh;
  }

  :global(.is-3d) .contact-email .contact-glyph {
    width: 5.6cqh;
    height: 5.6cqh;
    border-radius: 1.6cqh;
  }

  :global(.is-3d) .contact-email .contact-glyph :global(svg) {
    width: 2.8cqh;
    height: 2.8cqh;
  }

  :global(.is-3d) .contact-email-label {
    font-size: 2.2cqh;
  }

  :global(.is-3d) .contact-email-value {
    font-size: 2.6cqh;
    letter-spacing: -0.01em;
  }

  :global(.is-3d) .contact-screen :global([data-copy-email]) {
    gap: 0;
  }

  :global(.is-3d) .contact-screen :global([data-copy-trigger]) {
    min-height: 0;
    height: 6cqh;
    border: 0;
    background: none;
    font-size: 2.5cqh;
    white-space: nowrap;
    color: var(--color-text-muted);
  }

  :global(.is-3d) .contact-screen :global([data-copy-trigger] svg) {
    width: 2.4cqh;
    height: 2.4cqh;
  }

  :global(.is-3d) .contact-screen :global([data-copy-status]:empty) {
    display: none;
  }

  :global(.is-3d) .contact-screen :global([data-copy-status]) {
    min-height: 0;
    margin-top: 0.6cqh;
    font-size: 2.4cqh;
  }

  :global(.is-3d) .contact-social-label {
    font-size: 2cqh;
  }

  /* Socials read as a settings-style list: one ruled row per network with its handle. */
  :global(.is-3d) .contact-socials {
    gap: 0;
    border-radius: 2.2cqh;
    background: rgb(255 255 255 / 0.04);
    overflow: hidden;
  }

  :global(.is-3d) .contact-socials li + li {
    border-top: 1px solid rgb(255 255 255 / 0.07);
  }

  :global(.is-3d) .contact-socials :global(a) {
    min-height: 0;
    height: 8cqh;
    gap: 3cqw;
    padding-inline: 4cqw;
    border: 0;
    border-radius: 0;
    background: none;
  }

  :global(.is-3d) .contact-socials .contact-glyph {
    width: 4.8cqh;
    height: 4.8cqh;
    border-radius: 1.4cqh;
    font-size: 1.9cqh;
  }

  :global(.is-3d) .contact-social-name {
    font-size: 2.6cqh;
    line-height: 1.2;
  }

  :global(.is-3d) .contact-social-detail {
    font-size: 2cqh;
  }

  :global(.is-3d) .contact-screen :global(.contact-cv) {
    min-height: 0;
    height: 8cqh;
    border-radius: 999px;
    font-size: 2.7cqh;
    white-space: nowrap;
  }

  :global(.is-3d) .contact-screen :global(.contact-cv svg) {
    width: 2.6cqh;
    height: 2.6cqh;
  }
</style>
