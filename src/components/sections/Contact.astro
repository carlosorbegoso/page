---
import Button from '../ui/Button.astro';
import CvLink from '../ui/CvLink.astro';
import SectionHeader from '../ui/SectionHeader.astro';
import CopyEmail from '../contact/CopyEmail.astro';
import { SECTION_IDS, SITE } from '../../config/site';
import { useTranslations, type Locale } from '../../i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const socials = [
  { label: 'LinkedIn', href: SITE.social.linkedin },
  { label: 'GitHub', href: SITE.social.github },
  { label: `X ${SITE.handle}`, href: SITE.social.x }
];
---

<section
  id={SECTION_IDS.contact}
  aria-labelledby="contact-title"
  data-station="contact"
  class="relative flex min-h-svh flex-col items-center justify-center px-gutter py-section lg:items-end lg:pr-24"
>
  <div class="plate @container flex w-full max-w-[36rem] flex-col gap-8 p-(--plate-padding)" data-plate data-plate-id="contact">
    <SectionHeader id="contact-title" title={t('contact.title')} subtitle={t('contact.subtitle')}>
      <p class="text-text-muted">{t('contact.body')}</p>
    </SectionHeader>

    <div class="flex flex-col gap-3">
      <p id="contact-email-label" class="text-xs font-semibold tracking-caps text-text-muted uppercase">
        {t('contact.email')}
      </p>
      <Button
        href={`mailto:${SITE.email}`}
        variant="primary"
        size="lg"
        class="w-full break-all"
        aria-describedby="contact-email-label"
      >
        <svg
          viewBox="0 0 24 24"
          width="18"
          height="18"
          aria-hidden="true"
          class="shrink-0 fill-none stroke-current"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <rect x="3" y="5" width="18" height="14" rx="2"></rect>
          <path d="m3 7 9 6 9-6"></path>
        </svg>
        {SITE.email}
      </Button>
      <CopyEmail locale={locale} email={SITE.email} />
    </div>

    <div class="flex flex-col gap-3 border-t border-border pt-6">
      <p id="contact-social-label" class="text-xs font-semibold tracking-caps text-text-muted uppercase">
        {t('contact.social')}
      </p>
      <ul aria-labelledby="contact-social-label" class="grid gap-2 @md:grid-cols-2" role="list" data-kinetic-cascade data-depth="40">
        {socials.map(social => (
          <li class="@md:last:col-span-2">
            <Button href={social.href} variant="secondary" external class="w-full">
              {social.label}
            </Button>
          </li>
        ))}
      </ul>
      <CvLink locale={locale} variant="ghost" class="w-full" />
    </div>
  </div>
</section>
