---
import { SITE } from '../config/site';
import { useTranslations, type Locale } from '../i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const year = new Date().getFullYear();
---

<footer>
  <p>
    © {year} {SITE.name}. {t('footer.rights')}
  </p>
</footer>
