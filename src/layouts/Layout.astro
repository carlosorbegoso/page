---
interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const siteUrl = 'https://carlosorbegoso.github.io/page';
const {
  title = "Carlos Orbegoso - Backend Developer & Java Specialist",
  description = "Backend Developer especializado en Java, Spring Boot y Quarkus. +5 años de experiencia en microservicios, APIs REST y arquitecturas cloud-native.",
  image = `${siteUrl}/images/og-image.jpg`
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, siteUrl);
---

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="default">
    <meta name="theme-color" content="#64B5F6" media="(prefers-color-scheme: dark)">
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)">
    <title>{title}</title>
    <meta name="description" content={description}>

    <!-- SEO Meta Tags -->
    <meta name="author" content="Carlos Orbegoso">
    <meta name="keywords" content="Backend Developer, Java Developer, Spring Boot, Quarkus, Microservices, Cloud Native, Software Engineer, API REST, Lima Peru, Desarrollador Backend">
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1">
    <meta name="googlebot" content="index, follow">
    <link rel="canonical" href={canonicalURL}>

    <!-- Geo Tags for Local SEO -->
    <meta name="geo.region" content="PE-LIM">
    <meta name="geo.placename" content="Lima, Peru">

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website">
    <meta property="og:url" content={canonicalURL}>
    <meta property="og:title" content={title}>
    <meta property="og:description" content={description}>
    <meta property="og:image" content={image}>
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:image:alt" content="Carlos Orbegoso - Backend Developer Portfolio">
    <meta property="og:locale" content="es_PE">
    <meta property="og:locale:alternate" content="en_US">
    <meta property="og:site_name" content="Carlos Orbegoso Portfolio">

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:url" content={canonicalURL}>
    <meta name="twitter:title" content={title}>
    <meta name="twitter:description" content={description}>
    <meta name="twitter:image" content={image}>
    <meta name="twitter:creator" content="@carlosorbegoso">

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}/favicon.svg`}>
    <link rel="apple-touch-icon" sizes="180x180" href={`${import.meta.env.BASE_URL}/favicon.svg`}>

    <!-- PWA Manifest -->
    <link rel="manifest" href={`${import.meta.env.BASE_URL}/manifest.json`}>

    <!-- DNS Prefetch for external resources -->
    <link rel="dns-prefetch" href="https://fonts.googleapis.com">
    <link rel="dns-prefetch" href="https://cdnjs.cloudflare.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <!-- Structured Data / JSON-LD - Person -->
    <script is:inline type="application/ld+json" set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "Person",
        "name": "Carlos Orbegoso",
        "url": siteUrl,
        "image": image,
        "jobTitle": "Backend Developer",
        "description": description,
        "address": {
            "@type": "PostalAddress",
            "addressLocality": "Lima",
            "addressCountry": "PE"
        },
        "worksFor": {
            "@type": "Organization",
            "name": "Tata Consultancy Services"
        },
        "sameAs": [
            "https://github.com/carlosorbegoso",
            "https://linkedin.com/in/carlos-orbergoso-loayza"
        ],
        "knowsAbout": ["Java", "Spring Boot", "Quarkus", "Microservices", "Cloud Native", "Backend Development", "REST API", "Docker", "Kubernetes", "AWS"]
    })} />

    <!-- Structured Data / JSON-LD - WebSite -->
    <script is:inline type="application/ld+json" set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "WebSite",
        "name": "Carlos Orbegoso Portfolio",
        "url": siteUrl,
        "description": description,
        "author": {
            "@type": "Person",
            "name": "Carlos Orbegoso"
        }
    })} />

    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">

    <!-- Google Fonts (optimized: reduced families and weights) -->
    <link rel="preload" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Poppins:wght@500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" as="style">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Poppins:wght@500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">

    <!-- Loader styles -->
    <style>
        /* ===== CINEMATIC LOADER ===== */

        /* Hide header during loading */
        .page-loader ~ * .header,
        .page-loader ~ * .mobile-bottom-nav {
            opacity: 0;
            pointer-events: none;
            transition: opacity 0.6s ease;
        }

        .page-loader.loaded ~ * .header,
        .page-loader.loaded ~ * .mobile-bottom-nav {
            opacity: 1;
            pointer-events: auto;
        }

        .page-loader {
            position: fixed;
            inset: 0;
            background: #020205;
            display: flex;
            align-items: center;
            justify-content: center;
            z-index: 9999;
            overflow: hidden;
        }

        /* Three.js canvas container (kept for potential future use) */
        #loader-canvas-container { display: none; }

        /* Multi-layer ambient glow */
        .page-loader::before {
            content: '';
            position: absolute;
            inset: 0;
            background:
                radial-gradient(ellipse 80% 60% at 50% 45%, rgba(100, 181, 246, 0.06) 0%, transparent 70%),
                radial-gradient(circle at 20% 80%, rgba(170, 68, 255, 0.03) 0%, transparent 50%),
                radial-gradient(circle at 80% 20%, rgba(0, 255, 255, 0.03) 0%, transparent 50%);
            animation: ambientBreath 6s ease-in-out infinite;
        }

        @keyframes ambientBreath {
            0%, 100% { opacity: 0.4; transform: scale(1); }
            50% { opacity: 1; transform: scale(1.05); }
        }

        .page-loader.loaded {
            animation: loaderExit 1.8s cubic-bezier(0.4, 0, 0.2, 1) forwards;
        }

        @keyframes loaderExit {
            0% { opacity: 1; }
            100% { opacity: 0; visibility: hidden; }
        }

        /* Ambient horizontal lines */
        .loader-ambient {
            position: absolute;
            inset: 0;
            overflow: hidden;
            z-index: 0;
        }

        .ambient-line {
            position: absolute;
            left: 0;
            right: 0;
            height: 1px;
            background: linear-gradient(90deg, transparent, rgba(100, 181, 246, 0.2) 20%, rgba(0, 255, 255, 0.1) 50%, rgba(170, 68, 255, 0.08) 80%, transparent);
            opacity: 0;
        }

        .line-1 { top: 25%; animation: lineSweep 5s ease forwards 0.3s; }
        .line-2 { top: 50%; animation: lineSweep 5s ease forwards 1s; }
        .line-3 { top: 75%; animation: lineSweep 5s ease forwards 1.7s; }

        @keyframes lineSweep {
            0% { opacity: 0; transform: scaleX(0); transform-origin: left; }
            40% { opacity: 0.8; transform: scaleX(1); }
            100% { opacity: 0.15; }
        }

        /* Floating particles */
        .loader-particles {
            position: absolute;
            inset: 0;
            z-index: 0;
        }

        .l-particle {
            position: absolute;
            left: var(--x);
            top: var(--y);
            width: var(--s);
            height: var(--s);
            background: rgba(100, 181, 246, 0.5);
            border-radius: 50%;
            box-shadow: 0 0 8px rgba(100, 181, 246, 0.3);
            opacity: 0;
            animation: particleFloat var(--d) ease-in-out infinite;
            animation-delay: calc(var(--d) * -0.3);
        }

        @keyframes particleFloat {
            0% { opacity: 0; transform: translateY(0); }
            15% { opacity: 0.7; }
            50% { transform: translateY(-30px); opacity: 0.4; }
            85% { opacity: 0.7; }
            100% { opacity: 0; transform: translateY(0); }
        }

        /* Center group */
        .loader-center {
            position: relative;
            z-index: 2;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 2.5rem;
        }

        /* Double ring with glow */
        .loader-ring-container {
            position: relative;
            width: 160px;
            height: 160px;
            opacity: 0;
            animation: ringAppear 2.5s cubic-bezier(0.25, 0.1, 0.25, 1) forwards 0.2s;
        }

        @keyframes ringAppear {
            0% { opacity: 0; transform: scale(0.3); filter: blur(10px); }
            50% { opacity: 1; filter: blur(0); }
            100% { opacity: 1; transform: scale(1); }
        }

        .loader-ring-svg {
            width: 100%;
            height: 100%;
        }

        .loader-ring-track {
            fill: none;
            stroke: rgba(100, 181, 246, 0.06);
            stroke-width: 0.8;
        }

        .loader-ring-outer {
            fill: none;
            stroke: url(#ringGrad);
            stroke-width: 1.2;
            stroke-linecap: round;
            stroke-dasharray: 565;
            stroke-dashoffset: 565;
            animation: ringDraw 3s cubic-bezier(0.4, 0, 0.2, 1) forwards 0.5s;
            transform-origin: center;
        }

        .loader-ring-inner {
            fill: none;
            stroke: rgba(0, 255, 255, 0.15);
            stroke-width: 0.5;
            stroke-dasharray: 440;
            stroke-dashoffset: 440;
            animation: ringDraw 2.5s cubic-bezier(0.4, 0, 0.2, 1) forwards 1s,
                       ringRotateReverse 20s linear infinite 3.5s;
            transform-origin: center;
        }

        .loader-ring-dot {
            opacity: 0;
            animation: dotAppear 0.5s ease forwards 3s,
                       ringRotateDot 6s linear infinite 3s;
            transform-origin: 100px 100px;
        }

        @keyframes ringDraw {
            to { stroke-dashoffset: 140; }
        }

        @keyframes ringRotateDot {
            to { transform: rotate(360deg); }
        }

        @keyframes ringRotateReverse {
            to { transform: rotate(-360deg); }
        }

        @keyframes dotAppear {
            to { opacity: 1; }
        }

        /* Initials inside ring */
        .loader-initials {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            font-family: 'Inter', sans-serif;
            font-size: 2.2rem;
            font-weight: 800;
            letter-spacing: 0.15em;
            color: transparent;
            background: linear-gradient(180deg, #ffffff 0%, rgba(100, 181, 246, 0.8) 100%);
            -webkit-background-clip: text;
            background-clip: text;
            opacity: 0;
            animation: initialsReveal 1.8s cubic-bezier(0.25, 0.1, 0.25, 1) forwards 1.2s;
        }

        @keyframes initialsReveal {
            0% { opacity: 0; letter-spacing: 0.5em; filter: blur(8px); }
            60% { filter: blur(0); }
            100% { opacity: 1; letter-spacing: 0.15em; }
        }

        /* Glow behind ring */
        .loader-ring-glow {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            width: 200px;
            height: 200px;
            background: radial-gradient(circle, rgba(100, 181, 246, 0.1) 0%, rgba(0, 255, 255, 0.05) 40%, transparent 70%);
            border-radius: 50%;
            animation: glowPulse 4s ease-in-out infinite 1s;
            z-index: -1;
        }

        @keyframes glowPulse {
            0%, 100% { transform: translate(-50%, -50%) scale(1); opacity: 0.5; }
            50% { transform: translate(-50%, -50%) scale(1.3); opacity: 1; }
        }

        /* Content */
        .loader-content {
            text-align: center;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 0.6rem;
        }

        .loader-greeting {
            font-family: 'JetBrains Mono', monospace;
            font-size: 0.7rem;
            color: rgba(100, 181, 246, 0.5);
            letter-spacing: 0.3em;
            text-transform: uppercase;
            opacity: 0;
            animation: fadeInUp 1s ease forwards 1.8s;
        }

        .loader-text {
            font-family: 'Inter', sans-serif;
            font-size: clamp(1.2rem, 4vw, 1.8rem);
            font-weight: 700;
            letter-spacing: 0.15em;
            text-transform: uppercase;
            display: flex;
            gap: 0;
        }

        .loader-letter {
            color: #ffffff;
            opacity: 0;
            display: inline-block;
            animation: letterReveal 0.6s cubic-bezier(0.25, 0.1, 0.25, 1) forwards;
            animation-delay: calc(2s + var(--i) * 0.06s);
        }

        .loader-space { width: 0.4em; }

        @keyframes letterReveal {
            0% { opacity: 0; transform: translateY(15px) rotateX(40deg); filter: blur(4px); }
            100% { opacity: 1; transform: translateY(0) rotateX(0); filter: blur(0); }
        }

        .loader-divider {
            width: 0;
            height: 1px;
            background: linear-gradient(90deg, transparent, rgba(100, 181, 246, 0.5), rgba(0, 255, 255, 0.3), transparent);
            opacity: 0;
            animation: dividerExpand 1.5s cubic-bezier(0.25, 0.1, 0.25, 1) forwards 2.8s;
        }

        @keyframes dividerExpand {
            0% { opacity: 0; width: 0; }
            100% { opacity: 1; width: 80px; }
        }

        .loader-role {
            display: inline-block;
            color: transparent;
            background: linear-gradient(90deg, #64B5F6, #00ffff, #aa44ff);
            background-size: 200% 100%;
            -webkit-background-clip: text;
            background-clip: text;
            font-family: 'JetBrains Mono', monospace;
            font-size: clamp(0.7rem, 2vw, 0.85rem);
            font-weight: 500;
            letter-spacing: 0.08em;
            opacity: 0;
            animation: fadeInUp 1.2s ease forwards 3s,
                       gradientShift 4s ease infinite 3s;
        }

        @keyframes fadeInUp {
            0% { opacity: 0; transform: translateY(15px); filter: blur(3px); }
            100% { opacity: 1; transform: translateY(0); filter: blur(0); }
        }

        @keyframes gradientShift {
            0%, 100% { background-position: 0% 50%; }
            50% { background-position: 100% 50%; }
        }

        /* Progress Bar */
        .loader-progress-container {
            width: clamp(200px, 50vw, 300px);
            opacity: 0;
            animation: fadeInUp 1s ease forwards 3.3s;
        }

        .loader-progress {
            width: 100%;
            height: 2px;
            background: rgba(100, 181, 246, 0.06);
            border-radius: 10px;
            overflow: hidden;
            position: relative;
            margin-bottom: 0.6rem;
        }

        .loader-progress-bar {
            width: 0%;
            height: 100%;
            background: linear-gradient(90deg, #64B5F6, #00ffff);
            border-radius: 10px;
            box-shadow: 0 0 15px rgba(0, 255, 255, 0.5), 0 0 30px rgba(100, 181, 246, 0.2);
            transition: width 0.8s cubic-bezier(0.25, 0.1, 0.25, 1);
            position: relative;
        }

        .loader-progress-glow {
            position: absolute;
            right: 0;
            top: -4px;
            width: 10px;
            height: 10px;
            background: radial-gradient(circle, rgba(0, 255, 255, 0.8), transparent);
            border-radius: 50%;
            opacity: 0;
            animation: glowAppear 0.5s ease forwards 3.5s;
        }

        @keyframes glowAppear { to { opacity: 1; } }

        .loader-progress-label {
            display: flex;
            justify-content: space-between;
            font-family: 'JetBrains Mono', monospace;
            font-size: 0.6rem;
            color: rgba(255, 255, 255, 0.25);
            letter-spacing: 0.08em;
        }

        .loader-progress-value {
            color: rgba(0, 255, 255, 0.6);
            font-weight: 600;
        }

        /* Skill tags */
        .loader-skills {
            display: flex;
            gap: 0.5rem;
            justify-content: center;
            flex-wrap: wrap;
            max-width: 320px;
        }

        .loader-skill {
            padding: 0.35rem 0.85rem;
            background: rgba(100, 181, 246, 0.04);
            border: 1px solid rgba(100, 181, 246, 0.15);
            border-radius: 20px;
            font-family: 'JetBrains Mono', monospace;
            font-size: 0.65rem;
            color: rgba(255, 255, 255, 0.6);
            opacity: 0;
            transform: translateY(10px);
            letter-spacing: 0.04em;
        }

        .loader-skill:nth-child(1) { animation: skillSlideUp 0.5s ease forwards 3.6s; }
        .loader-skill:nth-child(2) { animation: skillSlideUp 0.5s ease forwards 3.75s; }
        .loader-skill:nth-child(3) { animation: skillSlideUp 0.5s ease forwards 3.9s; }
        .loader-skill:nth-child(4) { animation: skillSlideUp 0.5s ease forwards 4.05s; }

        @keyframes skillSlideUp {
            to { opacity: 1; transform: translateY(0); }
        }

        /* Responsive */
        @media (max-width: 480px) {
            .loader-ring-container { width: 120px; height: 120px; }
            .loader-initials { font-size: 1.6rem; }
            .loader-ring-glow { width: 150px; height: 150px; }
            .loader-center { gap: 1.5rem; }
            .loader-skills { max-width: 260px; }
        }

        /* Reduced motion */
        @media (prefers-reduced-motion: reduce) {
            .page-loader::before,
            .loader-ring-glow,
            .l-particle,
            .ambient-line { animation: none; opacity: 0.5; }
            .loader-progress-bar { transition: none; }
            .loader-ring-outer,
            .loader-ring-inner,
            .loader-ring-dot { animation: none; stroke-dashoffset: 140; opacity: 1; }
            .loader-initials,
            .loader-greeting,
            .loader-letter,
            .loader-divider,
            .loader-role,
            .loader-progress-container,
            .loader-progress-glow,
            .loader-skill { animation: none; opacity: 1; transform: none; width: auto; }
        }

        /* ===== MAIN CONTENT REVEAL TRANSITION ===== */
        #main-content {
            opacity: 0;
            transform: translateY(30px);
            transition: opacity 1.6s cubic-bezier(0.25, 0.1, 0.25, 1),
                        transform 1.8s cubic-bezier(0.25, 0.1, 0.25, 1);
        }

        #main-content.revealed {
            opacity: 1;
            transform: translateY(0);
        }

        /* Cinematic stagger - each section fades in sequentially */
        #main-content.revealed > section,
        #main-content.revealed > header,
        #main-content.revealed > footer {
            animation: sectionReveal 1s cubic-bezier(0.25, 0.1, 0.25, 1) backwards;
        }

        #main-content.revealed > *:nth-child(1) { animation-delay: 0s; }
        #main-content.revealed > *:nth-child(2) { animation-delay: 0.2s; }
        #main-content.revealed > *:nth-child(3) { animation-delay: 0.35s; }
        #main-content.revealed > *:nth-child(4) { animation-delay: 0.5s; }
        #main-content.revealed > *:nth-child(5) { animation-delay: 0.65s; }
        #main-content.revealed > *:nth-child(6) { animation-delay: 0.8s; }
        #main-content.revealed > *:nth-child(7) { animation-delay: 0.95s; }
        #main-content.revealed > *:nth-child(8) { animation-delay: 1.1s; }
        #main-content.revealed > *:nth-child(9) { animation-delay: 1.25s; }

        @keyframes sectionReveal {
            from {
                opacity: 0;
                transform: translateY(40px) scale(0.98);
                filter: blur(4px);
            }
            to {
                opacity: 1;
                transform: translateY(0) scale(1);
                filter: blur(0);
            }
        }

        @media (prefers-reduced-motion: reduce) {
            #main-content {
                opacity: 1;
                transform: none;
                transition: none;
            }
            #main-content.revealed > section,
            #main-content.revealed > header,
            #main-content.revealed > footer {
                animation: none;
            }
        }

        /* ===== SCROLL REVEAL SYSTEM ===== */
        /* Elements with data-reveal will animate in on scroll */
        [data-reveal] {
            opacity: 0;
            transform: translateY(30px);
            transition: opacity 0.8s cubic-bezier(0.25, 0.1, 0.25, 1),
                        transform 0.9s cubic-bezier(0.25, 0.1, 0.25, 1),
                        filter 0.8s ease;
            filter: blur(2px);
            will-change: opacity, transform;
        }

        [data-reveal].revealed {
            opacity: 1;
            transform: translateY(0);
            filter: blur(0);
        }

        /* Stagger children within a section */
        [data-reveal-stagger] > * {
            opacity: 0;
            transform: translateY(25px);
            transition: opacity 0.7s cubic-bezier(0.25, 0.1, 0.25, 1),
                        transform 0.8s cubic-bezier(0.25, 0.1, 0.25, 1);
        }

        [data-reveal-stagger].revealed > *:nth-child(1) { transition-delay: 0s; }
        [data-reveal-stagger].revealed > *:nth-child(2) { transition-delay: 0.08s; }
        [data-reveal-stagger].revealed > *:nth-child(3) { transition-delay: 0.16s; }
        [data-reveal-stagger].revealed > *:nth-child(4) { transition-delay: 0.24s; }
        [data-reveal-stagger].revealed > *:nth-child(5) { transition-delay: 0.32s; }
        [data-reveal-stagger].revealed > *:nth-child(6) { transition-delay: 0.4s; }
        [data-reveal-stagger].revealed > *:nth-child(7) { transition-delay: 0.48s; }
        [data-reveal-stagger].revealed > *:nth-child(8) { transition-delay: 0.56s; }

        [data-reveal-stagger].revealed > * {
            opacity: 1;
            transform: translateY(0);
        }

        /* Direction variants */
        [data-reveal="left"] {
            transform: translateX(-40px) translateY(0);
        }
        [data-reveal="right"] {
            transform: translateX(40px) translateY(0);
        }
        [data-reveal="scale"] {
            transform: scale(0.9) translateY(0);
        }

        [data-reveal="left"].revealed,
        [data-reveal="right"].revealed,
        [data-reveal="scale"].revealed {
            transform: translateX(0) translateY(0) scale(1);
        }

        @media (prefers-reduced-motion: reduce) {
            [data-reveal],
            [data-reveal-stagger] > * {
                opacity: 1;
                transform: none;
                filter: none;
                transition: none;
            }
        }
    </style>
</head>
<body>
    <!-- Skip Link for Accessibility -->
    <a href="#main-content" class="skip-link">Skip to main content</a>

    <!-- Toast Container for Notifications -->
    <div class="toast-container" id="toast-container"></div>

    <!-- Page Loader - Cinematic Intro -->
    <div class="page-loader" id="page-loader">
        <!-- Three.js canvas will be inserted here -->
        <div id="loader-canvas-container"></div>

        <!-- Cinematic ambient lines -->
        <div class="loader-ambient">
            <div class="ambient-line line-1"></div>
            <div class="ambient-line line-2"></div>
            <div class="ambient-line line-3"></div>
        </div>

        <!-- Floating particles background -->
        <div class="loader-particles">
            <div class="l-particle" style="--x:10%;--y:20%;--d:6s;--s:3px"></div>
            <div class="l-particle" style="--x:25%;--y:70%;--d:8s;--s:2px"></div>
            <div class="l-particle" style="--x:40%;--y:30%;--d:7s;--s:4px"></div>
            <div class="l-particle" style="--x:60%;--y:80%;--d:9s;--s:2px"></div>
            <div class="l-particle" style="--x:75%;--y:15%;--d:6s;--s:3px"></div>
            <div class="l-particle" style="--x:85%;--y:60%;--d:10s;--s:2px"></div>
            <div class="l-particle" style="--x:15%;--y:50%;--d:7s;--s:2px"></div>
            <div class="l-particle" style="--x:50%;--y:90%;--d:8s;--s:3px"></div>
            <div class="l-particle" style="--x:90%;--y:40%;--d:6s;--s:2px"></div>
            <div class="l-particle" style="--x:35%;--y:55%;--d:9s;--s:4px"></div>
        </div>

        <!-- Central content -->
        <div class="loader-center">
            <!-- Double rotating rings with glow -->
            <div class="loader-ring-container">
                <svg viewBox="0 0 200 200" class="loader-ring-svg">
                    <defs>
                        <linearGradient id="ringGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                            <stop offset="0%" style="stop-color:#64B5F6"/>
                            <stop offset="50%" style="stop-color:#00ffff"/>
                            <stop offset="100%" style="stop-color:#aa44ff"/>
                        </linearGradient>
                        <filter id="ringGlow">
                            <feGaussianBlur stdDeviation="3" result="glow"/>
                            <feMerge><feMergeNode in="glow"/><feMergeNode in="SourceGraphic"/></feMerge>
                        </filter>
                    </defs>
                    <!-- Outer ring -->
                    <circle cx="100" cy="100" r="90" class="loader-ring-track"/>
                    <circle cx="100" cy="100" r="90" class="loader-ring-outer" filter="url(#ringGlow)"/>
                    <!-- Inner ring -->
                    <circle cx="100" cy="100" r="70" class="loader-ring-track"/>
                    <circle cx="100" cy="100" r="70" class="loader-ring-inner"/>
                    <!-- Dot on outer ring -->
                    <circle cx="100" cy="10" r="4" class="loader-ring-dot" fill="url(#ringGrad)" filter="url(#ringGlow)"/>
                </svg>
                <div class="loader-initials">CO</div>
                <div class="loader-ring-glow"></div>
            </div>

            <div class="loader-content">
                <div class="loader-greeting">Welcome to</div>
                <div class="loader-text">
                    <span class="loader-letter" style="--i:0">C</span><span class="loader-letter" style="--i:1">A</span><span class="loader-letter" style="--i:2">R</span><span class="loader-letter" style="--i:3">L</span><span class="loader-letter" style="--i:4">O</span><span class="loader-letter" style="--i:5">S</span><span class="loader-space"></span><span class="loader-letter" style="--i:6">O</span><span class="loader-letter" style="--i:7">R</span><span class="loader-letter" style="--i:8">B</span><span class="loader-letter" style="--i:9">E</span><span class="loader-letter" style="--i:10">G</span><span class="loader-letter" style="--i:11">O</span><span class="loader-letter" style="--i:12">S</span><span class="loader-letter" style="--i:13">O</span>
                </div>
                <div class="loader-divider"></div>
                <div class="loader-role">Backend Developer & Java Specialist</div>
            </div>

            <div class="loader-progress-container">
                <div class="loader-progress">
                    <div class="loader-progress-bar" id="loader-progress-bar"></div>
                    <div class="loader-progress-glow"></div>
                </div>
                <div class="loader-progress-label">
                    <span class="loader-status">Loading experience</span>
                    <span class="loader-progress-value">0%</span>
                </div>
            </div>

            <div class="loader-skills">
                <span class="loader-skill">Java</span>
                <span class="loader-skill">Spring Boot</span>
                <span class="loader-skill">Quarkus</span>
                <span class="loader-skill">Cloud Native</span>
            </div>
        </div>
    </div>
    <!-- Neural Background Container (Global) -->
    <div id="neural-background-container" class="neural-background-container"></div>

    <!-- Contenedor para efectos visuales Three.js -->
    <div id="visual-effects-container" class="visual-effects-container"></div>

    <!-- Main Content -->
    <main id="main-content">
        <slot />
    </main>

    <!-- Scripts de inicialización -->
    <script>
        import '../styles/main.css';
        import { Portfolio } from '../scripts/core/Portfolio.js';
        import { LoaderProgress } from '../scripts/core/LoaderProgress.js';
        import { initWebVitals } from '../scripts/utils/web-vitals.js';
        import { ScrollAnimations } from '../scripts/utils/scroll-animations.js';
        import { LazyImages } from '../scripts/utils/lazy-images.js';
        import { toast } from '../scripts/utils/toast.js';

        // Initialize Web Vitals tracking
        initWebVitals();

        // Initialize lazy loading and scroll animations
        const lazyImages = new LazyImages();
        const scrollAnimations = new ScrollAnimations();

        // Make toast available globally for copy-to-clipboard etc
        window.toast = toast;

        const loaderProgress = new LoaderProgress();

        // Update loader progress
        const updateProgress = (progress) => {
            loaderProgress.updateProgress(progress);
        };

        // Cinematic progress - slow, smooth, like entering a movie
        setTimeout(() => updateProgress(8), 300);
        setTimeout(() => updateProgress(18), 800);
        setTimeout(() => updateProgress(30), 1400);
        setTimeout(() => updateProgress(42), 2000);
        setTimeout(() => updateProgress(55), 2800);

        // Hide loader with cinematic transition
        const hideLoader = async () => {
            loaderProgress.complete();

            // Pause at 100% for dramatic effect
            await new Promise(r => setTimeout(r, 900));

            // Cinematic fade - reveal main content slowly
            const mainContent = document.getElementById('main-content');
            if (mainContent) {
                mainContent.classList.add('revealed');
            }

            setTimeout(() => loaderProgress.hide(), 600);
        };

        // Scroll progress is now handled by the Command Hub in Header.astro
        const setupScrollProgress = () => {};

    
        document.addEventListener('DOMContentLoaded', async () => {
            updateProgress(60);

            const portfolio = new Portfolio();

            updateProgress(75);
            await portfolio.init();
            updateProgress(90);

            window.portfolio = portfolio;

            setupScrollProgress();

            updateProgress(100);
            setTimeout(hideLoader, 1200);
        });

        // Fallback: hide loader after max wait time
        window.addEventListener('load', () => {
            if (!loaderProgress.isComplete) {
                updateProgress(100);
                setTimeout(hideLoader, 1500);
            }
        });

        // ===== SCROLL REVEAL SYSTEM =====
        // Auto-apply data-reveal to section inner elements
        document.addEventListener('DOMContentLoaded', () => {
            // Target key elements inside sections for reveal animations
            const revealSelectors = [
                '.section-header',
                '.section-badge',
                '.section-title',
                '.section-subtitle',
                '.hero-grid',
                '.hero-photo',
                '.hero-info',
                '.hero-actions',
                '.bento-grid',
                '.bento-card',
                '.contact-content',
                '.contact-methods',
                '.contact-item',
                '.social-section',
                '.projects-grid',
                '.project-card',
                '.footer-quote',
                '.footer-bottom'
            ];

            revealSelectors.forEach(sel => {
                document.querySelectorAll(sel).forEach(el => {
                    if (!el.hasAttribute('data-reveal')) {
                        el.setAttribute('data-reveal', '');
                    }
                });
            });

            // Stagger grids
            document.querySelectorAll('.bento-grid, .projects-grid, .contact-grid').forEach(el => {
                el.setAttribute('data-reveal-stagger', '');
            });

            // Create the observer
            const revealObserver = new IntersectionObserver((entries) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        entry.target.classList.add('revealed');
                        revealObserver.unobserve(entry.target);
                    }
                });
            }, {
                threshold: 0.08,
                rootMargin: '0px 0px -60px 0px'
            });

            // Observe all reveal elements
            document.querySelectorAll('[data-reveal], [data-reveal-stagger]').forEach(el => {
                revealObserver.observe(el);
            });
        });
    </script>
</body>
</html>
