---
import Base from '../../../layouts/Base.astro';
import ReadingBar from '../../ReadingBar.astro';
import Footer from '../../Footer.astro';
import CvLink from '../../ui/CvLink.astro';
import ExternalLink from '../../ui/ExternalLink.astro';
import { formatTimelineMonth } from '../../experience/dates';
import { SITE } from '../../../config/site';
import { localeUrl, useTranslations, type Locale } from '../../../i18n/utils';
import { getExperience, getProducts, getProfile } from '../../../lib/content';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const profile = await getProfile(locale);
const experience = [...(await getExperience(locale))].sort((a, b) => b.start.localeCompare(a.start));
const products = await getProducts(locale);

/* Same split as About.astro: the last summary paragraph holds the CIBERTEC and Alura credentials. */
const summary = profile.summary.slice(0, -1);
const credentials = profile.summary.slice(-1);

const readingPaths: Record<Locale, string> = {
  es: localeUrl('es', 'lectura'),
  en: localeUrl('en', 'reading')
};

const displayUrl = (href: string) => href.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '');
const social = [
  { label: 'LinkedIn', href: SITE.social.linkedin },
  { label: 'GitHub', href: SITE.social.github },
  { label: 'X', href: SITE.social.x }
];
const statusLabel = {
  production: t('products.status.production'),
  building: t('products.status.building')
} as const;
---

<Base
  locale={locale}
  title={t('reading.metaTitle')}
  description={t('reading.description')}
  alternates={readingPaths}
  colorScheme="dark light"
>
  <script is:inline slot="head">
    document.documentElement.dataset.motion = 'paused';
    if (matchMedia('(prefers-color-scheme: light)').matches) document.documentElement.dataset.theme = 'light';
  </script>
  <ReadingBar locale={locale} />
  <main id="main" tabindex="-1" class="cv container-content">
    <header class="cv-masthead">
      <p class="cv-intro no-print">{t('reading.intro')}</p>
      <h1 class="cv-name">{profile.name}</h1>
      <p class="cv-role">{profile.role}</p>
      <p class="cv-meta">{profile.location} · {profile.tagline}</p>
      <ul class="cv-contact-line" role="list">
        <li><a href={`mailto:${SITE.email}`}>{SITE.email}</a></li>
        {social.map(item => (
          <li>
            <ExternalLink href={item.href} locale={locale}>{displayUrl(item.href)}</ExternalLink>
          </li>
        ))}
      </ul>
      <div class="cv-actions no-print">
        <CvLink locale={locale} variant="primary" />
        <button type="button" class="cv-print" data-print>{t('reading.print')}</button>
      </div>
    </header>

    <section class="cv-section" aria-labelledby="cv-profile">
      <h2 id="cv-profile" class="cv-heading">{t('reading.profile')}</h2>
      <div class="cv-body cv-prose">
        {summary.map(paragraph => <p>{paragraph}</p>)}
      </div>
    </section>

    <section class="cv-section" aria-labelledby="cv-experience">
      <h2 id="cv-experience" class="cv-heading">{t('experience.title')}</h2>
      <ol class="cv-body cv-list" role="list">
        {experience.map(job => (
          <li class="cv-entry">
            <div class="cv-entry__head">
              <h3 class="cv-entry__title">
                {job.role} · <span class="cv-entry__org">{job.company}</span>
              </h3>
              <p class="cv-entry__dates">
                <time datetime={job.start}>{formatTimelineMonth(job.start, locale)}</time>
                {' – '}
                {job.end ? (
                  <time datetime={job.end}>{formatTimelineMonth(job.end, locale)}</time>
                ) : (
                  t('experience.present')
                )}
              </p>
            </div>
            {job.client && (
              <p class="cv-entry__client">
                {t('experience.client')}: {job.client}
              </p>
            )}
            <p>{job.summary}</p>
            {job.highlights.length > 0 && (
              <ul class="cv-bullets">
                {job.highlights.map(item => <li>{item}</li>)}
              </ul>
            )}
            <p class="cv-stack">
              <span class="cv-stack__label">{t('experience.stack')}:</span> {job.stack.join(' · ')}
            </p>
          </li>
        ))}
      </ol>
    </section>

    <section class="cv-section" aria-labelledby="cv-company">
      <h2 id="cv-company" class="cv-heading">{t('products.title')}</h2>
      <div class="cv-body">
        <p class="cv-company">
          <strong>{profile.company.legalName}</strong> · {profile.company.role}
        </p>
        <div class="cv-prose">
          {profile.company.summary.map(paragraph => <p>{paragraph}</p>)}
        </div>
        <ul class="cv-list cv-products" role="list">
          {products.map(product => (
            <li class="cv-entry" data-product-id={product.id}>
              <div class="cv-entry__head">
                <h3 class="cv-entry__title">
                  {product.name} · <span class="cv-entry__org">{product.tagline}</span>
                </h3>
                <p class="cv-entry__dates">
                  <span class="cv-dot" aria-hidden="true"></span>
                  {statusLabel[product.status]}
                </p>
              </div>
              <p>{product.description}</p>
              <p class="cv-stack">
                <span class="cv-stack__label">{t('products.role')}:</span> {product.role} ·{' '}
                <ExternalLink href={product.url} locale={locale}>{displayUrl(product.url)}</ExternalLink>
              </p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="cv-section" aria-labelledby="cv-education">
      <h2 id="cv-education" class="cv-heading">{t('about.education')}</h2>
      <ul class="cv-body cv-list" role="list">
        <li class="cv-entry">
          <h3 class="cv-entry__title">
            {profile.education.degree} · <span class="cv-entry__org">{profile.education.institution}</span>
          </h3>
          <p>{profile.education.status}</p>
        </li>
        {credentials.map(item => (
          <li class="cv-entry">
            <p>{item}</p>
          </li>
        ))}
      </ul>
    </section>

    <section class="cv-section" aria-labelledby="cv-stack">
      <h2 id="cv-stack" class="cv-heading">{t('about.stack')}</h2>
      <dl class="cv-body cv-skills">
        {profile.stack.map(group => (
          <div>
            <dt>{group.category}</dt>
            <dd>{group.items.join(' · ')}</dd>
          </div>
        ))}
      </dl>
    </section>

    <section class="cv-section" aria-labelledby="cv-contact">
      <h2 id="cv-contact" class="cv-heading">{t('contact.title')}</h2>
      <div class="cv-body">
        <p class="cv-lead">{t('contact.subtitle')}</p>
        <dl class="cv-skills">
          <div>
            <dt>{t('contact.email')}</dt>
            <dd><a href={`mailto:${SITE.email}`}>{SITE.email}</a></dd>
          </div>
          {social.map(item => (
            <div>
              <dt>{item.label}</dt>
              <dd>
                <ExternalLink href={item.href} locale={locale}>{displayUrl(item.href)}</ExternalLink>
              </dd>
            </div>
          ))}
        </dl>
        <div class="cv-actions no-print">
          <CvLink locale={locale} />
        </div>
      </div>
    </section>
  </main>
  <Footer locale={locale} />
</Base>

<script>
  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-print]')) {
    button.addEventListener('click', () => window.print());
  }
</script>

<style>
  .cv {
    display: flex;
    flex-direction: column;
    gap: clamp(2.5rem, 2rem + 2vw, 4rem);
    max-width: calc(56rem + 2 * var(--spacing-gutter));
    padding-block: clamp(2rem, 1.5rem + 2vw, 3.5rem) var(--spacing-section);
    color: var(--color-text);
    font-size: var(--text-base);
    line-height: var(--leading-normal);
  }

  .cv :global(a:not([data-variant])) {
    color: var(--color-accent);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
    border-radius: var(--radius-xs);
  }

  .cv :global(a:not([data-variant]):hover) {
    color: var(--color-accent-hover);
  }

  .cv :global(a:not([data-variant]):focus-visible) {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
  }

  .cv-masthead {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding-bottom: clamp(2rem, 1.5rem + 2vw, 3rem);
    border-bottom: 1px solid var(--color-border);
  }

  .cv-intro {
    margin-bottom: 1rem;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .cv-name {
    font-size: var(--text-5xl);
    font-weight: var(--font-weight-semibold);
    line-height: var(--text-5xl--line-height);
    letter-spacing: var(--tracking-display);
  }

  .cv-role {
    margin-top: 0.5rem;
    font-size: var(--text-xl);
    font-weight: var(--font-weight-medium);
    line-height: var(--text-xl--line-height);
  }

  .cv-meta {
    color: var(--color-text-muted);
  }

  .cv-contact-line {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
    margin-top: 0.5rem;
    font-size: var(--text-sm);
  }

  .cv-contact-line :global(a) {
    display: inline-flex;
    align-items: center;
    min-height: var(--spacing-tap);
  }

  .cv-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1rem;
    margin-top: 1rem;
  }

  .cv-print {
    min-height: var(--spacing-tap);
    padding-inline: 0.75rem;
    border-radius: var(--radius-md);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    font-weight: var(--font-weight-medium);
    text-decoration: underline;
    text-underline-offset: 0.25em;
    cursor: pointer;
  }

  .cv-print:hover {
    color: var(--color-text);
  }

  .cv-print:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
  }

  .cv-section {
    display: grid;
    gap: 1rem;
  }

  @media (width >= 48rem) {
    .cv-section {
      grid-template-columns: 11rem minmax(0, 1fr);
      gap: 2rem;
    }
  }

  .cv-heading {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    font-weight: var(--font-weight-semibold);
    letter-spacing: var(--tracking-caps);
    line-height: var(--text-xl--line-height);
    text-transform: uppercase;
  }

  .cv-body {
    min-width: 0;
  }

  .cv-prose {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    max-width: var(--container-measure);
  }

  .cv-lead,
  .cv-company {
    margin-bottom: 0.75rem;
  }

  .cv-list {
    display: flex;
    flex-direction: column;
  }

  .cv-products {
    margin-top: 1.5rem;
  }

  .cv-entry {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    padding-block: 1.25rem;
    border-top: 1px solid var(--color-border);
    break-inside: avoid;
  }

  .cv-entry:first-child {
    padding-top: 0;
    border-top: 0;
  }

  .cv-entry__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.25rem 1rem;
  }

  .cv-entry__title {
    font-size: var(--text-lg);
    font-weight: var(--font-weight-semibold);
    line-height: var(--leading-snug);
  }

  .cv-entry__org {
    font-weight: var(--font-weight-regular);
    color: var(--color-text-muted);
  }

  .cv-entry__dates {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .cv-entry__client {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .cv-dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background-color: var(--color-status-live);
  }

  .cv-bullets {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    margin-top: 0.25rem;
    padding-inline-start: 1.25rem;
    list-style: disc;
  }

  .cv-bullets li::marker {
    color: var(--color-accent);
  }

  .cv-stack {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .cv-stack__label {
    font-weight: var(--font-weight-semibold);
    color: var(--color-text);
  }

  .cv-skills {
    display: grid;
    gap: 0.5rem;
  }

  .cv-skills > div {
    display: grid;
    gap: 0 1rem;
  }

  @media (width >= 36rem) {
    .cv-skills > div {
      grid-template-columns: 9rem minmax(0, 1fr);
    }
  }

  .cv-skills dt {
    font-weight: var(--font-weight-semibold);
  }

  .cv-skills dd {
    color: var(--color-text-muted);
  }

  @media print {
    @page {
      size: A4;
      margin: 14mm 16mm;
    }

    :global(html),
    :global(body) {
      background: #fff !important;
      color: #000 !important;
    }

    :global(header:has(+ #main)),
    :global([data-site-footer]),
    :global(a[href='#main']),
    .no-print {
      display: none !important;
    }

    .cv {
      --color-text: #000;
      --color-text-muted: #333;
      --color-accent: #000;
      --color-border: #bbb;
      --color-status-live: #000;

      display: block;
      max-width: none;
      padding: 0;
      font-size: 9.5pt;
      line-height: 1.4;
    }

    .cv :global(a:not([data-variant])) {
      text-decoration: none;
    }

    .cv-masthead {
      gap: 1mm;
      padding-bottom: 4mm;
    }

    .cv-name {
      font-size: 22pt;
    }

    .cv-role {
      margin-top: 0;
      font-size: 12pt;
    }

    .cv-contact-line {
      margin-top: 1mm;
      font-size: 9pt;
    }

    .cv-contact-line :global(a) {
      min-height: 0;
    }

    .cv-section {
      grid-template-columns: 30mm minmax(0, 1fr);
      gap: 5mm;
    }

    .cv > * + * {
      margin-top: 5mm;
    }

    .cv-heading {
      font-size: 8.5pt;
    }

    .cv-prose {
      gap: 1.5mm;
      max-width: none;
    }

    .cv-entry {
      gap: 1mm;
      padding-block: 2.5mm;
    }

    .cv-entry__title {
      font-size: 10.5pt;
    }

    .cv-entry__dates,
    .cv-stack,
    .cv-entry__client {
      font-size: 8.5pt;
    }

    .cv-products {
      margin-top: 2mm;
    }

    .cv-lead {
      display: none;
    }

    .cv-skills {
      gap: 0.5mm;
    }

    .cv-skills > div {
      grid-template-columns: 30mm minmax(0, 1fr);
    }
  }
</style>
