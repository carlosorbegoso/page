---
import Button from './Button.astro';
import { SITE } from '../../config/site';
import { useTranslations, withBase, type Locale } from '../../i18n/utils';

interface Props {
  locale: Locale;
  variant?: 'primary' | 'secondary' | 'ghost';
  size?: 'md' | 'lg';
  class?: string;
}

const { locale, variant = 'secondary', size = 'md', class: className } = Astro.props;
const t = useTranslations(locale);
---

<Button
  href={withBase(SITE.cvPath)}
  variant={variant}
  size={size}
  download
  type="application/pdf"
  class={className}
>
  <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" class="shrink-0 fill-none stroke-current" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <path d="M12 4v11M7 10l5 5 5-5M5 20h14"></path>
  </svg>
  {t('cv.download')}
  <span class="sr-only">({t('cv.format')})</span>
</Button>
