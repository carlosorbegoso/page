---
// Header component - Neural Command Hub
// Desktop: Floating orb that expands into a command palette
// Mobile: Bottom navigation bar
---

<!-- DESKTOP: Neural Command Hub (hidden on mobile) -->
<div class="cmd-hub" data-header>
    <!-- Scroll Progress Ring integrated into the orb -->
    <svg class="cmd-hub__progress" viewBox="0 0 52 52">
        <circle class="cmd-hub__progress-track" cx="26" cy="26" r="24" />
        <circle class="cmd-hub__progress-fill" cx="26" cy="26" r="24" data-header-progress />
    </svg>

    <!-- The Orb trigger -->
    <button class="cmd-hub__orb" id="cmd-hub-trigger" aria-label="Open navigation" aria-expanded="false">
        <span class="cmd-hub__orb-core"></span>
        <span class="cmd-hub__orb-ring"></span>
        <span class="cmd-hub__orb-glow"></span>
    </button>

    <!-- Command Palette (expands on click) -->
    <div class="cmd-palette" id="cmd-palette" aria-hidden="true">
        <div class="cmd-palette__backdrop"></div>
        <nav class="cmd-palette__nav">
            <a href="#hero" class="cmd-palette__link active" data-nav-link data-section="hero">
                <span class="cmd-palette__link-indicator"></span>
                <i class="fas fa-home cmd-palette__link-icon"></i>
                <span class="cmd-palette__link-text">Home</span>
                <kbd class="cmd-palette__shortcut">1</kbd>
            </a>
            <a href="#experience" class="cmd-palette__link" data-nav-link data-section="experience">
                <span class="cmd-palette__link-indicator"></span>
                <i class="fas fa-briefcase cmd-palette__link-icon"></i>
                <span class="cmd-palette__link-text">Experience</span>
                <kbd class="cmd-palette__shortcut">2</kbd>
            </a>
            <a href="#tech" class="cmd-palette__link" data-nav-link data-section="tech">
                <span class="cmd-palette__link-indicator"></span>
                <i class="fas fa-code cmd-palette__link-icon"></i>
                <span class="cmd-palette__link-text">Projects</span>
                <kbd class="cmd-palette__shortcut">3</kbd>
            </a>
            <a href="#contact" class="cmd-palette__link" data-nav-link data-section="contact">
                <span class="cmd-palette__link-indicator"></span>
                <i class="fas fa-envelope cmd-palette__link-icon"></i>
                <span class="cmd-palette__link-text">Contact</span>
                <kbd class="cmd-palette__shortcut">4</kbd>
            </a>

            <div class="cmd-palette__divider"></div>

            <!-- Controls row -->
            <div class="cmd-palette__controls">
                <button class="cmd-palette__ctrl-btn" id="theme-toggle" aria-label="Toggle theme" data-theme-toggle>
                    <i class="fas fa-sun theme-icon" id="weather-icon"></i>
                    <span class="cmd-palette__ctrl-label">Theme</span>
                    <span class="weather-temp" id="header-temp"></span>
                </button>
                <div class="cmd-palette__ctrl-btn cmd-palette__time" id="time-display" aria-label="Local time">
                    <i class="fas fa-clock"></i>
                    <span class="cmd-palette__ctrl-label" id="header-time">--:--</span>
                </div>
            </div>
        </nav>
    </div>
</div>

<!-- Section indicator (always visible on desktop, shows current section) -->
<div class="section-indicator" id="section-indicator">
    <span class="section-indicator__dot"></span>
    <span class="section-indicator__label" id="section-label">Home</span>
</div>

<!-- MOBILE BOTTOM NAVIGATION (hidden on desktop) -->
<nav class="mobile-bottom-nav" data-mobile-nav>
    <div class="mobile-nav-glow"></div>

    <a href="#hero" class="mobile-nav-item active" data-nav-section="hero">
        <div class="nav-item-indicator"></div>
        <i class="fas fa-home"></i>
        <span>Home</span>
    </a>

    <a href="#experience" class="mobile-nav-item" data-nav-section="experience">
        <div class="nav-item-indicator"></div>
        <i class="fas fa-briefcase"></i>
        <span>Work</span>
    </a>

    <a href="#tech" class="mobile-nav-item" data-nav-section="tech">
        <div class="nav-item-indicator"></div>
        <i class="fas fa-code"></i>
        <span>Tech</span>
    </a>

    <a href="#contact" class="mobile-nav-item" data-nav-section="contact">
        <div class="nav-item-indicator"></div>
        <i class="fas fa-envelope"></i>
        <span>Contact</span>
    </a>

    <button class="mobile-nav-item mobile-theme-btn" id="mobile-theme-toggle" aria-label="Toggle theme">
        <div class="nav-item-indicator"></div>
        <i class="fas fa-moon"></i>
        <span>Theme</span>
    </button>
</nav>

<script>
document.addEventListener('DOMContentLoaded', () => {
    // === Command Hub (Desktop) ===
    const hubTrigger = document.getElementById('cmd-hub-trigger');
    const palette = document.getElementById('cmd-palette');
    const paletteLinks = document.querySelectorAll('.cmd-palette__link');
    const sectionIndicator = document.getElementById('section-indicator');
    const sectionLabel = document.getElementById('section-label');
    const progressFill = document.querySelector('.cmd-hub__progress-fill');
    let isOpen = false;

    function openPalette() {
        isOpen = true;
        palette?.classList.add('open');
        palette?.setAttribute('aria-hidden', 'false');
        hubTrigger?.setAttribute('aria-expanded', 'true');
        hubTrigger?.classList.add('active');
    }

    function closePalette() {
        isOpen = false;
        palette?.classList.remove('open');
        palette?.setAttribute('aria-hidden', 'true');
        hubTrigger?.setAttribute('aria-expanded', 'false');
        hubTrigger?.classList.remove('active');
    }

    hubTrigger?.addEventListener('click', () => {
        isOpen ? closePalette() : openPalette();
    });

    // Close on outside click
    document.addEventListener('click', (e) => {
        if (isOpen && !e.target.closest('.cmd-hub')) {
            closePalette();
        }
    });

    // Navigate and close palette
    paletteLinks.forEach(link => {
        link.addEventListener('click', (e) => {
            e.preventDefault();
            const targetId = link.getAttribute('href')?.substring(1);
            const target = document.getElementById(targetId);
            if (target) {
                target.scrollIntoView({ behavior: 'smooth', block: 'start' });
            }
            closePalette();
        });
    });

    // Keyboard shortcuts (1-4 to navigate, Escape to close)
    document.addEventListener('keydown', (e) => {
        // Don't trigger if typing in an input
        if (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA') return;

        if (e.key === 'Escape' && isOpen) {
            closePalette();
            return;
        }

        // Number keys 1-4 for quick nav (only when palette is open)
        if (isOpen && e.key >= '1' && e.key <= '4') {
            const idx = parseInt(e.key) - 1;
            const link = paletteLinks[idx];
            if (link) {
                link.click();
            }
        }
    });

    // === Scroll tracking (shared between desktop & mobile) ===
    const sections = ['hero', 'experience', 'tech', 'contact'];
    const sectionNames = { hero: 'Home', experience: 'Experience', tech: 'Projects', contact: 'Contact' };
    const mobileNavItems = document.querySelectorAll('.mobile-nav-item[data-nav-section]');

    function updateActiveSection() {
        let currentSection = 'hero';
        const scrollY = window.scrollY + window.innerHeight / 3;

        sections.forEach(sectionId => {
            const section = document.getElementById(sectionId);
            if (section && section.offsetTop <= scrollY) {
                currentSection = sectionId;
            }
        });

        // Update desktop palette links
        paletteLinks.forEach(link => {
            link.classList.toggle('active', link.dataset.section === currentSection);
        });

        // Update section indicator
        if (sectionLabel) {
            sectionLabel.textContent = sectionNames[currentSection] || currentSection;
        }

        // Update mobile nav
        mobileNavItems.forEach(item => {
            item.classList.toggle('active', item.dataset.navSection === currentSection);
        });
    }

    // Scroll progress (ring around the orb)
    function updateScrollProgress() {
        const scrollTop = window.scrollY;
        const docHeight = document.documentElement.scrollHeight - window.innerHeight;
        const progress = docHeight > 0 ? scrollTop / docHeight : 0;

        if (progressFill) {
            const circumference = 2 * Math.PI * 24; // r=24
            const offset = circumference * (1 - progress);
            progressFill.style.strokeDashoffset = offset.toString();
        }
    }

    let ticking = false;
    window.addEventListener('scroll', () => {
        if (!ticking) {
            requestAnimationFrame(() => {
                updateActiveSection();
                updateScrollProgress();
                ticking = false;
            });
            ticking = true;
        }
    });

    // === Mobile theme sync ===
    const mobileThemeBtn = document.getElementById('mobile-theme-toggle');
    const desktopThemeBtn = document.getElementById('theme-toggle');

    if (mobileThemeBtn && desktopThemeBtn) {
        mobileThemeBtn.addEventListener('click', () => {
            desktopThemeBtn.click();
            const currentTheme = document.documentElement.getAttribute('data-theme');
            const icon = mobileThemeBtn.querySelector('i');
            if (icon) icon.className = currentTheme === 'light' ? 'fas fa-sun' : 'fas fa-moon';
        });
    }

    // Mobile smooth scroll
    mobileNavItems.forEach(item => {
        item.addEventListener('click', (e) => {
            e.preventDefault();
            const targetId = item.getAttribute('href')?.substring(1);
            const target = document.getElementById(targetId);
            if (target) {
                target.scrollIntoView({ behavior: 'smooth', block: 'start' });
            }
        });
    });

    // Initial state
    updateActiveSection();
    updateScrollProgress();
});
</script>
