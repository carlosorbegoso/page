---
import { Picture } from 'astro:assets';
import SectionHeader from '../ui/SectionHeader.astro';
import Tag from '../ui/Tag.astro';
import photo from '../../assets/profile.jpeg';
import { SECTION_IDS } from '../../config/site';
import { useTranslations, type Locale } from '../../i18n/utils';
import { getProfile } from '../../lib/content';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const profile = await getProfile(locale);

/* The last summary paragraph holds the CIBERTEC and Alura credentials, so it moves into the education list. */
const body = profile.summary.slice(0, -1);
const credentials = profile.summary.slice(-1);
const { degree, institution, status } = profile.education;
---

<section
  id={SECTION_IDS.about}
  aria-labelledby="about-title"
  data-station="about"
  class="flex min-h-svh flex-col items-center justify-center gap-stack px-gutter py-section"
>
  <div
    class="plate p-(--plate-padding)"
    data-plate
    data-plate-id="about-bio"
    data-plate-mode="surface-monitor"
    data-plate-order="0"
  >
    <div class="about-bio @container flex flex-col gap-6">
      <SectionHeader
        id="about-title"
        eyebrow={profile.location}
        title={t('about.title')}
        subtitle={t('about.subtitle')}
      />

      <div class="about-bio__row flex flex-col gap-5 @md:flex-row @md:items-start">
        <Picture
          src={photo}
          formats={['avif', 'webp']}
          widths={[192, 320, 480]}
          sizes="(min-width: 768px) 9rem, 7rem"
          alt={profile.photoAlt}
          loading="lazy"
          pictureAttributes={{ class: 'shrink-0' }}
          decoding="async"
          class="about-bio__photo aspect-square w-28 rounded-lg border border-border object-cover @md:w-36"
        />
        <div class="about-bio__text flex flex-col gap-4 text-base text-text-muted">
          {body.map(paragraph => <p class="text-pretty">{paragraph}</p>)}
        </div>
      </div>
    </div>
  </div>

  <div
    class="plate p-(--plate-padding)"
    data-plate
    data-plate-id="about-stack"
    data-plate-mode="surface-monitor"
    data-plate-order="1"
  >
    <div class="about-stack @container flex flex-col gap-6">
      <section aria-labelledby="about-education">
        <h3
          id="about-education"
          class="font-display text-xl font-semibold tracking-tight text-text"
        >
          {t('about.education')}
        </h3>
        <ul class="mt-4 flex flex-col gap-4 text-sm text-text-muted" data-kinetic-cascade>
          <li class="flex gap-3">
            <span class="mt-2 size-1.5 shrink-0 rounded-full bg-accent" aria-hidden="true"></span>
            <span>
              <span class="block font-medium text-text">{degree}</span>
              <span class="block">{institution}</span>
              <span class="block">{status}</span>
            </span>
          </li>
          {
            credentials.map(item => (
              <li class="flex gap-3">
                <span class="mt-2 size-1.5 shrink-0 rounded-full bg-accent" aria-hidden="true" />
                <span class="text-pretty">{item}</span>
              </li>
            ))
          }
        </ul>
      </section>

      <section aria-labelledby="about-stack" class="border-t border-border pt-6">
        <h3 id="about-stack" class="font-display text-xl font-semibold tracking-tight text-text">
          {t('about.stack')}
        </h3>
        <dl class="mt-4 grid gap-4 @md:grid-cols-2">
          {
            profile.stack.map(group => (
              <div>
                <dt class="text-xs font-semibold tracking-caps text-text-muted uppercase">
                  {group.category}
                </dt>
                <dd class="mt-2">
                  <ul class="flex flex-wrap gap-2" data-kinetic-cascade>
                    {group.items.map(item => (
                      <li>
                        <Tag>{item}</Tag>
                      </li>
                    ))}
                  </ul>
                </dd>
              </div>
            ))
          }
        </dl>
      </section>
    </div>
  </div>
</section>

<style>
  /* On the monitor each slide is a fixed-size screen: sizes are shares of its height so nothing clips. */
  :global(.is-3d) :is(.about-bio, .about-stack) {
    height: 100%;
    justify-content: center;
    gap: 4cqh;
  }

  :global(.is-3d) .about-bio :global(header) {
    gap: 1.2cqh;
  }

  :global(.is-3d) .about-bio :global(header > p:first-child) {
    font-size: 3.2cqh;
    line-height: 1.3;
  }

  :global(.is-3d) .about-bio :global(h2) {
    font-size: 9cqh;
    line-height: 1.05;
  }

  :global(.is-3d) .about-bio :global(header > p:last-child) {
    font-size: 4cqh;
    line-height: 1.3;
  }

  :global(.is-3d) .about-bio__row {
    flex-direction: row;
    align-items: flex-start;
    gap: 4cqw;
  }

  :global(.is-3d) .about-bio__photo {
    width: 30cqh;
  }

  :global(.is-3d) .about-bio__text {
    gap: 2cqh;
    font-size: 3.7cqh;
    line-height: 1.4;
  }

  :global(.is-3d) .about-stack {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
    align-content: center;
    gap: 0 5cqw;
  }

  :global(.is-3d) .about-stack h3 {
    font-size: 5.6cqh;
    line-height: 1.2;
  }

  :global(.is-3d) .about-stack ul,
  :global(.is-3d) .about-stack dl {
    margin-top: 2.5cqh;
  }

  :global(.is-3d) .about-stack > section:first-child ul {
    gap: 2.5cqh;
    font-size: 3.3cqh;
    line-height: 1.35;
  }

  :global(.is-3d) .about-stack > section:first-child li {
    gap: 2cqw;
  }

  :global(.is-3d) .about-stack > section:first-child li > span:first-child {
    width: 1.6cqh;
    height: 1.6cqh;
    margin-top: 1.6cqh;
  }

  :global(.is-3d) .about-stack > section + section {
    border-top: 0;
    padding-top: 0;
  }

  :global(.is-3d) .about-stack dl {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 3cqh 4cqw;
  }

  :global(.is-3d) .about-stack dt {
    font-size: 2.8cqh;
    line-height: 1.3;
  }

  :global(.is-3d) .about-stack dd {
    margin-top: 1cqh;
  }

  :global(.is-3d) .about-stack dd ul {
    margin-top: 0;
    gap: 0.6cqh 2.2cqw;
    font-size: 3.1cqh;
    line-height: 1.35;
  }

  :global(.is-3d) .about-stack :global([data-tone]) {
    min-height: 0;
    gap: 1cqw;
    font-size: inherit;
    line-height: inherit;
  }

  :global(.is-3d) .about-stack :global([data-tone] > span[aria-hidden]) {
    width: 1.2cqh;
    height: 1.2cqh;
  }
</style>
