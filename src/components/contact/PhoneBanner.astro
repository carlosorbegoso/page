---
import { useTranslations, type Locale } from '../../i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<div class="phone-banner" data-phone-banner aria-hidden="true" hidden>
  <span class="phone-banner-icon">
    <svg
      viewBox="0 0 24 24"
      width="18"
      height="18"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <rect x="3" y="5" width="18" height="14" rx="2"></rect>
      <path d="m3 7 9 6 9-6"></path>
    </svg>
  </span>
  <span class="phone-banner-text">
    <span class="phone-banner-meta">
      <span>{t('contactPhone.notifyApp')}</span>
      <span>{t('contactPhone.notifyNow')}</span>
    </span>
    <span class="phone-banner-title">{t('contactPhone.notifyTitle')}</span>
    <span class="phone-banner-body">{t('contactPhone.notifyBody')}</span>
  </span>
</div>

<style>
  .phone-banner {
    display: none;
  }

  :global(.is-3d [data-plate-mode='surface-phone']) .phone-banner:not([hidden]) {
    position: absolute;
    inset: 1.4cqh 4cqw auto;
    z-index: 7;
    display: flex;
    align-items: center;
    gap: 3cqw;
    padding: 1.5cqh 3.5cqw;
    border-radius: 2.8cqh;
    background: rgb(36 40 50 / 0.82);
    box-shadow: 0 1.2cqh 3cqh rgb(0 0 0 / 0.45);
    backdrop-filter: blur(12px) saturate(1.4);
    color: var(--color-text);
    cursor: pointer;
    opacity: 0;
    transform: translateY(-130%);
    transition:
      transform 420ms cubic-bezier(0.32, 0.72, 0, 1),
      opacity 220ms ease-out;
  }

  :global(.is-3d [data-plate-mode='surface-phone']) .phone-banner[data-shown] {
    opacity: 1;
    transform: none;
  }

  .phone-banner-icon {
    display: grid;
    flex-shrink: 0;
    place-items: center;
    width: 5.4cqh;
    height: 5.4cqh;
    border-radius: 1.4cqh;
    background: var(--color-accent);
    color: #fff;
  }

  .phone-banner-icon svg {
    width: 2.8cqh;
    height: 2.8cqh;
  }

  .phone-banner-text {
    display: flex;
    flex: 1;
    min-width: 0;
    flex-direction: column;
    line-height: 1.25;
  }

  .phone-banner-meta {
    display: flex;
    justify-content: space-between;
    font-size: 1.9cqh;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .phone-banner-title {
    font-size: 2.4cqh;
    font-weight: 600;
  }

  .phone-banner-body {
    font-size: 2.3cqh;
    color: var(--color-text-muted);
  }

  @media (prefers-reduced-motion: reduce) {
    .phone-banner {
      transform: none !important;
      transition-property: opacity, background-color !important;
    }
  }

  :global(:root[data-motion='paused']) .phone-banner {
    transform: none !important;
    transition-property: opacity, background-color !important;
  }
</style>
