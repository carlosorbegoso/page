---
import type { HTMLAttributes } from 'astro/types';
import { getLocale, useTranslations } from '../../i18n/utils';

type Variant = 'primary' | 'secondary' | 'ghost';
type Size = 'md' | 'lg';

interface Props extends Omit<HTMLAttributes<'a'>, 'href' | 'download' | 'type' | 'target'> {
  href?: string;
  variant?: Variant;
  size?: Size;
  external?: boolean;
  download?: boolean | string;
  disabled?: boolean;
  type?: 'button' | 'submit' | 'reset' | (string & {});
}

const {
  href,
  variant = 'primary',
  size = 'md',
  external = false,
  download,
  type,
  disabled,
  class: className,
  rel,
  ...attrs
} = Astro.props;

const t = useTranslations(getLocale(Astro.currentLocale, Astro.url));

const variants: Record<Variant, string> = {
  primary:
    'border-accent/55 bg-accent/10 text-text shadow-[0_0_28px_-10px_var(--color-accent)] hover:border-accent hover:bg-accent/15 hover:text-accent-hover hover:shadow-[0_0_36px_-6px_var(--color-accent)]',
  secondary: 'border-text/15 bg-transparent text-text hover:border-text/45 hover:text-accent-hover',
  ghost:
    'border-transparent bg-transparent text-text-muted underline decoration-accent/50 decoration-1 underline-offset-[6px] hover:text-text hover:decoration-accent'
};

const sizes: Record<Size, string> = {
  md: 'min-h-tap gap-2 px-5 text-sm',
  lg: 'min-h-12 gap-2.5 px-7 text-base'
};

const classes = [
  'inline-flex min-w-tap items-center justify-center rounded-pill border font-medium leading-tight select-none',
  'transition-[color,background-color,border-color,box-shadow,text-decoration-color] duration-(--duration-base) ease-standard',
  'focus-visible:shadow-focus focus-visible:outline-none',
  'disabled:pointer-events-none disabled:opacity-50',
  variants[variant],
  sizes[size],
  className
];

const linkRel = external ? ['noopener', 'noreferrer', rel].filter(Boolean).join(' ') : rel;
---

{
  href ? (
    <a
      href={href}
      class:list={classes}
      target={external ? '_blank' : undefined}
      rel={linkRel}
      download={download}
      type={type}
      data-magnetic
      data-variant={variant}
      {...attrs}
    >
      <span class="magnetic__inner" data-magnetic-inner><slot /></span>
      {external && <span class="sr-only">{t('link.newTab')}</span>}
    </a>
  ) : (
    <button
      type={(type ?? 'button') as 'button' | 'submit' | 'reset'}
      disabled={disabled}
      class:list={classes}
      data-magnetic
      data-variant={variant}
      {...(attrs as HTMLAttributes<'button'>)}
    >
      <span class="magnetic__inner" data-magnetic-inner><slot /></span>
    </button>
  )
}

<script>
  import '../../motion/magnetic';
</script>
