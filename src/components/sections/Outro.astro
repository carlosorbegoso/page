---
import ExternalLink from '../ui/ExternalLink.astro';
import { SITE } from '../../config/site';
import { useTranslations, type Locale } from '../../i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const year = new Date().getFullYear();
---

<section
  id="outro"
  aria-labelledby="outro-title"
  data-station="outro"
  class="outro relative flex min-h-svh flex-col items-center justify-center px-gutter py-section"
>
  <div
    class="plate p-(--plate-padding)"
    data-plate
    data-plate-id="outro"
    data-plate-mode="surface-monitor"
  >
    <div class="outro-screen flex max-w-measure flex-col gap-4">
      <p class="outro-label text-xs font-semibold tracking-caps text-accent uppercase">{t('outro.label')}</p>
      <h2 id="outro-title" class="font-display text-3xl font-semibold tracking-display text-balance text-text">
        {t('outro.title')}
      </h2>
      <p class="outro-body text-base text-pretty text-text-muted">{t('outro.body')}</p>
      <p class="outro-credits mt-1 flex flex-wrap items-baseline gap-x-3 gap-y-1.5 border-t border-text/10 pt-4 text-sm text-text-subtle">
        <span>{t('outro.tech')}</span>
        <ExternalLink
          href={SITE.social.github}
          locale={locale}
          class="underline decoration-accent/50 underline-offset-4 hover:text-text"
        >
          {t('outro.source')}
        </ExternalLink>
        <span class="outro-credits__break">© {year} {SITE.name} · TUSOCIO IA S.A.C.</span>
      </p>
    </div>
  </div>
</section>

<style>
  /* Credits read as two short lines: how it was made, and who signs it. */
  .outro-credits > :not(:first-child)::before {
    content: '·';
    margin-right: 0.75rem;
    color: var(--color-border-strong);
  }

  .outro-credits__break {
    flex-basis: 100%;
  }

  .outro-credits > .outro-credits__break::before {
    content: none;
  }

  /* The closing credits roll on the monitor, like the opening titles: sizes are shares of the screen. */
  :global(.is-3d) .outro-screen {
    height: 100%;
    max-width: none;
    justify-content: center;
    gap: 0;
  }

  :global(.is-3d) .outro-label {
    font-size: 3cqh;
    letter-spacing: var(--tracking-caps);
    color: var(--color-text-muted);
  }

  :global(.is-3d) .outro h2 {
    max-width: 80%;
    margin-top: 3cqh;
    font-size: 11cqh;
    line-height: 1.02;
    text-wrap: balance;
  }

  :global(.is-3d) .outro-body {
    max-width: 70%;
    margin-top: 4cqh;
    font-size: 3.9cqh;
    line-height: 1.45;
  }

  :global(.is-3d) .outro-credits {
    margin-top: 6cqh;
    padding-top: 4cqh;
    font-size: 3.4cqh;
    gap: 1.6cqh 2.4cqw;
  }

  @container surface (orientation: portrait) {
    :global(.is-3d) .outro h2 {
      max-width: none;
      font-size: 6.2cqh;
    }

    :global(.is-3d) .outro-label {
      font-size: 2.1cqh;
    }

    :global(.is-3d) .outro-body {
      max-width: none;
      font-size: 2.6cqh;
    }

    :global(.is-3d) .outro-credits {
      font-size: 2.3cqh;
    }
  }

  /* Without 3D the HTML footer already closes the page; the credits only make sense as the closing shot. */
  :global(html:not(.is-3d)) .outro {
    display: none;
  }
</style>
