---
import LangSwitch from './LangSwitch.astro';
import MotionToggle from './MotionToggle.astro';
import TimeToggle from './TimeToggle.astro';
import AudioToggle from './AudioToggle.astro';
import CopyEmail from './contact/CopyEmail.astro';
import CvLink from './ui/CvLink.astro';
import { SECTION_IDS, SITE } from '../config/site';
import { localeUrl, useTranslations, withBase, type Locale } from '../i18n/utils';
import { getExperience } from '../lib/content';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const readingUrl = localeUrl(locale, locale === 'es' ? 'lectura' : 'reading');
const years = (await getExperience(locale)).map(entry => entry.start.slice(0, 4)).toSorted();
const tonight = (time: string) => `${time} · ${t('story.tonight')}`;
const night = (time: string) => `${time} · ${t('story.night')}`;
/** What the HUD shows per chapter and sub-shot: the clock tonight, the year during the day years. */
const storyBeats: Record<string, string[]> = {
  hero: [tonight('23:00')],
  about: [tonight('23:20'), tonight('23:30')],
  experience: [`${t('story.day')} · ${years[0]} →`, ...years.map(year => `${t('story.day')} · ${year}`)],
  company: [night('00:30')],
  products: [night('01:30'), night('02:00'), night('02:30')],
  contact: [night('03:30')],
  outro: [`05:58 · ${t('story.dawn')}`]
};
const today = (time: string) => `${time} · ${t('story.today')}`;
const afterWork = (time: string) => `${time} · ${t('story.afterWork')}`;
/** By day the same walk runs from a morning at the office to nightfall, when the lamp comes on. */
const storyBeatsDay: Record<string, string[]> = {
  ...storyBeats,
  hero: [today('10:00')],
  about: [today('10:20'), today('10:40')],
  company: [afterWork('18:10')],
  products: [afterWork('18:20'), afterWork('18:30'), afterWork('18:40')],
  contact: [`18:50 · ${t('story.dusk')}`],
  outro: [`19:05 · ${t('story.nightfall')}`]
};
const sections = [
  { id: SECTION_IDS.hero, label: t('nav.hero') },
  { id: SECTION_IDS.about, label: t('nav.about') },
  { id: SECTION_IDS.experience, label: t('nav.experience') },
  { id: SECTION_IDS.company, label: t('nav.company') },
  { id: SECTION_IDS.products, label: t('nav.products') },
  { id: SECTION_IDS.contact, label: t('nav.contact') }
];
const menuItem =
  'flex min-h-tap w-full items-center gap-3 rounded-md px-3 text-xs font-medium tracking-caps text-text-muted uppercase transition-colors duration-(--duration-fast) ease-standard hover:bg-surface hover:text-text focus-visible:shadow-focus focus-visible:outline-none';
---

<div
  data-hud
  class="fixed top-[max(0.5rem,env(safe-area-inset-top))] left-[max(0.5rem,env(safe-area-inset-left))] z-(--z-header) md:top-4 md:left-4"
>
  <div class="flex items-center gap-1">
    <button
      type="button"
      data-hud-toggle
      aria-expanded="false"
      aria-controls="hud-menu"
      aria-label={t('hud.label')}
      aria-describedby="hud-audio-hint"
      class="group hud-control hud-icon"
    >
      <span
        aria-hidden="true"
        class="absolute top-2 right-2 hidden size-1.5 rounded-full bg-accent shadow-[0_0_6px_var(--color-accent)] group-data-[audio-hint]:block"
      ></span>
      <svg viewBox="0 0 64 64" width="22" height="22" aria-hidden="true">
        <path
          d="M43.5 22.4A15 15 0 1 0 43.5 41.6"
          fill="none"
          class="stroke-text"
          stroke-width="7"
        ></path>
        <circle cx="47" cy="32" r="4.5" class="fill-accent"></circle>
      </svg>
    </button>
    <span
      id="hud-audio-hint"
      data-hud-audio-hint
      data-label={t('audio.available')}
      class="sr-only"
      aria-live="polite"
    ></span>
    <div class="relative">
      <button
        type="button"
        data-hud-clock
        hidden
        aria-haspopup="dialog"
        aria-controls="section-index"
        aria-expanded="false"
        class="group/clock inline-flex min-h-tap items-center rounded-md px-2 focus-visible:shadow-focus focus-visible:outline-none"
      >
        <span
          data-hud-chapter
          data-story-beats={JSON.stringify(storyBeats)}
          data-story-beats-day={JSON.stringify(storyBeatsDay)}
          class="hud-beat font-mono text-xs tracking-caps text-text-muted tabular-nums opacity-0 transition-[opacity,color] duration-(--duration-base) ease-standard group-hover/clock:text-text data-[ready=true]:opacity-100"
        ></span>
        <span class="sr-only">· {t('story.openIndex')}</span>
      </button>
      <span
        data-hud-progress
        hidden
        role="progressbar"
        aria-label={t('story.progress')}
        aria-valuemin="0"
        aria-valuemax="100"
        aria-valuenow="0"
        data-value-template={t('story.progressValue')}
        class="hud-progress pointer-events-none absolute inset-x-2 bottom-2 h-0.5 overflow-hidden rounded-full"
      >
        <span data-hud-progress-fill class="hud-progress__fill block h-full bg-accent"></span>
      </span>
    </div>
    <button
      type="button"
      data-story-tour-quick
      hidden
      aria-pressed="false"
      aria-label={t('tour.start')}
      title={t('tour.start')}
      class="group/quick hud-control hud-icon"
    >
      <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true" class="shrink-0 fill-current">
        <path d="M8 5.5v13l10.5-6.5z" class="group-aria-pressed/quick:hidden"></path>
        <path d="M7 6h3.5v12H7zM13.5 6H17v12h-3.5z" class="hidden group-aria-pressed/quick:block"></path>
      </svg>
    </button>
    <span
      data-hud-tour-badge
      data-label-playing={t('tour.badgePlaying')}
      data-label-paused={t('tour.badgePaused')}
      aria-hidden="true"
      hidden
      class="hud-beat inline-flex items-center gap-1.5 font-mono text-xs tracking-caps text-text-muted"
    >
      <span
        data-hud-tour-dot
        class="size-1.5 rounded-full bg-text-muted data-[state=playing]:bg-accent"
      ></span>
      <span data-hud-tour-text></span>
    </span>
    <span
      data-story-tour-status
      data-label-playing={t('tour.playing')}
      data-label-paused={t('tour.paused')}
      data-label-finished={t('tour.finished')}
      class="sr-only"
      aria-live="polite"
    ></span>
  </div>

  <div
    id="hud-menu"
    data-hud-menu
    hidden
    class="hud-menu mt-1 flex w-60 flex-col gap-1 rounded-lg border border-border bg-scrim p-2 shadow-lg backdrop-blur-md"
  >
    <div class="flex items-center gap-1 border-b border-border pb-2">
      <LangSwitch locale={locale} compact hud />
      <AudioToggle locale={locale} />
      <MotionToggle locale={locale} floating />
      <TimeToggle locale={locale} />
    </div>
    <button
      type="button"
      data-index-open
      aria-expanded="false"
      aria-controls="section-index"
      aria-haspopup="dialog"
      class={menuItem}
    >
      <svg
        viewBox="0 0 24 24"
        width="16"
        height="16"
        aria-hidden="true"
        class="shrink-0 fill-none stroke-current"
        stroke-width="2"
        stroke-linecap="round"
      >
        <path d="M4 7h16M4 12h16M4 17h10"></path>
      </svg>
      {t('nav.index')}
    </button>
    <button
      type="button"
      data-story-tour
      hidden
      aria-pressed="false"
      class:list={[menuItem, 'group/tour aria-pressed:text-text']}
    >
      <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" class="shrink-0 fill-current">
        <path d="M8 5.5v13l10.5-6.5z" class="group-aria-pressed/tour:hidden"></path>
        <path d="M7 6h3.5v12H7zM13.5 6H17v12h-3.5z" class="hidden group-aria-pressed/tour:block"
        ></path>
      </svg>
      {t('tour.start')}
    </button>
    <a href={readingUrl} class={menuItem}>
      <svg
        viewBox="0 0 24 24"
        width="16"
        height="16"
        aria-hidden="true"
        class="shrink-0 fill-none stroke-current"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="M4 5h6a2 2 0 0 1 2 2v12a2 2 0 0 0-2-2H4zM20 5h-6a2 2 0 0 0-2 2v12a2 2 0 0 1 2-2h6z"></path>
      </svg>
      {t('reading.enter')}
    </a>
    <a href={withBase(SITE.cvPath)} download type="application/pdf" class={menuItem}>
      <svg
        viewBox="0 0 24 24"
        width="16"
        height="16"
        aria-hidden="true"
        class="shrink-0 fill-none stroke-current"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="M12 4v11M7 10l5 5 5-5M5 20h14"></path>
      </svg>
      {t('cv.download')}
      <span class="sr-only">({t('cv.format')})</span>
    </a>
  </div>
</div>

<dialog
  id="section-index"
  data-index
  aria-labelledby="section-index-title"
  class:list={[
    'index-sheet m-0 w-full max-w-none overflow-y-auto border border-border bg-surface-raised p-0 text-text shadow-lg backdrop:bg-scrim',
    'fixed inset-x-0 top-auto bottom-0 max-h-[85dvh] rounded-t-xl border-b-0',
    'md:inset-y-0 md:right-0 md:left-auto md:h-dvh md:max-h-none md:w-[24rem] md:rounded-none md:rounded-l-xl md:border-e-0 md:border-b'
  ]}
>
  <div class="flex min-h-full flex-col gap-5 px-gutter pt-3 pb-[max(1.25rem,env(safe-area-inset-bottom))] md:px-6 md:pt-6">
    <span
      class="mx-auto h-1 w-10 rounded-full bg-border-strong md:hidden"
      aria-hidden="true"
    ></span>
    <div class="flex items-center justify-between gap-3">
      <h2 id="section-index-title" class="font-display text-xl font-semibold tracking-tight">
        {t('nav.index')}
      </h2>
      <button
        type="button"
        data-index-close
        aria-label={t('nav.closeIndex')}
        class="inline-flex size-tap items-center justify-center rounded-md border border-border text-text transition-colors duration-(--duration-fast) ease-standard hover:bg-surface focus-visible:shadow-focus focus-visible:outline-none"
      >
        <svg
          viewBox="0 0 24 24"
          width="22"
          height="22"
          aria-hidden="true"
          class="fill-none stroke-current"
          stroke-width="2"
          stroke-linecap="round"
        >
          <path d="M6 6l12 12M18 6 6 18"></path>
        </svg>
      </button>
    </div>

    <nav aria-label={t('nav.label')}>
      <ol class="flex flex-col gap-1">
        {sections.map((section, index) => (
          <li>
            <a
              href={`#${section.id}`}
              data-index-link={section.id}
              class:list={[
                'group flex min-h-12 items-center gap-3 rounded-md border-s-2 border-transparent px-4 text-base font-medium text-text-muted',
                'transition-colors duration-(--duration-fast) ease-standard hover:bg-surface hover:text-text',
                'focus-visible:shadow-focus focus-visible:outline-none',
                'aria-[current=true]:border-accent aria-[current=true]:bg-accent-soft aria-[current=true]:text-text'
              ]}
            >
              <span
                class="font-mono text-xs text-text-subtle tabular-nums group-aria-[current=true]:text-accent"
                aria-hidden="true"
              >
                {String(index + 1).padStart(2, '0')}
              </span>
              {section.label}
            </a>
          </li>
        ))}
      </ol>
    </nav>

    <section
      aria-labelledby="index-actions"
      class="mt-auto flex flex-col gap-3 border-t border-border pt-5"
    >
      <h3
        id="index-actions"
        class="font-sans text-xs font-semibold tracking-caps text-text-muted uppercase"
      >
        {t('nav.quickActions')}
      </h3>
      <CopyEmail locale={locale} email={SITE.email} />
      <CvLink locale={locale} size="lg" class="w-full" />
    </section>
  </div>
</dialog>

<style>
  /* The story clock sits over bright windows at dawn: a halo keeps it legible on any frame. */
  .hud-beat {
    text-shadow: var(--plate-text-halo);
  }

  .hud-progress {
    background-color: color-mix(in srgb, var(--color-text-muted) 25%, transparent);
  }

  .hud-progress__fill {
    transform: scaleX(var(--story-progress, 0));
    transform-origin: left center;
  }

  @media (forced-colors: active) {
    .hud-progress {
      background-color: GrayText;
    }

    .hud-progress__fill {
      background-color: Highlight;
    }
  }

  .hud-menu {
    transform-origin: top left;
    transition:
      opacity var(--duration-base) var(--ease-out),
      translate var(--duration-base) var(--ease-out);

    @starting-style {
      opacity: 0;
      translate: 0 -0.25rem;
    }
  }

  .index-sheet {
    --sheet-offset: translateY(100%);
    transform: var(--sheet-offset);
    transition:
      transform var(--duration-slow) var(--ease-out),
      overlay var(--duration-slow) allow-discrete,
      display var(--duration-slow) allow-discrete;
  }

  @media (width >= 48rem) {
    .index-sheet {
      --sheet-offset: translateX(100%);
    }
  }

  .index-sheet[open] {
    transform: none;

    @starting-style {
      transform: var(--sheet-offset);
    }
  }

  .index-sheet::backdrop {
    opacity: 0;
    transition:
      opacity var(--duration-slow) var(--ease-out),
      overlay var(--duration-slow) allow-discrete,
      display var(--duration-slow) allow-discrete;
  }

  .index-sheet[open]::backdrop {
    opacity: 1;

    @starting-style {
      opacity: 0;
    }
  }

  :global(html:has(.index-sheet[open])) {
    overflow: hidden;
  }
</style>

<script>
  const STATION_SELECTOR = '[data-station]';
  const hud = document.querySelector<HTMLElement>('[data-hud]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-hud-toggle]');
  const menu = document.querySelector<HTMLElement>('[data-hud-menu]');
  const chapter = document.querySelector<HTMLElement>('[data-hud-chapter]');
  const sheet = document.querySelector<HTMLDialogElement>('[data-index]');
  const indexButton = document.querySelector<HTMLButtonElement>('[data-index-open]');
  const clock = document.querySelector<HTMLButtonElement>('[data-hud-clock]');
  const tourButton = document.querySelector<HTMLButtonElement>('[data-story-tour]');
  const quickTour = document.querySelector<HTMLButtonElement>('[data-story-tour-quick]');
  quickTour?.addEventListener('click', event => {
    event.stopPropagation();
    const starting = quickTour.getAttribute('aria-pressed') !== 'true';
    window.dispatchEvent(new CustomEvent('story:tour', { detail: { action: starting ? 'start' : 'stop' } }));
  });
  window.addEventListener('story:tour-state', event => {
    const state = (event as CustomEvent<{ state?: string }>).detail?.state;
    quickTour?.setAttribute('aria-pressed', String(state === 'playing'));
  });
  let indexOpener: HTMLButtonElement | null = null;
  const finePointer = matchMedia('(hover: hover) and (pointer: fine)');
  const HOVER_CLOSE_DELAY_MS = 250;

  if (hud && toggle && menu) {
    let closeTimer: number | undefined;

    const isOpen = () => !menu.hidden;

    function setOpen(open: boolean, { restoreFocus = false } = {}) {
      window.clearTimeout(closeTimer);
      if (open === isOpen()) return;
      menu!.hidden = !open;
      toggle!.setAttribute('aria-expanded', String(open));
      if (!open && restoreFocus) toggle!.focus();
    }

    let openedByHover = false;

    /* Hover already opened the menu on desktop: the click that follows must not close it again. */
    toggle.addEventListener('click', () => {
      if (openedByHover && isOpen()) {
        openedByHover = false;
        return;
      }
      setOpen(!isOpen());
    });

    hud.addEventListener('pointerenter', event => {
      if (event.pointerType !== 'mouse' || !finePointer.matches || isOpen()) return;
      openedByHover = true;
      setOpen(true);
    });
    hud.addEventListener('pointerleave', event => {
      if (event.pointerType !== 'mouse' || !finePointer.matches) return;
      openedByHover = false;
      if (hud.contains(document.activeElement)) (document.activeElement as HTMLElement).blur();
      closeTimer = window.setTimeout(() => setOpen(false), HOVER_CLOSE_DELAY_MS);
    });

    hud.addEventListener('keydown', event => {
      if (event.key === 'Escape' && isOpen()) {
        event.stopPropagation();
        setOpen(false, { restoreFocus: true });
      }
    });

    hud.addEventListener('focusout', event => {
      const next = event.relatedTarget;
      if (next instanceof Node && hud.contains(next)) return;
      if (sheet?.open) return;
      setOpen(false);
    });

    document.addEventListener('pointerdown', event => {
      if (isOpen() && event.target instanceof Node && !hud.contains(event.target)) setOpen(false);
    });

    for (const opener of [indexButton, clock]) {
      opener?.addEventListener('click', () => {
        if (!sheet) return;
        setOpen(false);
        indexOpener = opener === clock ? clock : null;
        sheet.showModal();
        opener.setAttribute('aria-expanded', 'true');
      });
    }

    tourButton?.addEventListener('click', () => {
      const starting = tourButton.getAttribute('aria-pressed') !== 'true';
      window.dispatchEvent(new CustomEvent('story:tour', { detail: { action: starting ? 'start' : 'stop' } }));
      if (starting) setOpen(false, { restoreFocus: true });
    });
  }

  const progressBar = document.querySelector<HTMLElement>('[data-hud-progress]');
  const tourBadge = document.querySelector<HTMLElement>('[data-hud-tour-badge]');
  const tourStatus = document.querySelector<HTMLElement>('[data-story-tour-status]');
  const TOUR_BADGE_PAUSED_MS = 4000;

  function setStoryNav(ready: boolean) {
    if (progressBar) progressBar.hidden = !ready;
    if (tourButton) tourButton.hidden = !ready;
    if (quickTour) quickTour.hidden = !ready;
  }

  window.addEventListener('story:ready', () => setStoryNav(true));
  window.addEventListener('story:disposed', () => setStoryNav(false));
  setStoryNav(document.documentElement.dataset.storyNav === 'ready');

  if (progressBar) {
    const fill = progressBar.querySelector<HTMLElement>('[data-hud-progress-fill]');
    const template = progressBar.dataset.valueTemplate ?? '{current} / {total}';
    let percent = -1;
    let shot = '';
    window.addEventListener('story:progress', event => {
      const { value, index, total } = (event as CustomEvent<{ value: number; index: number; total: number }>).detail;
      fill?.style.setProperty('--story-progress', value.toFixed(4));
      const nextPercent = Math.round(value * 100);
      if (nextPercent !== percent) {
        percent = nextPercent;
        progressBar.setAttribute('aria-valuenow', String(percent));
      }
      const nextShot = template.replace('{current}', String(index + 1)).replace('{total}', String(total));
      if (nextShot !== shot) {
        shot = nextShot;
        progressBar.setAttribute('aria-valuetext', shot);
      }
    });
  }

  let badgeTimer: number | undefined;
  window.addEventListener('story:tour-state', event => {
    const { state } = (event as CustomEvent<{ state: 'playing' | 'paused' | 'finished' }>).detail;
    const playing = state === 'playing';
    tourButton?.setAttribute('aria-pressed', String(playing));
    if (tourStatus) {
      const key = `label${state[0]!.toUpperCase()}${state.slice(1)}`;
      tourStatus.textContent = tourStatus.dataset[key] ?? '';
    }
    if (!tourBadge) return;
    window.clearTimeout(badgeTimer);
    const dot = tourBadge.querySelector<HTMLElement>('[data-hud-tour-dot]');
    const text = tourBadge.querySelector<HTMLElement>('[data-hud-tour-text]');
    if (dot) dot.dataset.state = state;
    if (text) text.textContent = (playing ? tourBadge.dataset.labelPlaying : tourBadge.dataset.labelPaused) ?? '';
    tourBadge.hidden = state === 'finished';
    if (!playing) badgeTimer = window.setTimeout(() => (tourBadge.hidden = true), TOUR_BADGE_PAUSED_MS);
  });

  const audioHint = document.querySelector<HTMLElement>('[data-hud-audio-hint]');
  const audioToggle = document.querySelector<HTMLButtonElement>('[data-audio-toggle]');
  const INVITE_HINT_MS = 10_000;

  if (toggle && audioHint) {
    let inviteTimer: number | undefined;
    let invited = false;

    const renderHint = () => {
      const armed = audioToggle?.dataset.state === 'armed';
      const show = armed || invited;
      if (show) toggle.dataset.audioHint = '';
      else delete toggle.dataset.audioHint;
      audioHint.textContent = show ? (audioHint.dataset.label ?? '') : '';
    };

    window.addEventListener('audio:invite', () => {
      invited = true;
      renderHint();
      window.clearTimeout(inviteTimer);
      inviteTimer = window.setTimeout(() => {
        invited = false;
        renderHint();
      }, INVITE_HINT_MS);
    });

    if (audioToggle) {
      new MutationObserver(() => {
        if (audioToggle.dataset.state === 'on') invited = false;
        renderHint();
      }).observe(audioToggle, { attributes: true, attributeFilter: ['data-state'] });
    }

    renderHint();
  }

  if (sheet) {
    sheet.addEventListener('close', () => {
      indexButton?.setAttribute('aria-expanded', 'false');
      clock?.setAttribute('aria-expanded', 'false');
      (indexOpener ?? toggle)?.focus();
      indexOpener = null;
    });
    sheet.querySelector('[data-index-close]')?.addEventListener('click', () => sheet.close());
    sheet.addEventListener('click', event => {
      if (event.target === sheet) sheet.close();
    });
    for (const link of sheet.querySelectorAll('[data-index-link]')) {
      link.addEventListener('click', () => sheet.close());
    }
  }

  const indexLinks = [...document.querySelectorAll<HTMLAnchorElement>('[data-index-link]')];
  const stations = [...document.querySelectorAll<HTMLElement>(STATION_SELECTOR)];
  const nightBeats = JSON.parse(chapter?.dataset.storyBeats ?? '{}') as Record<string, string[]>;
  const dayBeats = JSON.parse(chapter?.dataset.storyBeatsDay ?? '{}') as Record<string, string[]>;
  let activeId: string | null = null;
  let activeSub = 0;

  function showBeat(id: string, sub: number) {
    activeSub = sub;
    const beats = (document.documentElement.dataset.time === 'day' ? dayBeats : nightBeats)[id];
    if (!chapter || !beats?.length) return;
    chapter.textContent = beats[Math.min(Math.max(sub, 0), beats.length - 1)]!;
    chapter.dataset.ready = 'true';
    if (clock) clock.hidden = false;
  }

  function setActive(id: string | null, sub?: number) {
    if (!id || (id === activeId && sub === undefined)) return;
    showBeat(id, sub ?? 0);
    if (id === activeId) return;
    activeId = id;
    for (const link of indexLinks) {
      if (link.dataset.indexLink === id) link.setAttribute('aria-current', 'true');
      else link.removeAttribute('aria-current');
    }
    window.dispatchEvent(new CustomEvent('section:active', { detail: { id } }));
  }

  window.addEventListener('time:toggle', () => {
    if (activeId) showBeat(activeId, activeSub);
  });

  for (const type of ['station:enter', 'chapter:enter']) {
    window.addEventListener(type, event => {
      const detail = (event as CustomEvent<{ id?: string; subIndex?: number }>).detail;
      setActive(detail?.id ?? null, detail?.subIndex);
    });
  }

  if ('IntersectionObserver' in window && stations.length > 0) {
    const visible = new Set<HTMLElement>();
    const observer = new IntersectionObserver(
      entries => {
        for (const entry of entries) {
          const target = entry.target as HTMLElement;
          if (entry.isIntersecting) visible.add(target);
          else visible.delete(target);
        }
        const current = stations.find(station => visible.has(station));
        if (current) setActive(current.dataset.station ?? current.id);
      },
      { rootMargin: '-45% 0px -50% 0px' }
    );
    for (const station of stations) observer.observe(station);
  }
</script>
