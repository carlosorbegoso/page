---
import HudBar from './hud/HudBar.astro';
import HudMenu from './hud/HudMenu.astro';
import IndexSheet from './hud/IndexSheet.astro';
import type { Locale } from '../i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<div
  data-hud
  class="fixed top-[max(0.5rem,env(safe-area-inset-top))] left-[max(0.5rem,env(safe-area-inset-left))] z-(--z-header) md:top-4 md:left-4"
>
  <HudBar locale={locale} />

  <HudMenu locale={locale} />
</div>

<IndexSheet locale={locale} />

<script>
  import './hud/main';
</script>
