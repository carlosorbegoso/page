---
import Tag from '../../ui/Tag.astro';
import AboutCode from './AboutCode.astro';
import { useTranslations, type Locale } from '../../../i18n/utils';
import { getProfile } from '../../../lib/content';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const profile = await getProfile(locale);
const credentials = profile.summary.slice(-2);
const { degree, institution, status } = profile.education;
---

<div class="about-stack @container flex flex-col gap-6">
  <AboutCode locale={locale} />
  <section aria-labelledby="about-education">
    <h3
      id="about-education"
      class="font-display text-xl font-semibold tracking-tight text-text"
    >
      {t('about.education')}
    </h3>
    <ul class="mt-4 flex flex-col gap-4 text-sm text-text-muted" data-kinetic-cascade>
      <li class="flex gap-3">
        <span class="mt-2 size-1.5 shrink-0 rounded-full bg-accent" aria-hidden="true"></span>
        <span>
          <span class="block font-medium text-text">{degree}</span>
          <span class="block">{institution}</span>
          <span class="block">{status}</span>
        </span>
      </li>
      {
        credentials.map(item => (
          <li class="flex gap-3">
            <span class="mt-2 size-1.5 shrink-0 rounded-full bg-accent" aria-hidden="true" />
            <span class="text-pretty">{item}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <section aria-labelledby="about-stack" class="border-t border-border pt-6">
    <h3 id="about-stack" class="font-display text-xl font-semibold tracking-tight text-text">
      {t('about.stack')}
    </h3>
    <dl class="mt-4 grid gap-4 @md:grid-cols-2">
      {
        profile.stack.map(group => (
          <div>
            <dt class="text-sm font-medium text-text-muted">
              {group.category}
            </dt>
            <dd class="mt-2">
              <ul class="flex flex-wrap gap-2" data-kinetic-cascade>
                {group.items.map(item => (
                  <li>
                    <Tag>{item}</Tag>
                  </li>
                ))}
              </ul>
            </dd>
          </div>
        ))
      }
    </dl>
  </section>
</div>
