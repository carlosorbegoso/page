---
import ExternalLink from './ui/ExternalLink.astro';
import { SITE } from '../config/site';
import { useTranslations, type Locale } from '../i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const year = new Date().getFullYear();
const social = [
  { label: 'LinkedIn', href: SITE.social.linkedin },
  { label: 'GitHub', href: SITE.social.github },
  { label: 'X', href: SITE.social.x }
];
const linkClass =
  'inline-flex min-h-tap items-center rounded-md px-3 text-sm font-medium text-text-muted transition-colors duration-(--duration-fast) ease-standard hover:bg-surface hover:text-text focus-visible:shadow-focus focus-visible:outline-none';
---

<footer class="relative z-(--z-content) border-t border-border bg-surface">
  <div class="container-content flex flex-col gap-6 py-10 md:flex-row md:items-center md:justify-between">
    <div class="flex flex-col gap-1">
      <p class="font-display text-base font-semibold text-text">{SITE.name}</p>
      <p class="text-sm text-text-muted">{t('footer.tagline')}</p>
    </div>

    <ul class="-mx-3 flex flex-wrap items-center gap-x-1 gap-y-2" aria-label={t('contact.social')}>
      <li>
        <a href={`mailto:${SITE.email}`} class={linkClass}>{t('contact.email')}</a>
      </li>
      {
        social.map(item => (
          <li>
            <ExternalLink href={item.href} locale={locale} class={linkClass}>
              {item.label}
            </ExternalLink>
          </li>
        ))
      }
    </ul>
  </div>

  <div class="container-content flex flex-col-reverse gap-3 border-t border-border pt-6 pb-[calc(var(--spacing-tap)+1rem)] sm:flex-row md:pb-6 sm:items-center sm:justify-between">
    <p class="text-xs text-text-muted">
      © {year} {SITE.name} · TUSOCIO IA S.A.C. {t('footer.rights')}
    </p>
    <a href="#main" class:list={[linkClass, '-mx-3 self-start sm:self-auto']}>
      {t('footer.backToTop')}
      <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" class="ms-1.5 fill-none stroke-current" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 19V5M6 11l6-6 6 6"></path>
      </svg>
    </a>
  </div>
</footer>
