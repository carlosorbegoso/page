---
import Base from '../../../layouts/Base.astro';
import ReadingBar from '../../ReadingBar.astro';
import Footer from '../../Footer.astro';
import ReadingBackground from './ReadingBackground.astro';
import ReadingCompany from './ReadingCompany.astro';
import ReadingContact from './ReadingContact.astro';
import ReadingExperience from './ReadingExperience.astro';
import ReadingMasthead from './ReadingMasthead.astro';
import { localeUrl, useTranslations, type Locale } from '../../../i18n/utils';
import { getExperience, getProducts, getProfile } from '../../../lib/content';
import '../../../styles/sections/reading/masthead.css';
import '../../../styles/sections/reading/sections.css';
import '../../../styles/sections/reading/print.css';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const profile = await getProfile(locale);
const experience = [...(await getExperience(locale))].sort((a, b) => b.start.localeCompare(a.start));
const products = await getProducts(locale);

/* Same split as About.astro: the last two summary paragraphs are the CIBERTEC and Alura credentials. */
const summary = profile.summary.slice(0, -2);
const credentials = profile.summary.slice(-2);

const readingPaths: Record<Locale, string> = {
  es: localeUrl('es', 'lectura'),
  en: localeUrl('en', 'reading')
};
---

<Base
  locale={locale}
  title={t('reading.metaTitle')}
  description={t('reading.description')}
  alternates={readingPaths}
  colorScheme="dark light"
>
  <script is:inline slot="head">
    document.documentElement.dataset.motion = 'paused';
    if (matchMedia('(prefers-color-scheme: light)').matches) document.documentElement.dataset.theme = 'light';
  </script>
  <ReadingBar locale={locale} />
  <main id="main" tabindex="-1" class="cv container-content">
    <ReadingMasthead locale={locale} profile={profile} />

    <section class="cv-section" aria-labelledby="cv-profile">
      <h2 id="cv-profile" class="cv-heading">{t('reading.profile')}</h2>
      <div class="cv-body cv-prose">
        {summary.map(paragraph => <p>{paragraph}</p>)}
      </div>
    </section>

    <ReadingExperience locale={locale} experience={experience} />
    <ReadingCompany locale={locale} company={profile.company} products={products} />
    <ReadingBackground locale={locale} profile={profile} credentials={credentials} />
    <ReadingContact locale={locale} />
  </main>
  <Footer locale={locale} />
</Base>

<script>
  import { wirePrintButtons } from '../../../scripts/reading/print';

  wirePrintButtons();
</script>
