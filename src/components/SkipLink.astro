---
interface Props {
  label: string;
}
const { label } = Astro.props;
---

<a
  href="#main"
  class="sr-only rounded-md bg-surface-raised px-4 font-medium text-text shadow-focus focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-(--z-skip) focus:inline-flex focus:min-h-tap focus:items-center"
>
  {label}
</a>
