---
import SectionHeader from '../ui/SectionHeader.astro';
import TimelineItem from '../experience/TimelineItem.astro';
import { SECTION_IDS } from '../../config/site';
import { useTranslations, type Locale } from '../../i18n/utils';
import { getExperience } from '../../lib/content';

interface Props {
  locale: Locale;
  /** `story` tells the career from the first job (the 3D walk); `newest` leads with today (reading mode). */
  order?: 'story' | 'newest';
}

const { locale, order = 'story' } = Astro.props;
const t = useTranslations(locale);
const entries = await getExperience(locale);
const sorted = entries.toSorted((a, b) => (order === 'story' ? a.start.localeCompare(b.start) : b.start.localeCompare(a.start)));
const firstYear = entries.map(entry => entry.start).toSorted()[0]?.slice(0, 4);
---

<section
  id={SECTION_IDS.experience}
  aria-labelledby="experience-title"
  data-station="experience"
  data-experience-station
  class="relative flex min-h-svh flex-col items-center gap-stack px-gutter py-section"
>
  <div
    class="plate p-(--plate-padding)"
    data-plate
    data-plate-id="exp-intro"
    data-plate-mode="anchored"
    data-plate-anchor="exp-intro"
  >
    <SectionHeader
      id="experience-title"
      eyebrow={firstYear ? `${firstYear} – ${t('experience.present')}` : undefined}
      act={t('story.day')}
      title={t('experience.title')}
      subtitle={t('experience.subtitle')}
      class="experience-header"
    />
  </div>
  {sorted.map((entry, index) => <TimelineItem locale={locale} order={index} {...entry} />)}
</section>

<script>
  const SOURCE = 'experience-panel';
  const section = document.querySelector<HTMLElement>('[data-experience-station]');
  const plates = section
    ? Array.from(section.querySelectorAll<HTMLElement>('[data-plate][data-experience]'))
    : [];
  let lastAnnounced: string | null = null;

  const announce = (id: string | undefined) => {
    if (!id || id === lastAnnounced) return;
    lastAnnounced = id;
    window.dispatchEvent(new CustomEvent('experience:focus', { detail: { id, source: SOURCE } }));
  };

  for (const plate of plates) {
    const id = plate.dataset.experience;
    plate.addEventListener('pointerenter', () => announce(id));
    plate.addEventListener('focusin', () => announce(id));
  }

  window.addEventListener('experience:focus', event => {
    const detail = (event as CustomEvent<{ id?: string; source?: string }>).detail;
    if (!detail?.id || detail.source !== 'scene') return;
    lastAnnounced = detail.id;
    for (const plate of plates) plate.toggleAttribute('data-active', plate.dataset.experience === detail.id);
  });
</script>
