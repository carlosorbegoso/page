---
import PhoneBanner from '../contact/PhoneBanner.astro';
import PhoneHome from '../contact/PhoneHome.astro';
import PhoneMail from '../contact/PhoneMail.astro';
import PhoneSheet from '../contact/PhoneSheet.astro';
import PhoneStatusBar from '../contact/PhoneStatusBar.astro';
import PhoneToast from '../contact/PhoneToast.astro';
import { SECTION_IDS, SITE } from '../../config/site';
import type { Locale } from '../../i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<section
  id={SECTION_IDS.contact}
  aria-labelledby="contact-title"
  data-station="contact"
  class="relative flex min-h-svh flex-col items-center justify-center px-gutter py-section"
>
  <div
    class="plate phone relative w-full max-w-[24rem] p-(--plate-padding)"
    data-plate
    data-plate-id="contact"
    data-plate-mode="surface-phone"
    data-phone
  >
    <PhoneStatusBar />
    <PhoneHome locale={locale} />
    <PhoneMail locale={locale} email={SITE.email} />
    <PhoneSheet locale={locale} />
    <PhoneBanner locale={locale} />
    <PhoneToast locale={locale} />
  </div>
</section>

<script>
  import { initPhone } from '../../scripts/phone/phone';

  for (const plate of document.querySelectorAll<HTMLElement>('[data-phone]')) initPhone(plate);
</script>

<style>
  :global(.is-3d [data-plate-mode='surface-phone'][data-phone-on]) :global(:is(a[href], button)) {
    position: relative;
    overflow: hidden;
    transition:
      transform 120ms ease-out,
      filter 120ms ease-out,
      color var(--duration-fast) ease-out,
      background-color var(--duration-fast) ease-out,
      border-color var(--duration-fast) ease-out,
      box-shadow var(--duration-fast) ease-out;
    -webkit-tap-highlight-color: transparent;
  }

  :global(.is-3d [data-plate-mode='surface-phone'][data-phone-on])
    :global(:is(a[href], button):active) {
    transform: scale(0.97);
    filter: brightness(0.85);
  }

  :global(.phone-ripple) {
    position: absolute;
    border-radius: 50%;
    background: currentColor;
    opacity: 0.22;
    pointer-events: none;
    transform: scale(0);
    animation: phone-ripple 560ms cubic-bezier(0.2, 0.6, 0.3, 1) forwards;
  }

  @keyframes phone-ripple {
    to {
      opacity: 0;
      transform: scale(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.is-3d [data-plate-mode='surface-phone'][data-phone-on])
      :global(:is(a[href], button):active) {
      transform: none;
    }
  }

  :global(:root[data-motion='paused'].is-3d [data-plate-mode='surface-phone'][data-phone-on])
    :global(:is(a[href], button):active) {
    transform: none;
  }
</style>
