---
import type { CollectionEntry } from 'astro:content';
import Button from '../ui/Button.astro';
import Tag from '../ui/Tag.astro';
import { useTranslations, type Locale } from '../../i18n/utils';

type Product = CollectionEntry<'products'>['data']['entries'][number];
type ProductId = 'skymek' | 'parati' | 'ventixs';

interface Props {
  product: Product;
  locale: Locale;
}

const { product, locale } = Astro.props;
const t = useTranslations(locale);

const accents: Record<ProductId, { bar: string; dot: string; active: string }> = {
  skymek: { bar: 'bg-skymek', dot: 'bg-skymek', active: 'data-active:border-skymek/60' },
  parati: { bar: 'bg-parati', dot: 'bg-parati', active: 'data-active:border-parati/60' },
  ventixs: { bar: 'bg-ventixs', dot: 'bg-ventixs', active: 'data-active:border-ventixs/60' }
};
const accent = accents[product.id as ProductId] ?? {
  bar: 'bg-accent',
  dot: 'bg-accent',
  active: 'data-active:border-accent/60'
};

const status =
  product.status === 'production'
    ? { tone: 'live', label: t('products.status.production') }
    : { tone: 'building', label: t('products.status.building') };

const titleId = `product-${product.id}`;
const hostname = new URL(product.url).hostname;
---

<article
  aria-labelledby={titleId}
  data-product={product.id}
  class:list={[
    'product-card relative flex h-full flex-col gap-5 overflow-hidden rounded-lg border border-border bg-surface p-5 shadow-sm md:p-6',
    'hover:border-border-strong hover:bg-surface-raised hover:shadow-md',
    'has-focus-visible:border-border-strong has-focus-visible:bg-surface-raised has-focus-visible:shadow-md',
    accent.active
  ]}
>
  <span class:list={['absolute inset-x-0 top-0 h-0.5', accent.bar]} aria-hidden="true"></span>

  <div class="flex flex-col gap-2">
    <div class="flex flex-wrap items-center justify-between gap-x-3 gap-y-2">
      <h3
        id={titleId}
        class="flex items-center gap-2.5 font-display text-xl font-semibold tracking-tight text-text"
      >
        <span class:list={['size-2.5 shrink-0 rounded-full', accent.dot]} aria-hidden="true"></span>
        {product.name}
      </h3>
      <Tag tone={status.tone as 'live' | 'building'}>{status.label}</Tag>
    </div>
    <p class="text-base font-medium text-text">{product.tagline}</p>
  </div>

  <p class="text-sm text-pretty text-text-muted">{product.description}</p>

  {
    product.features.length > 0 && (
      <ul class="flex flex-col gap-2 text-sm text-text-muted" role="list">
        {product.features.map(feature => (
          <li class="flex items-start gap-2.5">
            <span
              class:list={['mt-[0.55em] size-1.5 shrink-0 rounded-full', accent.dot]}
              aria-hidden="true"
            />
            <span>{feature}</span>
          </li>
        ))}
      </ul>
    )
  }

  <div class="mt-auto flex flex-col gap-4 border-t border-border pt-4">
    <dl class="flex flex-wrap items-baseline gap-x-2 gap-y-1 text-sm">
      <dt class="text-xs font-semibold tracking-caps text-text-subtle uppercase">
        {t('products.role')}
      </dt>
      <dd class="text-text">{product.role}</dd>
    </dl>
    <Button href={product.url} external variant="secondary" class="w-full sm:w-auto sm:self-start">
      <span>{t('products.visit')}</span>
      <span class="text-text-muted">{hostname}</span>
      <svg
        class="size-4 shrink-0"
        viewBox="0 0 16 16"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M6 3.5h6.5V10M12.5 3.5 4 12" />
      </svg>
    </Button>
  </div>
</article>

<style>
  .product-card {
    transition:
      transform var(--duration-base) var(--ease-standard),
      box-shadow var(--duration-base) var(--ease-standard),
      border-color var(--duration-base) var(--ease-standard),
      background-color var(--duration-base) var(--ease-standard);
  }

  @media (hover: hover) {
    .product-card:hover {
      transform: translateY(-2px);
    }
  }

  .product-card:has(:focus-visible) {
    transform: translateY(-2px);
  }

  @media (prefers-reduced-motion: reduce) {
    .product-card {
      transform: none !important;
    }
  }

  :global(:root[data-motion='reduced']) .product-card,
  :global(:root[data-motion='paused']) .product-card {
    transform: none !important;
  }
</style>
