---
import '../styles/global.css';
import SkipLink from '../components/SkipLink.astro';
import tokensCss from '../styles/tokens.css?raw';
import { SITE } from '../config/site';
import {
  LOCALES,
  LOCALE_TAGS,
  DEFAULT_LOCALE,
  localeUrl,
  useTranslations,
  withBase,
  type Locale
} from '../i18n/utils';

interface Props {
  locale: Locale;
  title?: string;
  description?: string;
  indexable?: boolean;
  /** Root-relative URL of this same page in every locale; defaults to the home pages. */
  alternates?: Record<Locale, string>;
  colorScheme?: 'dark' | 'dark light';
  pageType?: 'ProfilePage' | 'WebPage';
}

const { locale, indexable = true, colorScheme = 'dark', pageType = 'ProfilePage' } = Astro.props;
const localizedPaths: Record<Locale, string> =
  Astro.props.alternates ?? { es: localeUrl('es'), en: localeUrl('en') };
const t = useTranslations(locale);
const title = Astro.props.title ?? t('meta.title');
const description = Astro.props.description ?? t('meta.description');
const ogTitle = Astro.props.title ?? t('meta.ogTitle');
const ogDescription = Astro.props.description ?? t('meta.ogDescription');
const themeColor = tokensCss.match(/--color-bg:\s*(#[0-9a-f]{3,8})/i)?.[1] ?? '#0a0e14';

const site = Astro.site!;
const absolute = (path: string) => new URL(path, site).href;
const canonical = absolute(Astro.url.pathname.replace(/\/?$/, '/'));
/* Language-only hreflang: es-PE/en-US would leave Spanish speakers outside Peru and English speakers outside the US unmatched. */
const alternates = LOCALES.map(l => ({ hreflang: l, href: absolute(localizedPaths[l]) }));
const xDefault = absolute(localizedPaths[DEFAULT_LOCALE]);
const siteHome = absolute(localeUrl(DEFAULT_LOCALE));
const ogImage = absolute(withBase(t('meta.ogImage')));
const homeUrl = absolute(localeUrl(locale));

const personId = `${siteHome}#person`;
const organizationId = `${siteHome}#organization`;
const websiteId = `${siteHome}#website`;
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': websiteId,
      url: siteHome,
      name: SITE.name,
      inLanguage: LOCALES,
      publisher: { '@id': personId }
    },
    {
      '@type': pageType,
      '@id': `${canonical}#webpage`,
      url: canonical,
      name: title,
      description,
      inLanguage: locale,
      isPartOf: { '@id': websiteId },
      mainEntity: { '@id': personId }
    },
    {
      '@type': 'Person',
      '@id': personId,
      name: SITE.name,
      url: homeUrl,
      image: absolute(withBase('images/profile.jpeg')),
      jobTitle: 'Backend Developer',
      email: `mailto:${SITE.email}`,
      address: { '@type': 'PostalAddress', addressLocality: 'Lima', addressCountry: 'PE' },
      description: t('meta.description'),
      alumniOf: {
        '@type': 'CollegeOrUniversity',
        name: 'Universidad Peruana de Ciencias Aplicadas',
        alternateName: 'UPC',
        url: 'https://www.upc.edu.pe'
      },
      worksFor: {
        '@type': 'Organization',
        name: 'Tata Consultancy Services',
        alternateName: 'TCS',
        url: 'https://www.tcs.com'
      },
      sameAs: [SITE.social.linkedin, SITE.social.github, SITE.social.x],
      knowsAbout: [
        'Java',
        'Quarkus',
        'Spring Boot',
        'Microservices',
        'PostgreSQL',
        'REST APIs',
        'Kafka',
        'Docker',
        'Azure Functions',
        'Grafana'
      ]
    },
    {
      '@type': 'Organization',
      '@id': organizationId,
      name: 'TUSOCIO IA',
      legalName: 'TUSOCIO IA S.A.C.',
      foundingLocation: { '@type': 'Place', name: 'Lima, Perú' },
      founder: { '@id': personId },
      makesOffer: [
        { name: 'SkyMek', url: 'https://skymek.app' },
        { name: 'Parati', url: 'https://paratipe.com' },
        { name: 'Ventixs', url: 'https://ventixs.com' }
      ].map(product => ({
        '@type': 'Offer',
        itemOffered: { '@type': 'SoftwareApplication', ...product }
      }))
    }
  ]
};
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE.name} />
    <meta name="theme-color" content={themeColor} />
    <meta name="color-scheme" content={colorScheme} />
    <link
      rel="preload"
      href={withBase('fonts/geist-latin-wght.woff2')}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <script is:inline>
      (() => {
        let stored = null;
        try {
          stored = localStorage.getItem('motion');
        } catch {
          stored = null;
        }
        const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
        document.documentElement.dataset.motion = reduce || stored === 'paused' ? 'paused' : 'running';
        let time = null;
        try {
          time = localStorage.getItem('time');
        } catch {
          time = null;
        }
        const minutes = new Date().getHours() * 60 + new Date().getMinutes();
        const daylight = minutes >= 390 && minutes < 1080;
        document.documentElement.dataset.time = time === 'day' || time === 'night' ? time : daylight ? 'day' : 'night';
      })();
    </script>
    <link rel="icon" type="image/svg+xml" href={withBase('favicon.svg')} />
    <link rel="manifest" href={withBase('manifest.json')} />
    <link rel="sitemap" type="application/xml" href={withBase('sitemap-index.xml')} />
    {indexable ? (
      <>
        <link rel="canonical" href={canonical} />
        {alternates.map(alt => (
          <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />
        ))}
        <link rel="alternate" hreflang="x-default" href={xDefault} />
        <meta property="og:type" content="website" />
        <meta property="og:url" content={canonical} />
        <meta property="og:site_name" content={SITE.name} />
        <meta property="og:title" content={ogTitle} />
        <meta property="og:description" content={ogDescription} />
        <meta property="og:image" content={ogImage} />
        <meta property="og:image:type" content="image/jpeg" />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content={t('meta.ogImageAlt')} />
        <meta property="og:locale" content={LOCALE_TAGS[locale].og} />
        {LOCALES.filter(l => l !== locale).map(l => (
          <meta property="og:locale:alternate" content={LOCALE_TAGS[l].og} />
        ))}
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:creator" content={SITE.handle} />
        <meta name="twitter:title" content={ogTitle} />
        <meta name="twitter:description" content={ogDescription} />
        <meta name="twitter:image" content={ogImage} />
        <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
      </>
    ) : (
      <meta name="robots" content="noindex" />
    )}
    <slot name="head" />
  </head>
  <body>
    <SkipLink label={t('skipLink')} />
    <slot />
  </body>
</html>
