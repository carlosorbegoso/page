---
import Monogram from '../ui/Monogram.astro';
import { SITE } from '../../config/site';
import { useTranslations, type Locale } from '../../i18n/utils';

interface Props {
  locale: Locale;
}

const t = useTranslations(Astro.props.locale);
---

<div class="site-nav" aria-hidden="true">
  <span class="site-nav__brand">
    <Monogram size={18} />
    {SITE.name}
  </span>
  <span class="site-nav__links">
    <span>{t('nav.products')}</span>
    <span>{t('nav.experience')}</span>
    <span class="site-nav__cta">{t('nav.contact')}</span>
  </span>
</div>
