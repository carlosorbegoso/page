---
import AboutBio from './about/AboutBio.astro';
import AboutStack from './about/AboutStack.astro';
import { SECTION_IDS } from '../../config/site';
import type { Locale } from '../../i18n/utils';
import '../../styles/sections/about/monitor.css';
import '../../styles/sections/about/monitor-landscape.css';
import '../../styles/sections/about/code.css';
import '../../styles/sections/about/anchored.css';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<section
  id={SECTION_IDS.about}
  aria-labelledby="about-title"
  data-station="about"
  class="flex min-h-svh flex-col items-center justify-center gap-stack px-gutter py-section"
>
  <div
    class="plate p-(--plate-padding)"
    data-plate
    data-plate-id="about-bio"
    data-plate-anchor="about-bio"
    data-plate-stacked
    data-plate-mode="surface-monitor"
    data-plate-order="0"
  >
    <AboutBio locale={locale} />
  </div>

  <div
    class="plate p-(--plate-padding)"
    data-plate
    data-plate-id="about-stack"
    data-plate-anchor="about-stack"
    data-plate-stacked
    data-plate-mode="surface-monitor"
    data-plate-order="1"
  >
    <AboutStack locale={locale} />
  </div>
</section>
