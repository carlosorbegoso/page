---
import type { HTMLTag } from 'astro/types';
import { firstInRequest } from '../../motion/once';
import { splitCounts, splitWords, type SplitMode } from '../../motion/split';

interface Props {
  as?: HTMLTag;
  text?: string;
  split?: SplitMode;
  delay?: number;
  shine?: boolean;
  type?: boolean;
  counts?: boolean;
  class?: string;
}

const {
  as: Tag = 'span',
  text,
  split: requestedSplit = 'words',
  delay = 0,
  shine = false,
  type = false,
  counts = false,
  class: className
} = Astro.props;
const split: SplitMode = type ? 'chars' : requestedSplit;

const slotted = text ?? (Astro.slots.has('default') ? await Astro.slots.render('default') : '');
const plain = text !== undefined || !/[<&]/.test(slotted);
const words = plain && !counts ? splitWords(slotted) : [];
const countParts = plain && counts ? splitCounts(slotted) : [];
const emitArming = firstInRequest(Astro.request);

let charStart = 0;
const units = words.map((word, wordIndex) => {
  const unit = { ...word, wordIndex, charStart };
  charStart += word.chars.length;
  return unit;
});
---

{
  emitArming && (
    <script is:inline>
      (() => {
        const root = document.documentElement;
        if (root.dataset.motion === 'paused') return;
        root.classList.add('k-armed');
        setTimeout(() => {
          if (!window.__kinetic) root.classList.remove('k-armed');
        }, 4000);
      })();
    </script>
  )
}
{
  counts && plain ? (
    <Tag class={className}>
      {countParts.map(part =>
        part.count === undefined ? (
          part.text
        ) : (
          <>
            <span class="sr-only select-none">{part.text}</span>
            <span aria-hidden="true" data-kinetic-count={part.count} style={`--k-digits: ${part.text.length}`}>{part.text}</span>
          </>
        )
      )}
    </Tag>
  ) : plain ? (
    <Tag
      class:list={['kinetic', className]}
      data-kinetic={split}
      data-kinetic-shine={shine ? '' : undefined}
      data-kinetic-variant={type ? 'type' : undefined}
      data-kinetic-cursor={type ? '' : undefined}
      style={delay ? `--k-delay: ${delay}ms` : undefined}
    >
      <span class="sr-only select-none">{words.map(w => w.text).join(' ')}</span>
      <span class="kinetic__visual" aria-hidden="true">
        {units.map((unit, i) => (
          <>
            <span class="k-w" style={`--k-i: ${unit.wordIndex}`}>
              {split === 'chars' ? (
                unit.chars.map((char, c) => (
                  <span class="k-i k-c" style={`--k-c: ${unit.charStart + c}; --k-ci: ${c}`}>
                    {char}
                  </span>
                ))
              ) : (
                <span class="k-i">{unit.text}</span>
              )}
            </span>
            {i < units.length - 1 && ' '}
          </>
        ))}
      </span>
    </Tag>
  ) : (
    <Tag class:list={['kinetic', className]} data-kinetic="block" set:html={slotted} />
  )
}

<script>
  import '../../motion/kinetic';
</script>
