---
import { LOCALE_TAGS, localeUrl, otherLocale, useTranslations, type Locale } from '../i18n/utils';

interface Props {
  locale: Locale;
  compact?: boolean;
  class?: string;
}

const { locale, compact = false, class: className } = Astro.props;
const target = otherLocale(locale);
const t = useTranslations(locale);
---

<a
  href={localeUrl(target)}
  hreflang={LOCALE_TAGS[target].bcp47}
  lang={target}
  data-lang-switch
  aria-label={`${t('lang.label')}: ${t('lang.switchTo')}`}
  class:list={[
    'inline-flex min-h-tap min-w-tap items-center justify-center gap-2 rounded-md border border-border px-3 text-sm font-medium text-text',
    'transition-colors duration-(--duration-fast) ease-standard hover:border-border-strong hover:bg-surface',
    'focus-visible:shadow-focus focus-visible:outline-none',
    className
  ]}
>
  <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" class="shrink-0 fill-none stroke-current text-text-muted" stroke-width="1.75">
    <circle cx="12" cy="12" r="9"></circle>
    <path d="M3 12h18M12 3c2.5 2.6 3.8 5.6 3.8 9s-1.3 6.4-3.8 9c-2.5-2.6-3.8-5.6-3.8-9S9.5 5.6 12 3Z"></path>
  </svg>
  <span aria-hidden={compact ? 'true' : undefined}>{compact ? target.toUpperCase() : t('lang.switchTo')}</span>
</a>

<script>
  for (const link of document.querySelectorAll<HTMLAnchorElement>('[data-lang-switch]')) {
    link.addEventListener('click', () => {
      link.hash = location.hash;
    });
  }
</script>
