---
import Button from '../ui/Button.astro';
import SectionHeader from '../ui/SectionHeader.astro';
import Tag from '../ui/Tag.astro';
import { SECTION_IDS } from '../../config/site';
import { useTranslations, type Locale } from '../../i18n/utils';
import { getProducts, getProfile } from '../../lib/content';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const { company } = await getProfile(locale);
const products = await getProducts(locale);

type ProductTone = 'skymek' | 'parati' | 'ventixs';
const productTones: readonly string[] = ['skymek', 'parati', 'ventixs'];
const toneFor = (id: string) => (productTones.includes(id) ? (id as ProductTone) : 'neutral');
---

<section
  id={SECTION_IDS.company}
  aria-labelledby="company-title"
  data-station="company"
  class="relative z-(--z-content) flex flex-col items-center gap-6 px-gutter py-section"
>
  <div class="plate" data-plate data-plate-id="company">
    <div class="flex flex-col gap-6 p-5 md:p-8">
      <SectionHeader
        id="company-title"
        eyebrow={`${company.role} · ${company.legalName}`}
        title={t('company.title')}
        subtitle={t('company.subtitle')}
      />

      <div class="flex flex-col gap-4 text-base text-pretty text-text-muted" data-depth="-30">
        {company.summary.map(paragraph => (
          <p>{paragraph}</p>
        ))}
      </div>

      <div class="flex flex-col gap-3 rounded-lg border border-border bg-surface p-4" data-depth="30">
        <p class="flex items-center gap-2.5 text-sm font-medium text-text">
          <span class="size-2.5 shrink-0 rounded-full bg-accent" aria-hidden="true"></span>
          {t('company.parentBrand')}
        </p>
        <ul class="flex flex-wrap gap-2" role="list" data-kinetic-cascade>
          {products.map(product => (
            <li>
              <Tag tone={toneFor(product.id)}>{product.name}</Tag>
            </li>
          ))}
        </ul>
      </div>

      <div data-depth="60">
        <Button href={`#${SECTION_IDS.products}`} size="lg" class="w-full sm:w-auto">
          {t('company.cta')}
          <svg
            class="size-4 shrink-0"
            viewBox="0 0 16 16"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M8 3v10M3.5 8.5 8 13l4.5-4.5" />
          </svg>
        </Button>
      </div>
    </div>
  </div>
</section>
