---
import { useTranslations, type Locale } from '../../i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<div
  class="phone-toast"
  role="status"
  aria-live="polite"
  data-phone-toast
  data-downloading={t('contactPhone.downloading')}
  data-downloaded={t('contactPhone.downloaded')}
  data-sending={t('contactPhone.sending')}
>
  <span class="phone-toast-icon" aria-hidden="true">
    <svg
      viewBox="0 0 24 24"
      class="phone-toast-done"
      fill="none"
      stroke="currentColor"
      stroke-width="2.6"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <path d="m5 12.5 4.5 4.5L19 7.5"></path>
    </svg>
    <svg
      viewBox="0 0 24 24"
      class="phone-toast-progress"
      fill="none"
      stroke="currentColor"
      stroke-width="2.4"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <path d="M12 4v11M7 10l5 5 5-5M5 20h14"></path>
    </svg>
    <svg
      viewBox="0 0 24 24"
      class="phone-toast-error"
      fill="none"
      stroke="currentColor"
      stroke-width="2.4"
      stroke-linecap="round"
    >
      <path d="M12 7v6M12 17h.01"></path>
    </svg>
  </span>
  <span class="phone-toast-body">
    <span data-phone-toast-text></span>
    <span class="phone-toast-bar" aria-hidden="true">
      <span data-phone-toast-fill></span>
    </span>
  </span>
</div>

<style>
  .phone-toast {
    display: none;
  }

  :global(.is-3d [data-plate-mode='surface-phone']) .phone-toast {
    position: absolute;
    inset-inline: 0;
    top: 17cqw;
    margin-inline: auto;
    z-index: 8;
    display: flex;
    align-items: center;
    gap: 2.4cqw;
    max-width: 84cqw;
    width: max-content;
    padding: 1.3cqh 4.2cqw;
    border-radius: 999px;
    background: rgb(40 44 54 / 0.9);
    box-shadow: 0 1cqh 2.6cqh rgb(0 0 0 / 0.4);
    backdrop-filter: blur(12px) saturate(1.4);
    color: var(--color-text);
    font-size: 2.4cqh;
    font-weight: 500;
    line-height: 1.3;
    opacity: 0;
    pointer-events: none;
    transform: translateY(-1.6cqh) scale(0.94);
    transition:
      transform 360ms cubic-bezier(0.32, 0.72, 0, 1),
      opacity 200ms ease-out;
  }

  :global(.is-3d [data-plate-mode='surface-phone']) .phone-toast[data-variant='error'] {
    border-radius: 2.4cqh;
  }

  :global(.is-3d [data-plate-mode='surface-phone']) .phone-toast[data-shown] {
    opacity: 1;
    transform: none;
  }

  .phone-toast-icon {
    display: grid;
    flex-shrink: 0;
    place-items: center;
    width: 3.4cqh;
    height: 3.4cqh;
    border-radius: 50%;
    background: var(--color-accent);
    color: #fff;
  }

  .phone-toast-icon svg {
    display: none;
    width: 2.2cqh;
    height: 2.2cqh;
  }

  .phone-toast[data-variant='done'] .phone-toast-done,
  .phone-toast[data-variant='progress'] .phone-toast-progress,
  .phone-toast[data-variant='error'] .phone-toast-error {
    display: block;
  }

  .phone-toast[data-variant='error'] .phone-toast-icon {
    background: var(--color-danger, #e5484d);
  }

  .phone-toast-body {
    display: flex;
    min-width: 0;
    flex-direction: column;
    gap: 0.8cqh;
  }

  .phone-toast-bar {
    display: none;
    width: 34cqw;
    height: 0.7cqh;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.15);
    overflow: hidden;
  }

  .phone-toast[data-variant='progress'] .phone-toast-bar {
    display: block;
  }

  .phone-toast-bar span {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: inherit;
    background: var(--color-accent);
    transform: scaleX(0);
    transform-origin: left;
  }

  .phone-toast[data-variant='progress'][data-filling] .phone-toast-bar span {
    transform: scaleX(1);
    transition: transform var(--phone-progress, 1100ms) cubic-bezier(0.4, 0, 0.2, 1);
  }

  @media (prefers-reduced-motion: reduce) {
    .phone-toast {
      transform: none !important;
      transition-property: opacity, background-color !important;
    }
  }

  :global(:root[data-motion='paused']) .phone-toast {
    transform: none !important;
    transition-property: opacity, background-color !important;
  }
</style>
