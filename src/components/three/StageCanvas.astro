---
import { withBase } from '../../i18n/utils';
---

<div data-stage data-active="hero" aria-hidden="true">
  <picture data-stage-fallback>
    <img
      src={withBase('fallback/hero-placeholder.svg')}
      alt=""
      width="1200"
      height="800"
      decoding="async"
      fetchpriority="high"
    />
  </picture>
</div>

<style>
  [data-stage] {
    position: fixed;
    inset: 0 0 auto;
    height: 100vh;
    height: 100lvh;
    z-index: var(--z-canvas);
    pointer-events: none;
    overflow: hidden;
    background: var(--color-scene-bg);
  }

  [data-stage-fallback] img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
