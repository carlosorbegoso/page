---
import { SECTION_IDS } from '../config/site';

const stations = Object.values(SECTION_IDS);
---

<div
  data-scroll-progress
  aria-hidden="true"
  class="pointer-events-none fixed z-(--z-header) inset-x-0 bottom-0 h-1 md:inset-x-auto md:top-1/2 md:right-5 md:bottom-auto md:h-[min(60vh,28rem)] md:w-1 md:-translate-y-1/2"
>
  <div class="absolute inset-0 rounded-full bg-border/70"></div>
  <div data-progress-fill class="progress-fill absolute inset-0 rounded-full bg-accent"></div>
  {stations.map(id => (
    <span
      data-progress-station={id}
      class="absolute top-1/2 hidden size-2.5 -translate-1/2 rounded-full border-2 border-bg bg-border-strong transition-[background-color,scale] duration-(--duration-base) ease-standard data-[reached=true]:bg-accent data-[active=true]:scale-150 md:left-1/2 md:block"
    />
  ))}
</div>

<style>
  .progress-fill {
    transform: scaleX(var(--progress, 0));
    transform-origin: left center;
  }

  @media (width >= 48rem) {
    .progress-fill {
      transform: scaleY(var(--progress, 0));
      transform-origin: center top;
    }
  }
</style>

<script>
  const railElement = document.querySelector<HTMLElement>('[data-scroll-progress]');

  if (railElement) {
    const rail = railElement;
    const stations = [...rail.querySelectorAll<HTMLElement>('[data-progress-station]')];
    let ratios: number[] = [];
    let frame = 0;

    const maxScroll = () => Math.max(1, document.documentElement.scrollHeight - innerHeight);

    function measure() {
      const max = maxScroll();
      ratios = stations.map(station => {
        const section = document.getElementById(station.dataset.progressStation ?? '');
        const top = section ? section.getBoundingClientRect().top + scrollY : 0;
        const ratio = Math.min(1, Math.max(0, (top - innerHeight * 0.1) / max));
        station.style.top = `${ratio * 100}%`;
        return ratio;
      });
      update();
    }

    function update() {
      frame = 0;
      const progress = Math.min(1, Math.max(0, scrollY / maxScroll()));
      rail.style.setProperty('--progress', progress.toFixed(4));
      stations.forEach((station, index) => {
        station.dataset.reached = String(progress + 0.001 >= ratios[index]);
      });
    }

    addEventListener(
      'scroll',
      () => {
        if (!frame) frame = requestAnimationFrame(update);
      },
      { passive: true }
    );
    addEventListener('resize', measure);
    addEventListener('load', measure);
    new ResizeObserver(measure).observe(document.body);

    addEventListener('section:active', event => {
      const { id } = (event as CustomEvent<{ id: string | null }>).detail;
      for (const station of stations)
        station.dataset.active = String(station.dataset.progressStation === id);
    });

    measure();
  }
</script>
