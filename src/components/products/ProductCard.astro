---
import type { CollectionEntry } from 'astro:content';
import Button from '../ui/Button.astro';
import Tag from '../ui/Tag.astro';
import KineticText from '../ui/KineticText.astro';
import { useTranslations, type Locale } from '../../i18n/utils';

type Product = CollectionEntry<'products'>['data']['entries'][number];
type ProductId = 'skymek' | 'parati' | 'ventixs';

interface Props {
  product: Product;
  locale: Locale;
}

const { product, locale } = Astro.props;
const t = useTranslations(locale);

const accents: Record<ProductId, { dot: string; token: string }> = {
  skymek: { dot: 'bg-skymek', token: 'skymek' },
  parati: { dot: 'bg-parati', token: 'parati' },
  ventixs: { dot: 'bg-ventixs', token: 'ventixs' }
};
const accent = accents[product.id as ProductId] ?? { dot: 'bg-accent', token: 'accent' };
const accentToken = accent.token;

const status =
  product.status === 'production'
    ? { tone: 'live', label: t('products.status.production') }
    : { tone: 'building', label: t('products.status.building') };

const titleId = `product-${product.id}`;
const hostname = new URL(product.url).hostname;
---

<article
  aria-labelledby={titleId}
  class="plate product-plate"
  data-plate
  data-plate-id={`product-${product.id}`}
  data-product={product.id}
  style={`--product-accent: var(--color-${accentToken});`}
>
  <div class="relative flex flex-col gap-4 overflow-hidden rounded-[inherit] p-5 md:gap-5 md:p-6">
    <span class="product-plate__bar absolute inset-x-0 top-0 h-0.5" aria-hidden="true"></span>

    <div class="flex flex-col gap-2">
      <div class="flex flex-wrap items-center justify-between gap-x-3 gap-y-2">
        <h3
          id={titleId}
          class="flex items-center gap-2.5 font-display text-xl font-semibold tracking-tight text-text"
        >
          <span
            class:list={['size-2.5 shrink-0 rounded-full', accent.dot]}
            aria-hidden="true"
          ></span>
          <KineticText text={product.name} split="chars" />
        </h3>
        <Tag tone={status.tone as 'live' | 'building'}>{status.label}</Tag>
      </div>
      <p class="text-base font-medium text-text">{product.tagline}</p>
    </div>

    <p class="text-sm text-pretty text-text-muted">{product.description}</p>

    {product.features.length > 0 && (
      <ul class="flex flex-col gap-2 text-sm text-text-muted" role="list" data-kinetic-cascade>
        {product.features.map(feature => (
          <li class="flex items-start gap-2.5">
            <span
              class:list={['mt-[0.55em] size-1.5 shrink-0 rounded-full', accent.dot]}
              aria-hidden="true"
            />
            <span>{feature}</span>
          </li>
        ))}
      </ul>
    )}

    <div class="flex flex-col gap-4 border-t border-border pt-4">
      <dl class="flex flex-wrap items-baseline gap-x-2 gap-y-1 text-sm">
        <dt class="text-xs font-semibold tracking-caps text-text-subtle uppercase">
          {t('products.role')}
        </dt>
        <dd class="text-text">{product.role}</dd>
      </dl>
      <Button
        href={product.url}
        external
        variant="secondary"
        class="w-full sm:w-auto sm:self-start"
      >
        <span>{t('products.visit')}</span>
        <span class="text-text-muted">{hostname}</span>
        <svg
          class="size-4 shrink-0"
          viewBox="0 0 16 16"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M6 3.5h6.5V10M12.5 3.5 4 12" />
        </svg>
      </Button>
    </div>
  </div>
</article>

<style>
  .product-plate__bar {
    background-color: var(--product-accent);
    transition: height var(--duration-base) var(--ease-standard);
  }

  .product-plate:is(:hover, :has(:focus-visible), [data-active]) .product-plate__bar {
    height: 0.25rem;
  }

  .product-plate[data-active] {
    outline: 1px solid color-mix(in oklab, var(--product-accent) 60%, transparent);
    outline-offset: -1px;
  }
</style>
