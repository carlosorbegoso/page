---
import { SITE } from '../../config/site';
import { useTranslations, withBase, type Locale } from '../../i18n/utils';

interface Props {
  locale: Locale;
}

const t = useTranslations(Astro.props.locale);
---

<a href={withBase(SITE.cvPath)} download type="application/pdf">
  {t('cv.download')}
</a>
