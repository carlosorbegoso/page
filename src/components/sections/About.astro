---
import { Picture } from 'astro:assets';
import SectionHeader from '../ui/SectionHeader.astro';
import Tag from '../ui/Tag.astro';
import photo from '../../assets/profile.jpeg';
import { SECTION_IDS } from '../../config/site';
import { useTranslations, type Locale } from '../../i18n/utils';
import { getProfile } from '../../lib/content';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const profile = await getProfile(locale);

/* The last summary paragraph holds the CIBERTEC and Alura credentials, so it moves into the education list. */
const body = profile.summary.slice(0, -1);
const credentials = profile.summary.slice(-1);
const { degree, institution, status } = profile.education;
---

<section
  id={SECTION_IDS.about}
  aria-labelledby="about-title"
  data-station="about"
  class="relative grid min-h-svh grid-rows-[minmax(33svh,1fr)_auto] lg:grid-rows-1"
>
  <div
    class="row-start-2 mx-auto grid w-full max-w-wide px-gutter pb-[max(1rem,env(safe-area-inset-bottom))] md:pb-10 lg:row-start-1 lg:grid-cols-12 lg:items-center lg:py-24"
  >
    <div
      class="flex flex-col gap-6 rounded-xl border border-border bg-scrim p-5 shadow-lg backdrop-blur-md sm:p-8 md:ml-auto md:max-w-2xl lg:col-span-7 lg:col-start-6 lg:max-w-none lg:p-10 xl:col-span-6 xl:col-start-7"
    >
      <SectionHeader
        id="about-title"
        eyebrow={profile.location}
        title={t('about.title')}
        subtitle={t('about.subtitle')}
      />

      <div class="flex flex-col gap-5 sm:flex-row sm:items-start">
        <Picture
          src={photo}
          formats={['avif', 'webp']}
          widths={[192, 320, 480]}
          sizes="(min-width: 640px) 10rem, 7rem"
          alt={profile.photoAlt}
          loading="lazy"
          pictureAttributes={{ class: 'shrink-0' }}
          decoding="async"
          class="aspect-square w-28 shrink-0 rounded-lg border border-border object-cover sm:w-40"
        />
        <div class="flex flex-col gap-4 text-base text-text-muted">
          {body.map(paragraph => <p class="text-pretty">{paragraph}</p>)}
        </div>
      </div>

      <section
        aria-labelledby="about-education"
        class="rounded-lg border border-border bg-surface p-5 sm:p-6"
      >
        <h3
          id="about-education"
          class="font-display text-xl font-semibold tracking-tight text-text"
        >
          {t('about.education')}
        </h3>
        <ul class="mt-4 flex flex-col gap-4 text-sm text-text-muted">
          <li class="flex gap-3">
            <span class="mt-2 size-1.5 shrink-0 rounded-full bg-accent" aria-hidden="true"></span>
            <span>
              <span class="block font-medium text-text">{degree}</span>
              <span class="block">{institution}</span>
              <span class="block text-text-subtle">{status}</span>
            </span>
          </li>
          {
            credentials.map(item => (
              <li class="flex gap-3">
                <span class="mt-2 size-1.5 shrink-0 rounded-full bg-accent" aria-hidden="true" />
                <span class="text-pretty">{item}</span>
              </li>
            ))
          }
        </ul>
      </section>

      <section
        aria-labelledby="about-stack"
        class="rounded-lg border border-border bg-surface p-5 sm:p-6"
      >
        <h3 id="about-stack" class="font-display text-xl font-semibold tracking-tight text-text">
          {t('about.stack')}
        </h3>
        <dl class="mt-4 grid gap-4 sm:grid-cols-2">
          {
            profile.stack.map(group => (
              <div>
                <dt class="text-xs font-semibold tracking-caps text-text-muted uppercase">
                  {group.category}
                </dt>
                <dd class="mt-2">
                  <ul class="flex flex-wrap gap-2">
                    {group.items.map(item => (
                      <li>
                        <Tag>{item}</Tag>
                      </li>
                    ))}
                  </ul>
                </dd>
              </div>
            ))
          }
        </dl>
      </section>
    </div>
  </div>
</section>
