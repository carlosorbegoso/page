---
import Tag from '../ui/Tag.astro';
import { useTranslations, type Locale } from '../../i18n/utils';
import { formatTimelineMonth } from './dates';

interface Props {
  locale: Locale;
  id: string;
  company: string;
  client?: string;
  role: string;
  start: string;
  end: string | null;
  summary: string;
  highlights: string[];
  stack: string[];
}

const { locale, id, company, client, role, start, end, summary, highlights, stack } = Astro.props;
const t = useTranslations(locale);
const isCurrent = end === null;
const headingId = `experience-${id}`;
const highlightsId = `${headingId}-highlights`;
const stackId = `${headingId}-stack`;
---

<li
  class="timeline-item reveal relative pb-10 pl-8 last:pb-0 md:grid md:grid-cols-[9rem_1fr] md:gap-x-12 md:pl-0 lg:grid-cols-[11rem_1fr]"
  data-experience={id}
  data-current={isCurrent ? '' : undefined}
>
  <span
    class="timeline-line absolute top-4 bottom-0 left-[calc(0.375rem-1px)] w-0.5 bg-border-strong md:left-[calc(9rem+1.5rem-1px)] lg:left-[calc(11rem+1.5rem-1px)]"
    aria-hidden="true"></span>
  <span
    class:list={[
      'absolute top-1.5 left-0 size-3 rounded-full md:left-[calc(9rem+1.5rem-0.375rem)] lg:left-[calc(11rem+1.5rem-0.375rem)]',
      isCurrent
        ? 'bg-status-live shadow-[0_0_0_4px_var(--color-bg)]'
        : 'border-2 border-border-strong bg-bg'
    ]}
    aria-hidden="true"></span>

  <p
    class:list={[
      'mb-3 text-sm font-medium tabular-nums md:mb-0 md:pt-0.5 md:text-right',
      isCurrent ? 'text-text' : 'text-text-muted'
    ]}
  >
    <time datetime={start}>{formatTimelineMonth(start, locale)}</time>
    {' – '}
    {end ? <time datetime={end}>{formatTimelineMonth(end, locale)}</time> : t('experience.present')}
  </p>

  <article
    aria-labelledby={headingId}
    class:list={[
      'flex min-w-0 flex-col gap-4 rounded-lg border bg-surface p-5 md:p-6',
      isCurrent ? 'border-border-strong' : 'border-border'
    ]}
  >
    <header class="flex flex-col gap-1">
      <h3 id={headingId} class="font-display text-xl font-semibold tracking-tight text-text">
        {company}
      </h3>
      <p class="font-medium text-text">{role}</p>
      {
        client && (
          <p class="text-sm text-text-muted">
            {t('experience.client')}: {client}
          </p>
        )
      }
    </header>

    <p class="text-text-muted">{summary}</p>

    {
      highlights.length > 0 && (
        <div class="flex flex-col gap-2">
          <p id={highlightsId} class="text-xs font-semibold tracking-caps text-text-muted uppercase">
            {t('experience.highlights')}
          </p>
          <ul
            aria-labelledby={highlightsId}
            class="flex list-disc flex-col gap-2 pl-5 text-sm text-text marker:text-accent"
          >
            {highlights.map(highlight => (
              <li>{highlight}</li>
            ))}
          </ul>
        </div>
      )
    }

    <div class="flex flex-col gap-2">
      <p id={stackId} class="sr-only">{t('experience.stack')}</p>
      <ul aria-labelledby={stackId} class="flex flex-wrap gap-2" role="list">
        {stack.map(tech => (
          <li>
            <Tag>{tech}</Tag>
          </li>
        ))}
      </ul>
    </div>
  </article>
</li>

<style>
  .timeline-item:last-child .timeline-line {
    display: none;
  }

  /* Gated so a scroll-driven timeline never runs under reduced motion: view() animations ignore the global 0.01ms duration override. */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      :global(:root:not([data-motion='paused']):not([data-motion='reduced'])) .reveal {
        animation: timeline-reveal linear both;
        animation-timeline: view();
        animation-range: entry 0% entry 40%;
      }
    }
  }

  @keyframes timeline-reveal {
    from {
      opacity: 0;
      transform: translateY(12px);
    }

    to {
      opacity: 1;
      transform: none;
    }
  }
</style>
