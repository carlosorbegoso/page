<p data-scene-live class="sr-only" aria-live="polite"></p>

<script>
  const live = document.querySelector<HTMLElement>('[data-scene-live]');

  if (live) {
    let label: string | null = null;
    addEventListener('scene:hover', event => {
      const next = (event as CustomEvent<{ label: string | null }>).detail?.label ?? null;
      if (next === label) return;
      label = next;
      if (label) live.textContent = label;
    });
  }
</script>
