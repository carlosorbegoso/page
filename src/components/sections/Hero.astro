---
import Button from '../ui/Button.astro';
import CvLink from '../ui/CvLink.astro';
import KineticText from '../ui/KineticText.astro';
import { SECTION_IDS } from '../../config/site';
import { useTranslations, type Locale } from '../../i18n/utils';
import { getProfile } from '../../lib/content';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const profile = await getProfile(locale);
const metrics = [
  { value: t('hero.metrics.performance.value'), label: t('hero.metrics.performance.label') },
  { value: t('hero.metrics.cqrs.value'), label: t('hero.metrics.cqrs.label') },
  { value: t('hero.metrics.team.value'), label: t('hero.metrics.team.label') }
];
---

<section
  id={SECTION_IDS.hero}
  aria-labelledby="hero-title"
  data-station="hero"
  class="flex min-h-svh flex-col items-center justify-center px-gutter py-section"
>
  <div
    class="plate p-(--plate-padding)"
    data-plate
    data-plate-id="hero"
    data-plate-mode="surface-monitor"
  >
    <div class="hero-screen @container flex flex-col">
      <h1 id="hero-title" class="hero-enter flex flex-col gap-3">
        <span class="hero-name text-sm font-medium tracking-caps text-text-muted uppercase" data-signal>
          <KineticText text={profile.name} split="chars" />
        </span>
        <span class="hero-role font-display text-3xl font-semibold tracking-display text-balance text-text @md:text-4xl">
          <KineticText text={profile.role} delay={120} />
        </span>
      </h1>

      <p
        class="hero-headline hero-enter mt-5 max-w-measure font-display text-xl text-balance text-text @md:text-2xl"
        style="--enter-delay: 60ms"
      >
        <KineticText text={t('hero.headline')} type delay={360} />
      </p>

      <p class="hero-tagline hero-enter mt-3 text-sm text-pretty text-text-muted @md:text-base" style="--enter-delay: 120ms">
        {profile.tagline}
      </p>

      <section aria-labelledby="hero-metrics" class="hero-metrics hero-enter mt-6" style="--enter-delay: 160ms">
        <h2 id="hero-metrics" class="sr-only">{t('hero.metrics.label')}</h2>
        <dl class="grid gap-4 @md:grid-cols-3" data-kinetic-cascade style="--k-cascade-delay: 520ms">
          {
            metrics.map(metric => (
              <div class="flex flex-col-reverse gap-1">
                <dt class="hero-metric-label text-xs text-pretty text-text-muted">{metric.label}</dt>
                <dd class="hero-metric-value font-display text-xl font-semibold tracking-tight text-text tabular-nums" data-signal>
                  <KineticText text={metric.value} counts />
                </dd>
              </div>
            ))
          }
        </dl>
      </section>

      <div
        class="hero-ctas hero-enter mt-6 grid grid-cols-2 gap-3"
        data-kinetic-cascade
        style="--enter-delay: 200ms; --k-cascade-delay: 640ms"
      >
        <Button href={`#${SECTION_IDS.products}`} variant="primary" size="lg">
          {t('hero.ctaProducts')}
        </Button>
        <Button href={`#${SECTION_IDS.contact}`} variant="secondary" size="lg">
          {t('hero.ctaContact')}
        </Button>
        <CvLink locale={locale} variant="ghost" size="lg" class="col-span-2 min-h-tap" />
      </div>
    </div>
  </div>
</section>

<style>
  @keyframes hero-enter {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
  }

  @keyframes hero-slide {
    from {
      transform: translateY(12px);
    }
  }

  /* Only the delayed children animate opacity; the h1 just slides so it paints in the first frame (LCP). */
  .hero-enter {
    animation: hero-enter var(--duration-slow) var(--ease-out) both;
    animation-delay: var(--enter-delay, 0ms);
  }

  h1.hero-enter {
    animation-name: hero-slide;
  }

  /* On the monitor the engine owns the reveal (chapter:settled); a CSS slide would move text on a 1:1 surface. */
  :global(.is-3d) .hero-enter {
    animation: none;
  }

  .hero-ctas > :global(*) {
    padding-inline: 0.75rem;
  }

  /* The monitor is a fixed-size screen: every size is a share of its height so nothing ever clips. */
  :global(.is-3d) .hero-screen {
    height: 100%;
    justify-content: center;
    gap: 0;
  }

  :global(.is-3d) .hero-screen h1 {
    gap: 1cqh;
  }

  :global(.is-3d) .hero-name {
    font-size: 3.6cqh;
    line-height: 1.3;
  }

  :global(.is-3d) .hero-role {
    font-size: 6.4cqh;
    line-height: 1.15;
  }

  :global(.is-3d) .hero-headline {
    max-width: none;
    margin-top: 4cqh;
    font-size: 9cqh;
    line-height: 1.1;
  }

  :global(.is-3d) .hero-tagline {
    margin-top: 2.5cqh;
    font-size: 3.6cqh;
    line-height: 1.3;
  }

  :global(.is-3d) .hero-metrics {
    margin-top: 5cqh;
  }

  :global(.is-3d) .hero-metrics dl {
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0 5cqw;
  }

  :global(.is-3d) .hero-metrics div {
    gap: 0.8cqh;
  }

  :global(.is-3d) .hero-metric-value {
    font-size: 6cqh;
    line-height: 1.1;
  }

  :global(.is-3d) .hero-metric-label {
    font-size: 3.2cqh;
    line-height: 1.3;
  }

  :global(.is-3d) .hero-ctas {
    grid-template-columns: repeat(3, auto);
    justify-content: start;
    gap: 3cqw;
    margin-top: 5cqh;
  }

  :global(.is-3d) .hero-ctas > :global(*) {
    grid-column: auto;
    min-height: 0;
    height: 10cqh;
    padding-inline: 3.5cqw;
    font-size: 3.6cqh;
  }

  :global(.is-3d) .hero-ctas :global(svg) {
    width: 3.6cqh;
    height: 3.6cqh;
  }

  /* Phones turn the monitor upright: one column, sizes keep body text near 14 px. */
  @container surface (orientation: portrait) {
    :global(.is-3d) .hero-screen h1 {
      gap: 0.6cqh;
    }

    :global(.is-3d) .hero-name {
      font-size: 2.4cqh;
    }

    :global(.is-3d) .hero-role {
      font-size: 3.3cqh;
    }

    :global(.is-3d) .hero-headline {
      margin-top: 2.5cqh;
      font-size: 4.6cqh;
    }

    :global(.is-3d) .hero-tagline {
      display: none;
    }

    :global(.is-3d) .hero-metrics {
      margin-top: 3cqh;
    }

    :global(.is-3d) .hero-metrics dl {
      grid-template-columns: minmax(0, 1fr);
      gap: 2cqh;
    }

    :global(.is-3d) .hero-metrics div {
      display: grid;
      grid-template-columns: 38% minmax(0, 1fr);
      align-items: baseline;
      gap: 3cqw;
    }

    :global(.is-3d) .hero-metric-value {
      grid-column: 1;
      grid-row: 1;
      font-size: 3.6cqh;
    }

    :global(.is-3d) .hero-metric-label {
      grid-column: 2;
      grid-row: 1;
      font-size: 2.6cqh;
    }

    :global(.is-3d) .hero-ctas {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      justify-content: stretch;
      gap: 1.5cqh 3cqw;
      margin-top: 3cqh;
    }

    :global(.is-3d) .hero-ctas > :global(*) {
      height: 7cqh;
      padding-inline: 2cqw;
      font-size: 2.6cqh;
    }

    :global(.is-3d) .hero-ctas > :global(:last-child) {
      grid-column: 1 / -1;
    }

    :global(.is-3d) .hero-ctas :global(svg) {
      width: 2.2cqh;
      height: 2.2cqh;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-enter {
      animation: none;
    }
  }

  :global(:root[data-motion='paused']) .hero-enter {
    animation: none;
  }
</style>
