---
// ArtVisualizer - Interactive SVG particle art with audio reactivity
// SVGs are converted to particles that react to mouse and microphone
---

<section id="art" class="art-visualizer section">
    <div class="container">
        <div class="section-header">
            <div class="section-badge">
                <i class="fas fa-palette" aria-hidden="true"></i>
                <span>Creative Lab</span>
            </div>
            <h2 class="section-title gradient-text-animated">Audio Reactive Art</h2>
            <p class="section-subtitle">Interactive SVG visualizer - select an animal and watch it come alive</p>
        </div>
    </div>

    <div class="art-visualizer__stage" id="art-stage">
        <!-- Canvas gets injected here by SvgParticleEngine -->
    </div>

    <div class="art-visualizer__controls">
        <div class="art-visualizer__shapes">
            <button class="art-shape-btn active" data-svg="snail" aria-label="Snail">
                <span class="art-shape-btn__icon">🐌</span>
                <span class="art-shape-btn__label">Snail</span>
            </button>
            <button class="art-shape-btn" data-svg="owl" aria-label="Owl">
                <span class="art-shape-btn__icon">🦉</span>
                <span class="art-shape-btn__label">Owl</span>
            </button>
            <button class="art-shape-btn" data-svg="fox" aria-label="Fox">
                <span class="art-shape-btn__icon">🦊</span>
                <span class="art-shape-btn__label">Fox</span>
            </button>
            <button class="art-shape-btn" data-svg="deer" aria-label="Deer">
                <span class="art-shape-btn__icon">🦌</span>
                <span class="art-shape-btn__label">Deer</span>
            </button>
            <button class="art-shape-btn" data-svg="moth" aria-label="Moth">
                <span class="art-shape-btn__icon">🦋</span>
                <span class="art-shape-btn__label">Moth</span>
            </button>
            <button class="art-shape-btn" data-svg="seahorse" aria-label="Seahorse">
                <span class="art-shape-btn__icon">🐴</span>
                <span class="art-shape-btn__label">Seahorse</span>
            </button>
            <button class="art-shape-btn" data-svg="bat" aria-label="Bat">
                <span class="art-shape-btn__icon">🦇</span>
                <span class="art-shape-btn__label">Bat</span>
            </button>
            <button class="art-shape-btn" data-svg="chameleon" aria-label="Chameleon">
                <span class="art-shape-btn__icon">🦎</span>
                <span class="art-shape-btn__label">Chameleon</span>
            </button>
            <button class="art-shape-btn" data-svg="dinosaur" aria-label="Dinosaur">
                <span class="art-shape-btn__icon">🦕</span>
                <span class="art-shape-btn__label">Dinosaur</span>
            </button>
            <button class="art-shape-btn" data-svg="anglerfish" aria-label="Anglerfish">
                <span class="art-shape-btn__icon">🐟</span>
                <span class="art-shape-btn__label">Anglerfish</span>
            </button>
        </div>

    </div>
</section>

<style>
    .art-visualizer {
        position: relative;
        padding: var(--section-padding-y) 0;
        overflow: hidden;
    }

    .art-visualizer__stage {
        position: relative;
        width: 100%;
        max-width: 900px;
        height: 500px;
        margin: 0 auto;
        border-radius: var(--card-radius);
        background: rgba(5, 5, 15, 0.5);
        border: 1px solid rgba(88, 213, 213, 0.1);
        overflow: hidden;
    }

    [data-theme="light"] .art-visualizer__stage {
        background: rgba(240, 245, 255, 0.5);
        border-color: rgba(126, 200, 227, 0.15);
    }

    :global(.svg-particle-canvas) {
        width: 100%;
        height: 100%;
        cursor: crosshair;
    }

    .art-visualizer__controls {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 1.5rem;
        margin-top: 1.5rem;
        padding: 0 var(--container-padding);
        flex-wrap: wrap;
    }

    .art-visualizer__shapes {
        display: flex;
        gap: 0.5rem;
        flex-wrap: wrap;
        justify-content: center;
        max-width: 700px;
    }

    .art-shape-btn {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.2rem;
        padding: 0.6rem 0.8rem;
        border-radius: 0.75rem;
        border: 1px solid rgba(255, 255, 255, 0.08);
        background: rgba(255, 255, 255, 0.03);
        color: var(--text-secondary);
        cursor: pointer;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        font-family: var(--font-primary);
    }

    .art-shape-btn__icon {
        font-size: 1.3rem;
        line-height: 1;
    }

    .art-shape-btn__label {
        font-size: 0.6rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        opacity: 0.6;
    }

    .art-shape-btn:hover {
        border-color: rgba(176, 124, 255, 0.3);
        background: rgba(176, 124, 255, 0.08);
        transform: translateY(-2px);
    }

    .art-shape-btn.active {
        border-color: var(--neural-purple);
        background: rgba(176, 124, 255, 0.12);
        color: var(--neural-purple);
        box-shadow: 0 0 20px rgba(176, 124, 255, 0.15);
    }

    [data-theme="light"] .art-shape-btn {
        border-color: rgba(0, 0, 0, 0.08);
        background: rgba(0, 0, 0, 0.02);
    }

    [data-theme="light"] .art-shape-btn:hover {
        border-color: rgba(126, 200, 227, 0.3);
        background: rgba(126, 200, 227, 0.08);
    }

    [data-theme="light"] .art-shape-btn.active {
        border-color: var(--neural-primary);
        background: rgba(126, 200, 227, 0.12);
        color: var(--neural-primary);
    }


    @media (max-width: 768px) {
        .art-visualizer__stage {
            height: 350px;
            margin: 0 1rem;
            border-radius: 1rem;
        }

        .art-visualizer__controls {
            gap: 1rem;
        }

        .art-shape-btn {
            padding: 0.5rem 0.6rem;
        }

        .art-shape-btn__icon {
            font-size: 1.1rem;
        }
    }
</style>

<script>
    import { SvgParticleEngine } from '../scripts/engines/svg-particle-engine.js';

    const engine = new SvgParticleEngine();
    const basePath = import.meta.env.BASE_URL;
    let currentSvg = 'snail';

    async function initEngine() {
        const success = await engine.init('art-stage');
        if (!success) return;

        await engine.loadSvg(`${basePath}/svg/${currentSvg}.svg`);
        engine.start();
    }

    // SVG selector buttons
    const shapeBtns = document.querySelectorAll('.art-shape-btn');
    shapeBtns.forEach(btn => {
        btn.addEventListener('click', async () => {
            const svgName = btn.dataset.svg;
            if (svgName === currentSvg) return;

            currentSvg = svgName;
            shapeBtns.forEach(b => b.classList.remove('active'));
            btn.classList.add('active');

            await engine.loadSvg(`${basePath}/svg/${svgName}.svg`);
        });
    });

    // Use IntersectionObserver to only run when visible
    const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
            if (entry.isIntersecting && !engine.isRunning) {
                initEngine();
                observer.disconnect();
            }
        });
    }, { threshold: 0.1 });

    const stage = document.getElementById('art-stage');
    if (stage) observer.observe(stage);
</script>
